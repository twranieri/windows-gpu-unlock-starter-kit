+"""Generate exact LOCAL one/two-card profiles from whole-set cold captures.
+
+No hardware access. A generated header is not a write permit: the separate
+actual-PROM and whole-pair replay evidence gate must pass against these bytes.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+PAIR = module('local_pair_capture', Path(__file__).with_name('analyze_pair.py'))
+LEGACY = module('local_pair_legacy', REPO / 'research/profile/make-profile.py')
+END = bytes.fromhex('7fff0400')
+
+
+def require(value, message):
+    if not value:
+        raise ValueError(message)
+
+
+def regular(path, maximum=8 * 1024 * 1024):
+    require(path.is_file() and not path.is_symlink() and path.stat().st_size <= maximum,
+            'Missing, indirect or oversized local input: ' + path.name)
+    return path.read_bytes()
+
+
+def graph_location(raw):
+    values = re.findall(r'^pci location-status=0x([0-9a-f]+) segment=0x([0-9a-f]+) bus=0x([0-9a-f]+) device=0x([0-9a-f]+) function=0x([0-9a-f]+)$', raw, re.M)
+    require(len(values) == 1, 'Ambiguous graph location')
+    status, segment, bus, device, function = (int(v, 16) for v in values[0])
+    require(status == 0, 'Failed graph location')
+    return f'{segment:08x}:{bus:02x}:{device:02x}.{function:x}'
+
+
+def inspect_graph(text, cards, directory, envelope):
+    blocks = LEGACY.parse_handles(text)
+    bindings = LEGACY.parse_bindings(text.splitlines())
+    result = []
+    for card in cards:
+        matches = [h for h, block in blocks.items() if LEGACY.PCI_IO in block['protocols'] and
+                   LEGACY.pci_config(block['raw']) == card['pci_config'][:16] and graph_location(block['raw']) == card['bdf']]
+        require(len(matches) == 1, 'Card has no unique complete graph controller')
+        pci = matches[0]
+        controller = LEGACY.path_of(blocks[pci]['raw'])
+        require(controller and controller.endswith(END) and len(controller) <= 128, 'Card controller path is missing or unbounded')
+        # Reuse the bounded ancestry grammar without inventing a display child.
+        layout = LEGACY.gpu_display_path(controller[:-4] + bytes.fromhex('0203080000000000') + END)
+        require(layout['controller_bytes'] == len(controller) - 4, 'Controller path has trailing nodes')
+        active = [edge for edge in blocks[pci]['edges'] if edge[3] not in (1, 2, 4)]
+        owners = [edge for edge in active if edge[0] == LEGACY.PCI_IO and edge[3] == LEGACY.BY_DRIVER]
+        require(len(owners) <= 1 and all(edge[2] == pci and edge[4] == 1 for edge in owners), 'Ambiguous NVIDIA owner')
+        nv_agent = owners[0][1] if owners else None
+        children = [edge[2] for edge in active if edge[0] == LEGACY.PATH and edge[3] == LEGACY.BY_CHILD_CONTROLLER]
+        require(len(children) <= 4 and len(set(children)) == len(children), 'Ambiguous or oversized display-child set')
+        require(all(edge[1] == nv_agent and edge[4] == 1 and
+                    ((edge[3] == LEGACY.BY_DRIVER and edge[2] == pci) or
+                     (edge[0] == LEGACY.PATH and edge[3] == LEGACY.BY_CHILD_CONTROLLER)) for edge in active), 'Foreign PCI controller owner')
+        paths = []
+        for child in children:
+            require(child in blocks and child != pci, 'Missing or aliased display child')
+            path = LEGACY.path_of(blocks[child]['raw'])
+            child_layout = LEGACY.gpu_display_path(path)
+            require(path[:child_layout['controller_bytes']] == controller[:-4] and
+                    child_layout['controller_bytes'] == len(controller) - 4 and path not in paths,
+                    'Child path belongs to a different controller or is duplicated')
+            paths.append(path)
+        order = sorted(range(len(paths)), key=lambda i: paths[i])
+        children, paths = [children[i] for i in order], [paths[i] for i in order]
+        gops = [h for h, block in blocks.items() if LEGACY.GOP in block['protocols'] and
+                (LEGACY.path_of(block['raw']) or b'').startswith(controller[:-4])]
+        require(set(gops).issubset(children) and len(gops) <= 1, 'Unbound or multiple physical GOPs on one target')
+        code = None
+        nv = None
+        if nv_agent is not None:
+            nv = LEGACY.binding_for(bindings, nv_agent)
+            require(nv['file'] == ('name', LEGACY.NVGOP_NAME) and nv['image'] == nv['handle'] and
+                    nv['code-type'] == LEGACY.EFI_BOOT_SERVICES_CODE, 'Unreviewed NVIDIA driver role')
+            code = LEGACY.code_hash(directory, nv, LEGACY.NVGOP_TEXT_RVA)
+            chip = next(row for row in envelope['chips'] if row['chip'] == card['chip'])
+            require(any(int(row['version'], 16) == nv['version'] and row['text_sha256'] == code['sha256']
+                        for row in LEGACY.card_nvgop(chip, int(card['pci_id'], 16))), 'Unreviewed per-card NVIDIA driver code')
+        else:
+            require(not active and not children and not gops, 'Unbound peer must have no active owner or display children')
+        result.append(dict(pci=pci, controller=controller, root=layout['pci_nodes'][0], children=children, paths=paths, gops=gops,
+                           nv_agent=nv_agent, nv=nv, code=code, owned={pci, *children}))
