+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def run(clang):
+    with tempfile.TemporaryDirectory(prefix='gu-pair-header-') as name:
+        root = Path(name)
+        for leaf in ('machine-profile.h', 'gpu-family.h'):
+            shutil.copyfile(REPO / 'internal-boot/unlock' / leaf, root / leaf)
+        base = '''#define GU_LOCAL_PROFILE_GENERATOR 2
+#define GU_PROFILE_NAME "LOCAL-DUAL-0123456789abcdef"
+#define GU_BOARD_ID 0x220410deU
+#define GU_BOARD_SUBSYSTEM 0x000110deU
+#define GU_CHIP_ID 0xb72000a1U
+#define GU_DEVICE_MEMORY_SIZE 0x6000U
+#define GU_PROM_SHA256 "synthetic"
+#define GU_TARGET_SEGMENT 0x0001U
+#define GU_TARGET_BUS 0x2bU
+#define GU_NO_EDID_DRIVER 1
+#define GU_LOCAL_CONSOLE_AGGREGATE 0
+#define GU_LOCAL_CHILD_COUNT 1
+'''
+        pair = base + '''#define GU_LOCAL_PAIR_GENERATOR 2
+#define GU_PAIR_TARGET_COUNT 2U
+#define GU_CARD_TABLE {0x220410deU,0x000110deU,0xb72000a1U,0x6000U,"synthetic0","card0"},{0x250410deU,0x000210deU,0xb76000a1U,0x3000U,"synthetic1","card1"}
+#define GU_CARD_PINS {1,43,0,0,0x80000000U,1},{1,44,0,0,0x81000000U,0}
+#define GU_PAIR_TARGET_TABLE synthetic_wrapper_rows
+'''
+        header = root / 'profile-local-dual.h'
+        header.write_text(pair)
+        (root / 'profile-local-dual-card0.h').write_text(base)
+        (root / 'profile-local-dual-card1.h').write_text(base.replace('0x220410deU', '0x250410deU')
+            .replace('0xb72000a1U', '0xb76000a1U').replace('0x6000U', '0x3000U'))
+        source = root / 'check.c'
+        source.write_text('''#include "machine-profile.h"
+struct spec {unsigned id,sub,chip,memory;const char *sha,*name;};
+static const struct spec cards[]={GU_CARD_TABLE};
+#if GU_MULTI_TARGET
+struct pin {unsigned long long segment,bus,device,function,bar;unsigned console;};
+static const struct pin pins[]={GU_CARD_PINS};
+_Static_assert(sizeof(cards)/sizeof(cards[0])==GU_PAIR_TARGET_COUNT,"card cardinality");
+_Static_assert(sizeof(pins)/sizeof(pins[0])==GU_PAIR_TARGET_COUNT,"pin cardinality");
+#endif
+#ifdef EXPECT_CARD
+_Static_assert(GU_BOARD_ID==EXPECT_CARD,"fixture card selection");
+#endif
+int main(void){return cards[0].id==0;}
+''')
+        common = [clang, '-std=c11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-const-variable', '-Wno-unneeded-internal-declaration',
+                  '-fsyntax-only', '-DGU_PROFILE_LOCAL', '-DGU_PROFILE_LOCAL_DUAL']
+        checks = 0
+        def check(extra=(), success=True):
+            nonlocal checks
+            result = subprocess.run(common + list(extra) + [str(source)], capture_output=True, text=True, timeout=20)
+            if (result.returncode == 0) != success:
+                raise RuntimeError(f'Profile compile expectation failed {extra}:\n{result.stderr}')
+            checks += 1
+        check()
+        check(['-ffreestanding'])
+        check(['-DGU_PAIR_TEST_CARD_INDEX=0', '-DEXPECT_CARD=0x220410deU'])
+        check(['-DGU_PAIR_TEST_CARD_INDEX=1', '-DEXPECT_CARD=0x250410deU'])
+        check(['-DGU_PAIR_TEST_CARD_INDEX=0', '-ffreestanding'], False)
+        check(['-DGU_PAIR_TEST_CARD_INDEX=2'], False)
+        check(['-DGU_PROFILE_B660M_DUAL'], False)
+        for old, new in (('#define GU_CARD_PINS ', '#define OMITTED_CARD_PINS '),
+                         ('GU_PAIR_TARGET_COUNT 2U', 'GU_PAIR_TARGET_COUNT 3U'),
+                         ('#define GU_PAIR_TARGET_TABLE ', '#define OMITTED_PAIR_TARGET_TABLE ')):
+            header.write_text(pair.replace(old, new))
+            check(success=False)
+        header.write_text(pair.replace('GU_PAIR_TARGET_COUNT 2U', 'GU_PAIR_TARGET_COUNT 1U')
+                          .replace(',{0x250410deU,0x000210deU,0xb76000a1U,0x3000U,"synthetic1","card1"}', '')
+                          .replace(',{1,44,0,0,0x81000000U,0}', ''))
+        check()
+        print(f'PASS {checks} synthetic production-selector compile/refusal cases; no hardware evidence')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--clang', required=True)
+    run(parser.parse_args().clang)
