+"""Synthetic offline pair-capture admission tests; no firmware/GPU execution.
+
+The ROM buffers and logs below are invented. Passing these checks never supplies
+driver-release replay, an arming profile or physical two-card qualification.
+"""
+import contextlib
+import copy
+import hashlib
+import importlib.util
+import io
+import json
+from pathlib import Path
+import re
+import struct
+import tempfile
+import unittest
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+PAIR = load_module("synthetic_pair_analyzer", HERE / "analyze_pair.py")
+LEGACY = load_module("synthetic_pair_legacy_profile", REPO / "research/profile/make-profile.py")
+ENVELOPE = json.loads((REPO / "research/profile/proven.json").read_text(encoding="utf-8"))
+PCI_IO = "4cf5b200-68b8-4ca5-9eec-b23e3f50029a"
+DRIVER = "18a031ab-b443-4d1a-a5c0-0c09261e9f71"
+OTHER = "12345678-0000-0000-0000-000000000000"
+PROM_BYTES = 0x100000
+
+
+def cards():
+    return [dict(bus=1, board=0x220410de, chip=0xb72000a1, memory=0x6000,
+                 subsystem=0x147d10de, bar=0xf5000000, prom=b"\xa1" * PROM_BYTES),
+            dict(bus=2, board=0x248410de, chip=0xb74000a1, memory=0x2000,
+                 subsystem=0x38811462, bar=0xf6000000, prom=b"\xb2" * PROM_BYTES)]
+
+
+def config(card):
+    words = [0] * 64
+    for index, value in {0: card["board"], 1: 0x00100002, 2: 0x030000a1,
+                         4: card["bar"], 11: card["subsystem"], 13: 0x40,
+                         16: 0x00014801, 18: 0x00020010, 19: 1 << 28}.items():
+        words[index] = value
+    return words
+
+
+def bar_resource(base, inclusive=False):
+    # Packed EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR (46 bytes) plus 2-byte end tag.
+    return struct.pack("<BHBBBQQQQQBB", 0x8a, 43, 0, 0, 0, 32, base,
+                       base + 0xffffff if inclusive else 0xffffff, 0, 0x1000000, 0x79, 0)
+
+
+def render(card_set, *, boot=0, graph_cards=None, graph_reverse=False, inclusive=False):
+    """Whole graph with real-format PCI_IO nodes and one shared driver agent."""
+    lines = ["SYNTHETIC FIXTURE; no hardware observations; boot=" + str(boot),
+             PAIR._graph.MARKER, "dual-probe-v1 max-targets=2 readonly=1"]
+    for ordinal, card in enumerate(card_set):
+        cfg = config(card)
+        lines += [f"dual-card-begin index={ordinal:04x}",
+                  f"probe-target seg=0x0000 bus=0x{card['bus']:04x} dev=0x0000 fun=0x0000",
+                  "cfg256 status=0x0000000000000000",
+                  "cfg dwords=" + " ".join(f"{word:08x}" for word in cfg),
+                  "pci-bar0-resource raw=" + bar_resource(card["bar"], inclusive).hex(),
+                  "pci-attributes status=0x0000000000000000 value=0x0000000000000200"]
+        values = (card["chip"], 0xffffff8f, 0x8b8f, 0x3ff, 0x10, 0, 0x03000062, 6, card["memory"])
+        lines += [f"mmio off=0x{offset:08x} status=0x0000000000000000 value=0x{value:08x}"
+                  for offset, value in zip(PAIR.COLD, values)]
+        lines += [f"prom dump=PROM{ordinal:02d}.BIN",
+                  "prom sha256=" + hashlib.sha256(card["prom"]).hexdigest(),
+                  f"dual-card-end index={ordinal:04x}"]
+    lines.append(f"probe targets={len(card_set):04x} cfg-incomplete=0000")
+    graph_cards = card_set if graph_cards is None else graph_cards
+    graph = []
+    for index, card in enumerate(graph_cards):
+        handle = 0x10 + index
+        graph.append([f"handle id=0x{handle:x}", "protocol guid=" + PCI_IO,
+                      "opens status=0x0000000000000000 count=0x1",
+                      f"open agent=0x90 controller=0x{handle:x} attributes=0x10 count=0x1",
+                      f"pci location-status=0x0 segment=0x0 bus=0x{card['bus']:x} device=0x0 function=0x0",
+                      "pci config-status=0x0000000000000000",
+                      "pci config-dwords=" + " ".join(f"{word:08x}" for word in config(card)[:16])])
+    # Unrelated protected ownership and the referenced shared driver both resolve.
+    graph += [["handle id=0x80", "protocol guid=" + OTHER,
+               "opens status=0x0000000000000000 count=0x1",
+               "open agent=0x90 controller=0x80 attributes=0x10 count=0x1"],
+              ["handle id=0x90", "protocol guid=" + DRIVER,
+               "opens status=0x0000000000000000 count=0x0"]]
+    if graph_reverse:
+        graph.reverse()
+    lines.append(f"handles status=0x0000000000000000 count=0x{len(graph):x}")
+    for block in graph:
+        lines += block
+    lines += ["capture-complete=1", "diagnostic-result status=0x0000000000000000"]
+    return "\n".join(lines) + "\n"
+
+
+class AnalyzePairTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.first = self.root / "DIAG00.TXT"
+        self.second = self.root / "DIAG01.TXT"
+        self.card_set = cards()
+        self.write_pair(self.card_set)
+
+    def write_pair(self, card_set, *, second_cards=None, **kwargs):
+        for ordinal, card in enumerate(card_set):
+            (self.root / f"PROM{ordinal:02d}.BIN").write_bytes(card["prom"])
+        self.first.write_text(render(card_set, boot=0, **kwargs), encoding="ascii")
+        self.second.write_text(render(card_set if second_cards is None else second_cards, boot=1, **kwargs), encoding="ascii")
+
+    def analyze(self):
+        return PAIR.analyze(self.first, self.second, ENVELOPE)
+
+    def test_added_pair_only_accepts_reviewed_vram_and_subsystem(self):
+        self.card_set[0].update(board=0x220a10de, memory=0x3000)
+        self.card_set[1].update(board=0x248210de, subsystem=0x50521462)
+        self.write_pair(self.card_set)
+        self.assertEqual([entry['pci_id'] for entry in self.analyze()['cards']],
+                         ['220a10de', '248210de'])
+        self.card_set[1]['subsystem'] ^= 0x10000
+        self.write_pair(self.card_set)
+        with self.assertRaisesRegex(PAIR.Refused, 'Subsystem'):
+            self.analyze()
+        self.card_set[1]['subsystem'] = 0x50521462
+        self.card_set[0]['memory'] = 0x2800
+        self.write_pair(self.card_set)
+        with self.assertRaisesRegex(PAIR.Refused, 'chip/device/VRAM'):
+            self.analyze()
+        self.card_set[0].update(board=0x220810de, memory=0x3000)
+        self.write_pair(self.card_set)
+        with self.assertRaisesRegex(PAIR.Refused, 'Device ID'):
+            self.analyze()
+
+    def reject_text(self, mutate, regex=None):
+        original = self.second.read_text(encoding="ascii")
+        changed = mutate(original)
+        self.assertNotEqual(changed, original, "test mutation must change the fixture")
+        self.second.write_text(changed, encoding="ascii")
+        try:
+            with self.assertRaisesRegex(PAIR.Refused, regex or ".+"):
+                self.analyze()
+        finally:
+            self.second.write_text(original, encoding="ascii")
+
+    def test_one_and_two_cards_remain_observations_without_build_permission(self):
+        self.assertEqual(len(bar_resource(self.card_set[0]["bar"])), 48)
+        for count in (1, 2):
+            for inclusive in (False, True):
+                with self.subTest(count=count, inclusive=inclusive):
+                    self.write_pair(self.card_set[:count], inclusive=inclusive)
+                    report = self.analyze()
+                    self.assertEqual(report["schema"], "dual-capture-review-v1")
+                    self.assertEqual(report["card_count"], count)
+                    self.assertEqual([card["bdf"] for card in report["cards"]],
+                                     [f"00000000:{index:02x}:00.0" for index in range(1, count + 1)])
+                    for key in ("can_unlock", "can_build_write_efi", "physical_qualification"):
+                        self.assertIs(report[key], False)
+                    self.assertTrue(any("driver" in item.lower() and "replay" in item.lower() for item in report["pending"]))
+                    self.assertTrue(any("physical" in item.lower() for item in report["pending"]))
+                    self.assertEqual(report["captures"], [hashlib.sha256(path.read_bytes()).hexdigest()
+                                                          for path in (self.first, self.second)])
+
+    def test_whole_graph_order_is_irrelevant_but_card_order_must_be_sorted(self):
+        self.second.write_text(render(self.card_set, boot=1, graph_reverse=True), encoding="ascii")
+        self.assertEqual(self.analyze()["card_count"], 2)
+        self.write_pair(list(reversed(self.card_set)))
+        with self.assertRaisesRegex(PAIR.Refused, "sorted physical BDF"):
+            self.analyze()
+
+    def test_identical_card_models_and_rom_hashes_still_use_distinct_bdfs(self):
+        twins = [copy.deepcopy(self.card_set[0]), copy.deepcopy(self.card_set[0])]
+        twins[1].update(bus=2, bar=0xf6000000)
+        self.write_pair(twins)
+        report = self.analyze()
+        self.assertEqual(report["card_count"], 2)
+        self.assertEqual(report["cards"][0]["pci_id"], report["cards"][1]["pci_id"])
+        self.assertEqual(report["cards"][0]["prom_sha256"], report["cards"][1]["prom_sha256"])
+        self.assertNotEqual(report["cards"][0]["bdf"], report["cards"][1]["bdf"])
+        self.assertEqual([card["prom_file"] for card in report["cards"]], ["PROM00.BIN", "PROM01.BIN"])
+        self.assertIs(report["can_build_write_efi"], False)
+
+    def test_same_capture_path_is_not_two_boot_evidence(self):
+        with self.assertRaisesRegex(PAIR.Refused, "different capture"):
+            PAIR.analyze(self.first, self.root / "." / self.first.name, ENVELOPE)
+
+    def test_swapped_missing_wrong_sized_and_modified_prom_files_fail(self):
+        first_prom = self.root / "PROM00.BIN"
+        second_prom = self.root / "PROM01.BIN"
+        first_prom.write_bytes(self.card_set[1]["prom"])
+        second_prom.write_bytes(self.card_set[0]["prom"])
+        with self.assertRaisesRegex(PAIR.Refused, "PROM hash mismatch"):
+            self.analyze()
+        for payload in (None, b"", b"x" * (PROM_BYTES - 1), b"x" * (PROM_BYTES + 1), b"x" * PROM_BYTES):
+            self.write_pair(self.card_set)
+            if payload is None:
+                second_prom.unlink()
+            else:
+                second_prom.write_bytes(payload)
+            with self.subTest(size=None if payload is None else len(payload)), self.assertRaises(PAIR.Refused):
+                self.analyze()
+
+    def test_prom_name_cannot_select_another_card_or_escape_directory(self):
+        for name in ("PROM00.BIN", "PROM.BIN", "../PROM01.BIN", "PROM02.BIN"):
+            with self.subTest(name=name):
+                self.reject_text(lambda text, name=name: text.replace("prom dump=PROM01.BIN", "prom dump=" + name))
+
+    def test_third_missing_extra_graph_and_duplicate_bdf_cards_fail(self):
+        third = dict(self.card_set[0], bus=3, bar=0xf7000000, prom=b"\xc3" * PROM_BYTES)
+        self.write_pair(self.card_set + [third])
+        with self.assertRaisesRegex(PAIR.Refused, "one or two"):
+            self.analyze()
+        self.write_pair(self.card_set)
+        for graph_cards in (self.card_set[:1], self.card_set + [third], [self.card_set[0], self.card_set[0]]):
+            self.second.write_text(render(self.card_set, graph_cards=graph_cards), encoding="ascii")
+            with self.subTest(graph_count=len(graph_cards)), self.assertRaises(PAIR.Refused):
+                self.analyze()
+        duplicate = copy.deepcopy(self.card_set)
+        duplicate[1]["bus"] = duplicate[0]["bus"]
+        self.write_pair(duplicate)
+        with self.assertRaisesRegex(PAIR.Refused, "unique, sorted"):
+            self.analyze()
+
+    def test_overlapping_bars_unsupported_id_and_unreviewed_vram_fail(self):
+        for field, value, expected in (("bar", 0xf5000000, "overlap"), ("board", 0x220610de, "Device ID"),
+                                       ("memory", 0x6000, "chip/device/VRAM"), ("chip", 0xb76000a1, "chip/device/VRAM")):
+            changed = copy.deepcopy(self.card_set)
+            changed[1][field] = value
+            self.write_pair(changed)
+            with self.subTest(field=field), self.assertRaisesRegex(PAIR.Refused, expected):
+                self.analyze()
+
+    def test_failed_duplicate_missing_mmio_and_non_cold_state_fail(self):
+        row = "mmio off=0x001183a4 status=0x0000000000000000 value=0x00002000"
+        for replacement in (row.replace("status=0x0000000000000000", "status=0x8000000000000007"),
+                            row + "\n" + row, "", "mmio off=bad"):
+            with self.subTest(replacement=replacement):
+                self.reject_text(lambda text, replacement=replacement: text.replace(row, replacement))
+        for offset, value in ((0x1fa828, 1), (0x823804, 0), (0x82381c, 0x88888888),
+                              (0x82381c, 0xffffffff), (0x82381c, 0xbadf0001), (0x823820, 16)):
+            pattern = rf"(mmio off=0x{offset:08x} status=0x0000000000000000 value=0x)[0-9a-f]+"
+            with self.subTest(offset=offset, value=value):
+                self.reject_text(lambda text, pattern=pattern, value=value:
+                                 re.sub(pattern, lambda match: match[1] + f"{value:08x}", text, count=1))
+
+    def test_complete_footer_header_card_markers_and_counts_are_strict(self):
+        mutations = [lambda text: text.replace("capture-complete=1", "capture-complete=0"),
+                     lambda text: text.replace("capture-complete=1", "capture-complete=1\ncapture-complete=1"),
+                     lambda text: text.replace("diagnostic-result status=0x0000000000000000", "diagnostic-result status=0x8000000000000007"),
+                     lambda text: text.replace("readonly=1", "readonly=0"),
+                     lambda text: text.replace("dual-probe-v1 max-targets=2 readonly=1", ""),
+                     lambda text: text.replace("dual-probe-v1 max-targets=2 readonly=1", "dual-probe-v1 max-targets=2 readonly=1\ndual-probe-v1 max-targets=2 readonly=1"),
+                     lambda text: text.replace("dual-card-end index=0001", "dual-card-end index=0000"),
+                     lambda text: text.replace("dual-card-begin index=0001", "dual-card-begin index=0002"),
+                     lambda text: text.replace("probe targets=0002 cfg-incomplete=0000", "probe targets=0001 cfg-incomplete=0000"),
+                     lambda text: text.replace("cfg-incomplete=0000", "cfg-incomplete=0001"),
+                     lambda text: text.replace("capture-complete=1", "incomplete reason=probe-MMIO status=0x8000000000000007\ncapture-complete=1")]
+        for index, mutation in enumerate(mutations):
+            with self.subTest(case=index):
+                self.reject_text(mutation)
+
+    def test_cfg_attributes_resource_and_graph_snapshots_are_required(self):
+        cfg = "cfg dwords=" + " ".join(f"{word:08x}" for word in config(self.card_set[0]))
+        resource = "pci-bar0-resource raw=" + bar_resource(self.card_set[0]["bar"]).hex()
+        mutations = [lambda text: text.replace("cfg256 status=0x0000000000000000", "cfg256 status=0x8000000000000007", 1),
+                     lambda text: text.replace(cfg, "cfg dwords=" + " ".join(cfg.split("=", 1)[1].split()[:-1]), 1),
+                     lambda text: text.replace(resource, resource[:-2], 1),
+                     lambda text: text.replace(resource, "pci-bar0-resource raw=" + (bar_resource(self.card_set[0]["bar"])[:-1] + b"\x01").hex(), 1),
+                     lambda text: text.replace("value=0x0000000000000200", "value=0x0000000000000600", 1),
+                     lambda text: text.replace("pci config-status=0x0000000000000000", "pci config-status=0x8000000000000007", 1),
+                     lambda text: text.replace("controller=0x10 attributes=0x10 count=0x1", "controller=0x99 attributes=0x10 count=0x1", 1)]
+        for index, mutation in enumerate(mutations):
+            with self.subTest(case=index):
+                self.reject_text(mutation)
+
+    def test_graph_and_deep_card_identity_disagreement_is_rejected(self):
+        graph = copy.deepcopy(self.card_set)
+        graph[1]["subsystem"] ^= 1
+        self.second.write_text(render(self.card_set, graph_cards=graph), encoding="ascii")
+        with self.assertRaisesRegex(PAIR.Refused, "Graph and deep capture disagree"):
+            self.analyze()
+
+    def test_complete_installed_set_must_agree_between_boots(self):
+        changed = copy.deepcopy(self.card_set)
+        changed[0]["subsystem"] ^= 1
+        self.write_pair(self.card_set, second_cards=changed)
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+        changed = copy.deepcopy(self.card_set)
+        for key in ("board", "chip", "memory", "subsystem"):
+            changed[0][key], changed[1][key] = changed[1][key], changed[0][key]
+        self.write_pair(self.card_set, second_cards=changed)
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+        self.second.write_text(render(self.card_set[:1]), encoding="ascii")
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+
+    def test_legacy_generator_refuses_dual_header_even_single_card_with_renamed_prom(self):
+        self.write_pair(self.card_set[:1])
