index 0000000000000000000000000000000000000000..b4170a8fd987c934fa38311ba30aa1353d4903e7
--- /dev/null
+++ b/research/dual/test-profile.ps1
@@ -0,0 +1,169 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Actual private per-card fixtures and whole-pair graph, host RAM only.
+param([Parameter(Mandatory)][string]$Assets,[string]$Clang='clang',[string]$Python='python',[string]$VcVars)
+$ErrorActionPreference='Stop'
+
+function Invoke-DualNativeCommand([string[]]$Command) {
+    if(!$Command.Count -or @($Command | Where-Object {$_ -isnot [string] -or !$_}).Count){throw 'Missing actual command arguments.'}
+    $previous=$ErrorActionPreference
+    try {
+        $ErrorActionPreference='Continue';$global:LASTEXITCODE=$null
+        $lines=@(& $Command[0] @($Command | Select-Object -Skip 1) 2>&1 | ForEach-Object {"$_"})
+        $code=$LASTEXITCODE
+    } finally {$ErrorActionPreference=$previous}
+    if($code -isnot [int]){throw 'The command did not produce a native process exit status.'}
+    [pscustomobject]@{Exit=$code;Last=($lines | Select-Object -Last 1);Lines=$lines}
+}
+function Invoke-DualRecordedJob([string]$Repo,[string]$Adapter,[string[]]$Command,[string[]]$CompileCommand=@(),[int]$Expected=0) {
+    if(!$Adapter -or $Adapter -match '(^|/)\.\.(/|$)|:|\\' -or !(Test-Path -LiteralPath (Join-Path $Repo $Adapter) -PathType Leaf)){throw 'Host job needs an existing repository-relative adapter.'}
+    $kind='interpreted';$compileExit=0
+    if($CompileCommand.Count) {
+        $kind='compiled';$compiled=Invoke-DualNativeCommand $CompileCommand;$compileExit=$compiled.Exit
+        $compiled.Lines | ForEach-Object {Write-Host $_}
+        if($compileExit -ne 0){throw ('Actual host compile failed: '+$Adapter)}
+    }
+    $run=Invoke-DualNativeCommand $Command
+    $run.Lines | ForEach-Object {Write-Host $_}
+    if($run.Exit -ne $Expected){throw ('Actual host job failed: '+$Adapter+'; exit '+$run.Exit+' expected '+$Expected)}
+    [ordered]@{Kind=$kind;Adapter=$Adapter;Command=@($Command);CompileCommand=@($CompileCommand);CompileExit=$compileExit;
+        Exit=$run.Exit;Expected=$Expected;Last=$run.Last}
+}
+
+function Invoke-DualProfileTests([string]$Assets,[string]$Clang,[string]$Python,[string]$VcVars) {
+    $repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+    . (Join-Path $repo 'internal-boot/unlock/local-profile.ps1')
+    . (Join-Path $repo 'research/profile/host.ps1')
+    $local=Join-Path $repo 'research/dual/local';$evidencePath=Join-Path $local 'test-results.json'
+    if(Test-Path -LiteralPath $evidencePath){$null=Assert-DualRegularFile $repo 'research/dual/local/test-results.json';Remove-Item -LiteralPath $evidencePath}
+    $hw=Get-DualProfile $repo;$report=$hw.Report
+    $reportSha=Get-GuSha256 (Join-Path $local 'pair.json')
+    foreach($asset in @(Get-Content -LiteralPath (Join-Path $repo 'internal-boot/unlock/assets.json') -Raw | ConvertFrom-Json)) {
+        if([IO.Path]::GetFileName($asset.Name) -cne $asset.Name){throw 'Invalid firmware asset filename.'}
+        $path=Join-Path $Assets $asset.Name;$item=Get-Item -LiteralPath $path -Force
+        if($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $item.Length -ne $asset.Bytes -or
+           (Get-GuSha256 $path) -cne $asset.Sha256.ToLowerInvariant()){throw ('Pinned local asset mismatch: '+$asset.Name)}
+    }
+    $inputs=@(Get-DualTreeInputs $repo);$tree=Get-LocalInputDigest $inputs
+    Import-GuHostCompiler $VcVars
+    $unlock=Join-Path $repo 'internal-boot/unlock';$boot=Join-Path $repo 'internal-boot/boot'
+    $includes=@('-I',(Join-Path $unlock 'compat'),'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include'),'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include/X64'))
+    $flags=@('-std=c11','-O1','-Wall','-Wextra','-Werror','-Wno-unused-parameter','-Wno-unused-function','-D_CRT_SECURE_NO_WARNINGS')+$includes
+    $core=@('port.c','compat.c','vendor/unlock_610.c','vendor/prep_610.c','vendor/layout_610.c','vendor/vbios_610.c','vendor/gfw_eval.c') | ForEach-Object {Join-Path $unlock $_}
+    $app=@('app_io.c','ownership.c','format.c','sha256.c','checks.c') | ForEach-Object {Join-Path $unlock $_}
+    $app+=@($core)
+    $shell=(Get-Process -Id $PID).Path
+    $cards=@();$pairResults=[ordered]@{};$regressions=[ordered]@{}
+    foreach($test in @('test_analyze_pair.py','test_pair_header.py','test_pair_profile.py','test_dual_evidence.py')) {
+        $adapter='research/dual/'+$test
+        $command=@($Python,'-I',(Join-Path $repo $adapter))
+        if($test -eq 'test_pair_header.py'){$command+=@('--clang',$Clang)}
+        $regressions[$test]=Invoke-DualRecordedJob -Repo $repo -Adapter $adapter -Command $command
+    }
+    foreach($card in @($report.Cards)) {
+        $index=[int]$card.Index;$results=[ordered]@{}
+        $out=Join-Path $unlock ('build/tests/local-dual/card{0:d4}' -f $index)
+        [void][IO.Directory]::CreateDirectory($out)
+        $fixtureRoot=Join-Path $local ('fixtures/cards/{0:d4}' -f $index)
+        $prom=Join-Path $fixtureRoot 'PROM.BIN';$probe=Join-Path $fixtureRoot 'probe/REPORT.TXT';$cold=Join-Path $fixtureRoot 'cold/REPORT.TXT'
+        $profile=@('-DGU_PROFILE_LOCAL','-DGU_PROFILE_LOCAL_DUAL',('-DGU_PAIR_TEST_CARD_INDEX='+$index))
+        $defs=@('-D__KERNEL__','-DGU_UEFI_PORT',('-DGU_TARGET_PCI_ID=0x'+$card.PciId+'U'))
+        $foreign=$null
+        foreach($other in @(@('-DGU_PROFILE_B650M_3090FE','220410de','145410de'),@('-DGU_PROFILE_B660M_3070TI','248210de','50521462'),@('-DGU_PROFILE_X870_3090TI','220310de','88701043'))) {
+            if($other[1] -cne $card.PciId -or $other[2] -cne $card.Subsystem){$foreign=$other[0];break}
+        }
+        if(!$foreign){throw 'No distinct reviewed profile available for the rejection job.'}
+        function Card-Job([string]$Name,[string]$Adapter,[string[]]$Compile,[string[]]$Run,[int]$Expected=0) {
+            if($results.Contains($Name)){throw 'Duplicate actual per-card job.'}
+            $results[$Name]=Invoke-DualRecordedJob -Repo $repo -Adapter $Adapter -CompileCommand (@($Clang)+$Compile) -Command $Run -Expected $Expected
+        }
+        Push-Location -LiteralPath $unlock
+        try {
+            if($card.Console) {
+                $adapter='research/dual/test_make_pair_profile.py'
+                $locator=Build-GuFwsecLocate $repo $Clang
+                $results['generator refusals']=Invoke-DualRecordedJob -Repo $repo -Adapter $adapter -Command @($Python,'-I',(Join-Path $repo $adapter),(Join-Path $local 'captures'),$locator)
+                $adapter='internal-boot/unlock/tests/test_stock_selection.py'
+                $results['stock-selection']=Invoke-DualRecordedJob -Repo $repo -Adapter $adapter -Command @($Python,'-I',(Join-Path $repo $adapter),$Clang)
+            }
+            $runtimeObject=Join-Path $out 'runtime-host.obj'
+            $runtimeCommand=@($Clang)+$flags+@('-fno-builtin','-Dmemcpy=GuTestMemcpy','-Dmemset=GuTestMemset','-Dmemchr=GuTestMemchr','-Dmemcmp=GuTestMemcmp','-Dstrcmp=GuTestStrcmp','-Dstrlen=GuTestStrlen','-c',(Join-Path $unlock 'runtime.c'),'-o',$runtimeObject)
+            $runtimeCompile=Invoke-DualNativeCommand $runtimeCommand
+            if($runtimeCompile.Exit -ne 0){throw 'Actual runtime prerequisite compile failed.'}
+            $adapter='internal-boot/unlock/tests/test_checks.c';$exe=Join-Path $out 'checks.exe'
+            Card-Job 'checks (real config)' $adapter ($flags+$profile+@((Join-Path $repo $adapter),(Join-Path $unlock 'checks.c'),'-o',$exe)) @($exe,$probe)
+            $exe=Join-Path $out 'checks-other.exe'
+            Card-Job 'checks other profile (must reject)' $adapter ($flags+@($foreign,(Join-Path $repo $adapter),(Join-Path $unlock 'checks.c'),'-o',$exe)) @($exe,$probe) 1
+            foreach($job in @(@('port','test_port.c',@('port.c'),@('-DGU_HOST_WRITE_TEST')),
+                              @('fresh PCI identity','test_refresh_identity.c',@('ownership.c','port.c'),@('-DGU_HOST_WRITE_TEST')),
+                              @('write-lock','test_preflight_lock.c',@('port.c'),@()))) {
+                $adapter='internal-boot/unlock/tests/'+$job[1];$exe=Join-Path $out ($job[1]+'.exe')
+                $sources=@($job[2] | ForEach-Object {Join-Path $unlock $_})
+                Card-Job $job[0] $adapter ($flags+$profile+@($job[3])+@((Join-Path $repo $adapter))+$sources+@('-o',$exe)) @($exe)
+            }
+            $adapter='internal-boot/unlock/tests/test_master_attributes.c';$exe=Join-Path $out 'master.exe'
+            Card-Job 'master-attributes' $adapter ($flags+$profile+$defs+@('-DGU_HOST_WRITE_TEST',(Join-Path $repo $adapter))+$core+@('-o',$exe)) @($exe)
+            $adapter='internal-boot/unlock/tests/test_runtime.c';$exe=Join-Path $out 'runtime.exe'
+            Card-Job 'runtime' $adapter ($flags+@('-fno-builtin',(Join-Path $repo $adapter),(Join-Path $unlock 'format.c'),$runtimeObject,'-o',$exe)) @($exe)
+            $results['runtime']['Prerequisites']=@([ordered]@{Command=$runtimeCommand;Exit=$runtimeCompile.Exit;OutputSha256=(Get-GuSha256 $runtimeObject)})
+            foreach($policy in @(@('entryLatchedSs1Full','-DGU_ENTRY_LATCHED_SS1_FULL'),@('entryLatchedSs1Preserve','-DGU_ENTRY_LATCHED_SS1_PRESERVE'))) {
+                $adapter='internal-boot/unlock/tests/test_profile_lock.c';$exe=Join-Path $out ('lock-'+$policy[0]+'.exe')
+                Card-Job ('profile-lock-'+$policy[0]) $adapter ($flags+$profile+@('-DGU_EXPERIMENTAL_3090',$policy[1],(Join-Path $repo $adapter),(Join-Path $unlock 'port.c'),'-o',$exe)) @($exe)
+            }
+            $coldInclude=Join-Path $out 'include';[void][IO.Directory]::CreateDirectory($coldInclude)
+            @('/* Hosted placeholder, never a firmware configuration. */','#define GU_INTERNAL_PARTITION_INITIALIZER {0}','#define GU_WINDOWS_PARTITION_INITIALIZER {0}') | Set-Content -LiteralPath (Join-Path $coldInclude 'platform-config.h') -Encoding ascii
+            $bootFlags=$flags+@('-I',$coldInclude)
+            $adapter='internal-boot/boot/test_cold_precheck.c';$exe=Join-Path $out 'cold.exe'
+            Card-Job 'cold pre-check (read-only)' $adapter ($bootFlags+$profile+@('-DGU_HEADLESS_RESEARCH','-DGU_SINGLE_RTX_CONSOLE','-DGU_FULL_UNLOCK','-DGU_AUTOMATIC_BOOT',(Join-Path $repo $adapter),(Join-Path $boot 'console-flow.c'),(Join-Path $unlock 'checks.c'),(Join-Path $unlock 'sha256.c'),'-o',$exe)) @($exe)
+            if($card.Console) {
+                $adapter='internal-boot/boot/test_research_input.c';$exe=Join-Path $out 'input.exe'
+                Card-Job 'research input policy' $adapter ($bootFlags+@((Join-Path $repo $adapter),(Join-Path $boot 'research-input.c'),(Join-Path $boot 'console-flow.c'),'-o',$exe)) @($exe)
+                $adapter='internal-boot/boot/test_full_flow.c';$exe=Join-Path $out 'flow.exe'
+                Card-Job 'full flow gates' $adapter ($bootFlags+@((Join-Path $repo $adapter),(Join-Path $boot 'full-flow.c'),'-o',$exe)) @($exe)
+            }
+            $latched=$flags+$profile+$defs+@('-DGU_EXPERIMENTAL_3090','-DGU_ENTRY_LATCHED_SS1_FULL')
+            $variants=@(@{Name='core transaction (efi)';Source='tests/test_efi_transaction.c';Defines=@('-DGU_INTERNAL_BOOT');Sources=@((Join-Path $unlock 'checks.c'))+$core;Args=@($prom,$Assets,$cold)})
+            if($card.Console){$variants+=@(
+                @{Name='manual entry-latched';Source='tests/test_entry_latched.c';Defines=@('-DGU_INTERNAL_BOOT');Sources=$app;Args=@($prom,$cold,$Assets)},
+                @{Name='automatic internal';Source='tests/test_automatic.c';Defines=@('-DGU_INTERNAL_BOOT','-DGU_AUTOMATIC_BOOT');Sources=$app;Args=@($prom,$cold,$Assets)},
+                @{Name='headless internal';Source='tests/test_headless.c';Defines=@('-DGU_INTERNAL_BOOT','-DGU_AUTOMATIC_BOOT','-DGU_HEADLESS_RESEARCH');Sources=$app;Args=@($prom,$cold,$Assets)},
+                @{Name='headless USB (shipped child)';Source='tests/test_headless.c';Defines=@('-DGU_INTERNAL_BOOT','-DGU_AUTOMATIC_BOOT','-DGU_HEADLESS_RESEARCH','-DGU_USB_MEDIA');Sources=$app;Args=@($prom,$cold,$Assets)})}
+            $number=0
+            foreach($variant in $variants) {
+                $adapter='internal-boot/unlock/'+$variant.Source;$exe=Join-Path $out ('tx-'+$number+'.exe');$number++
+                Card-Job $variant.Name $adapter ($latched+$variant.Defines+@((Join-Path $repo $adapter))+$variant.Sources+@('-o',$exe)) (@($exe)+$variant.Args)
+            }
+        } finally {Pop-Location}
+        $cards+=@([ordered]@{Index=$index;Results=$results})
+    }
+    $registry='internal-boot/unlock/tests/test-target-registry.ps1'
+    $command=@($shell,'-NoProfile','-ExecutionPolicy','Bypass','-File',(Join-Path $repo $registry),'-Clang',$Clang)
+    if($VcVars){$command+=@('-VcVars',$VcVars)}
+    $pairResults['target registry and coordinator']=Invoke-DualRecordedJob -Repo $repo -Adapter $registry -Command $command
+    $replay='research/dual/test-pair-replay.ps1'
+    $command=@($shell,'-NoProfile','-ExecutionPolicy','Bypass','-File',(Join-Path $repo $replay),'-Clang',$Clang,'-Python',$Python)
+    if($VcVars){$command+=@('-VcVars',$VcVars)}
+    $run=Invoke-DualNativeCommand $command;$run.Lines | ForEach-Object {Write-Host $_}
+    if($run.Exit -ne 0){throw 'Actual whole-pair replay failed; no final host permission evidence was written.'}
+    $replayPath=Assert-DualRegularFile $repo 'research/dual/local/pair-replay-results.json'
+    $replayed=Get-Content -LiteralPath $replayPath -Raw | ConvertFrom-Json
+    if($replayed.HardwareAccess -isnot [bool] -or $replayed.HardwareAccess -or $replayed.HeaderSha256 -cne $hw.HeaderSha256 -or
+       $replayed.ProfileReportSha256 -cne $reportSha -or $replayed.TreeSha256 -cne $tree){throw 'Actual pair replay evidence does not match these exact inputs.'}
+    foreach($name in @('pair wrapper replay (real graph)','pair child policy replay (real graph)')){$pairResults[$name]=$replayed.Results.$name}
+    $console=[int]$report.ConsoleCardIndex
+    foreach($entry in $replayed.ConsoleResults.PSObject.Properties){$cards[$console].Results[$entry.Name]=$entry.Value}
+    for($index=0;$index -lt $cards.Count;$index++) {
+        $card=$report.Cards[$index];$expected=Get-DualExpectedJobs $card.Console $card.NoEdidDriver $card.ConsoleAggregate
+        Assert-LocalKeys $cards[$index].Results @($expected.Keys) 'Actual applicable per-card host jobs'
+    }
+    $expected=Get-DualExpectedPairJobs;Assert-LocalKeys $pairResults @($expected.Keys) 'Actual pair host jobs'
+    $after=Get-DualProfile $repo
+    if($after.HeaderSha256 -cne $hw.HeaderSha256 -or (Get-GuSha256 (Join-Path $local 'pair.json')) -cne $reportSha -or
+       (Get-LocalInputDigest @(Get-DualTreeInputs $repo)) -cne $tree){throw 'Profile, fixtures or source changed during host tests; rerun.'}
+    [ordered]@{Format=3;AllPassed=$true;HardwareAccess=$false;ProfileName=$hw.Name;HeaderSha256=$hw.HeaderSha256;
+        ProfileReportSha256=$reportSha;Inputs=$inputs;TreeSha256=$tree;Cards=$cards;PairResults=$pairResults;
+        PairReplayCommand=$command;PairReplayExit=$run.Exit;RegressionResults=$regressions;TestedUtc=[DateTime]::UtcNow.ToString('o')} |
+        ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $evidencePath -Encoding utf8
+    try{$null=Assert-DualProfileEvidence $repo}catch{Remove-Item -LiteralPath $evidencePath;throw}
+    Write-Host ('Exact per-card jobs and complete pair replay passed for '+$hw.TargetCount+' card(s); host RAM only, physical qualification pending.')
+}
+if($MyInvocation.InvocationName -ne '.') {Invoke-DualProfileTests $Assets $Clang $Python $VcVars}
