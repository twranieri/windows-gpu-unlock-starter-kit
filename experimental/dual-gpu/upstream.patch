+}
+static EFI_STATUS EFIAPI location(EFI_PCI_IO_PROTOCOL *p,UINTN *s,UINTN *b,UINTN *d,UINTN *f) {
+  NODE *node=(NODE *)p;*s=node->segment;*b=node->bus;*d=*f=0;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI opens(EFI_HANDLE h,EFI_GUID *g,EFI_OPEN_PROTOCOL_INFORMATION_ENTRY **entries,UINTN *n) {
+  (void)g;if(open_failure)return EFI_DEVICE_ERROR;
+  NODE *node=h;*entries=NULL;*n=node->child?1:0;
+  if(*n){*entries=malloc(sizeof(**entries));assert(*entries);
+    **entries=(EFI_OPEN_PROTOCOL_INFORMATION_ENTRY){(VOID *)30,(VOID *)40,EFI_OPEN_PROTOCOL_BY_CHILD_CONTROLLER,1};}
+  if(drift){drift=0;node->cfg[4]^=0x1000000U;}
+  return EFI_SUCCESS;
+}
+static void setup(UINTN count) {
+  memset(nodes,0,sizeof(nodes));memset(&services,0,sizeof(services));node_count=count;
+  open_failure=reenter=drift=0;
+  services.LocateHandleBuffer=locate;services.HandleProtocol=handle;services.FreePool=release;services.OpenProtocolInformation=opens;
+  for(UINTN i=0;i<3;i++) {
+    nodes[i].io.Pci.Read=config_read;nodes[i].io.GetLocation=location;nodes[i].bus=1+i;
+    nodes[i].cfg[0]=GuCardTable[i%2].id;nodes[i].cfg[11]=GuCardTable[i%2].subsystem;
+    nodes[i].cfg[1]=3;nodes[i].cfg[2]=0x030000a1U;nodes[i].cfg[4]=0x80000000U+(UINT32)i*0x1000000U;order[i]=i;
+  }
+  GuInit(&services,NULL);Gu.image=(VOID *)99;
+}
+static void refused(void){assert(GuDiscoverTargets()!=EFI_SUCCESS);assert(GuTargetCount()==0);assert(!GuTargetHandleOf(0));}
+static void discovery_tests(void) {
+  setup(2);nodes[0].child=TRUE;order[0]=1;order[1]=0;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetCount()==2);
+  assert(GuTargetHandleOf(0)==&nodes[1] && GuTargetHandleOf(1)==&nodes[0]);
+  assert(GuTargetSpec(0)->subsystem==nodes[1].cfg[11]);
+  assert(GuDiscoverTargets()!=EFI_SUCCESS); /* Registry cannot be reselected. */
+  setup(2);order[0]=1;order[1]=0;assert(GuDiscoverTargets()==EFI_SUCCESS);
+  assert(GuTargetHandleOf(0)==&nodes[0]); /* Stable BDF order, not firmware order. */
+  setup(2);nodes[1].cfg[11]^=1;refused();
+  setup(2);nodes[1].cfg[0]=0x999910deU;refused();
+  setup(3);refused(); /* Never truncate enumeration after the second card. */
+  setup(2);nodes[1].bus=nodes[0].bus;refused();
+  setup(2);order[1]=0;refused();
+  setup(2);nodes[0].child=nodes[1].child=TRUE;refused();
+  setup(2);open_failure=1;refused();
+  setup(2);drift=1;refused();
+  setup(2);reenter=1;refused();
+  setup(1);nodes[0].cfg[1]|=4;refused();
+  setup(1);nodes[0].cfg[4]|=8;refused();
+  setup(1);nodes[0].segment=0x10000;refused();
+  setup(1);nodes[0].bus=0;refused();
+  setup(1);assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetCount()==1);
+}
+static void context_tests(void) {
+  setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS);assert(GuActivate(0)==EFI_SUCCESS);
+  Gu.entry_latched=TRUE;Gu.entry_ss0=123;Gu.entry_ss1=6;Gu.selector_phase=2;Gu.ss1_write_consumed=TRUE;
+  assert(GuActivate(1)==EFI_SUCCESS);assert(!Gu.entry_latched && !Gu.ss1_write_consumed);
+  Gu.entry_ss0=456;assert(GuActivate(0)==EFI_SUCCESS && Gu.entry_ss0==123 && Gu.entry_ss1==6 && Gu.ss1_write_consumed);
+  UINT32 cfg[64];memcpy(cfg,nodes[0].cfg,sizeof(cfg));assert(GuTargetConfig(cfg,0,1,0,0));
+  assert(!GuTargetConfig(cfg,0,2,0,0));cfg[11]^=1;assert(!GuTargetConfig(cfg,0,1,0,0));
+  Gu.board_subsystem^=1;assert(GuActivate(1)!=EFI_SUCCESS && Gu.card_index==0);
+  for(int which=0;which<5;which++) {
+    setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS && GuActivate(0)==EFI_SUCCESS);
+    if(which==0)Gu.dma_count=1;if(which==1)Gu.retained=TRUE;if(which==2)Gu.owned=TRUE;
+    if(which==3)Gu.master_attributes_pending=TRUE;if(which==4)Gu.armed=TRUE;
+    assert(GuActivate(1)!=EFI_SUCCESS && Gu.card_index==0);
+  }
+}
+typedef struct {int trace[8],used,fail_pre,fail_run,fail_verify;} FLOW;
+static EFI_STATUS preflight(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=10+(int)i;
+  if((int)i==f->fail_pre)return EFI_DEVICE_ERROR;
+  return GuActivate(i);
+}
+static EFI_STATUS run(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=20+(int)i;
+  EFI_STATUS s=GuActivate(i);if(s!=EFI_SUCCESS)return s;
+  if((int)i==f->fail_run)return EFI_DEVICE_ERROR;
+  Gu.started=Gu.quiesced=Gu.complete=Gu.post_config_valid=TRUE;return EFI_SUCCESS;
+}
+static EFI_STATUS verify(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=30+(int)i;
+  if((int)i==f->fail_verify)return EFI_DEVICE_ERROR;
+  return GuActivate(i);
+}
+static void coordinator_tests(void) {
+  for(int fail=0;fail<4;fail++) {
+    setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS);
+    FLOW f={{0},0,fail==1?1:-1,fail==2?1:-1,fail==3?0:-1};
+    GU_TARGET_OPS ops={&f,preflight,run,verify};EFI_STATUS s=GuCoordinateTargets(&ops);
+    assert(f.trace[0]==10 && f.trace[1]==11);
+    if(!fail){assert(s==EFI_SUCCESS && f.used==6 && GuAllTargetsComplete());}
+    else if(fail==1){assert(s!=EFI_SUCCESS && f.used==2 && !GuAnyTargetComplete());}
+    else {assert(s!=EFI_SUCCESS && GuAnyTargetComplete());assert(f.used==(fail==2?4:5));}
+  }
+}
+static void capture_pin_tests(void) {
+  setup(2);nodes[0].child=TRUE;order[0]=1;order[1]=0;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetHandleOf(0)==&nodes[1]);
+  assert(GuActivate(0)==EFI_SUCCESS && Gu.bus==2 && Gu.board_subsystem==GuCardTable[1].subsystem);
+  setup(2);nodes[0].child=TRUE;nodes[1].bus=3;refused();
+  setup(2);nodes[0].child=TRUE;nodes[1].cfg[4]+=0x1000000U;refused();
+  setup(1);nodes[0].child=TRUE;refused();
+  setup(2);nodes[1].child=TRUE;refused();
+  puts("PASS immutable capture BDF/BAR/console/full-set pins (including identical IDs/subsystems)");
+}
+int main(void) {
+#ifdef GU_TEST_AMBIGUOUS_TABLE
+  setup(1);refused();puts("PASS ambiguous immutable table rejected before registration");
+#elif defined(GU_TEST_CAPTURE_PINS)
+  capture_pin_tests();
+#else
+  discovery_tests();context_tests();coordinator_tests();
+  puts("PASS production target discovery, exact subsystem/BDF pins, two-card bound, context isolation and all-card coordinator");
+#endif
+  return 0;
+}
diff --git a/research/dual/analyze_pair.py b/research/dual/analyze_pair.py
new file mode 100644
index 0000000..10370f4
--- /dev/null
+++ b/research/dual/analyze_pair.py
@@ -0,0 +1,174 @@
+"""Offline validation of experimental one/two-card read-only captures.
+
+This produces private capture evidence, NEVER an arming profile, build permit or
+hardware qualification. Full driver-release/pair replay is a separate gate.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+
+REPO = Path(__file__).resolve().parents[2]
+ALLOWED = frozenset(('220410de', '220310de', '248710de', '250410de', '248410de', '24c910de'))
+COLD = (0, 0x823804, 0x118128, 0x118234, 0x110100, 0x1fa828, 0x82381c, 0x823820, 0x1183a4)
+PCI_IO = '4cf5b200-68b8-4ca5-9eec-b23e3f50029a'
+_spec = importlib.util.spec_from_file_location('dual_capture_graph', REPO / 'research/profile/capture_graph.py')
+_graph = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_graph)
+
+
+class Refused(ValueError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise Refused(message)
+
+
+def record(text, prefix, pattern):
+    rows = [line for line in text.splitlines() if line.startswith(prefix)]
+    match = re.fullmatch(pattern, rows[0]) if len(rows) == 1 else None
+    require(match is not None, 'Missing, duplicate or malformed ' + prefix)
+    return match
+
+
+def address_record(text, prefix):
+    match = record(text, prefix, re.escape(prefix) + r' seg=0x([0-9a-f]{1,4}) bus=0x([0-9a-f]{1,4}) dev=0x([0-9a-f]{1,4}) fun=0x([0-9a-f]{1,4})')
+    seg, bus, dev, fun = (int(value, 16) for value in match.groups())
+    require(1 <= bus <= 255 and dev == 0 and fun == 0, 'Target is outside the reviewed endpoint layout')
+    return f'{seg:08x}:{bus:02x}:{dev:02x}.{fun:x}'
+
+
+def resource(raw, base):
+    require(len(raw) == 48, 'Incomplete BAR0 resource')
+    desc, length, kind, _, _, bits, lo, hi, translation, size = struct.unpack('<BHBBBQQQQQ', raw[:46])
+    require((desc, length, kind, bits, lo, translation, size) ==
+            (0x8a, 43, 0, 32, base, 0, 0x1000000), 'Unreviewed BAR0 resource')
+    require(hi in (base + size - 1, 0xffffff) and raw[46] == 0x79 and
+            (raw[47] == 0 or sum(raw) % 256 == 0), 'Invalid BAR0 boundary/checksum')
+
+
+def card(text, ordinal, directory, envelope):
+    bdf = address_record(text, 'probe-target')
+    require(record(text, 'cfg256 ', r'cfg256 status=0x([0-9a-f]{16})')[1] == '0000000000000000', 'PCI snapshot failed')
+    row = record(text, 'cfg dwords=', r'cfg dwords=([0-9a-f ]+)')
+    words = row[1].split()
+    require(len(words) == 64 and all(re.fullmatch('[0-9a-f]{8}', value) for value in words), 'Need 64 exact PCI dwords')
+    cfg = [int(value, 16) for value in words]
+    ident = f'{cfg[0]:08x}'
+    require(ident in ALLOWED and ident in envelope['probe_device_ids'], 'Device ID is outside the pinned kit candidates')
+    require(cfg[2] == int(envelope['class_revision'], 16) and cfg[1] & 6 == 2,
+            'Wrong PCI class/revision or MEM/BME state')
+    require(cfg[11] not in (0, 0xffffffff), 'Missing subsystem identity')
+    base = cfg[4]
+    require(base != 0 and base & 0xffffff == 0, 'BAR0 must be an aligned 32-bit 16MiB window')
+    raw = bytes.fromhex(record(text, 'pci-bar0-resource ', r'pci-bar0-resource raw=([0-9a-f]+)')[1])
+    resource(raw, base)
+    attrs = record(text, 'pci-attributes ', r'pci-attributes status=0x([0-9a-f]{16}) value=0x([0-9a-f]{16})')
+    expected = 0x200 | (0x100 if cfg[1] & 1 else 0)
+    require(int(attrs[1], 16) == 0 and int(attrs[2], 16) & 0x700 == expected, 'PCI attribute/command mismatch')
+    mmio = {}
+    for line in text.splitlines():
+        if not line.startswith('mmio '):
+            continue
+        row = re.fullmatch(r'mmio off=0x([0-9a-f]{1,8}) status=0x([0-9a-f]{1,16}) value=0x([0-9a-f]{1,8})', line)
+        require(row is not None, 'Malformed MMIO record')
+        offset, status, value = (int(value, 16) for value in row.groups())
+        require(offset not in mmio and status == 0, 'Duplicate or failed MMIO observation')
+        mmio[offset] = value
+    require(all(offset in mmio for offset in COLD), 'Incomplete cold-state observations')
+    chip, plm, g1, g2, g3, wpr, ss0, ss1, memory = (mmio[offset] for offset in COLD)
+    chips = [entry for entry in envelope['chips'] if int(entry['chip'], 16) == chip]
+    require(len(chips) == 1 and f'{memory:x}' in chips[0]['pci_memory'].get(ident, []), 'Unreviewed chip/device/VRAM tuple')
+    require((plm, g1, g2, g3, wpr) == (0xffffff8f, 0x8b8f, 0x3ff, 0x10, 0) and
+            ss1 <= 15 and ss0 not in (0xffffffff, 0x88888888) and ss0 & 0xffff0000 != 0xbadf0000,
+            'Card is not in the required power-on state')
+    name = record(text, 'prom dump=', r'prom dump=(PROM[0-9]{2}\.BIN)')[1]
+    require(name == f'PROM{ordinal:02d}.BIN', 'PROM filename does not match the BDF-ordered card ordinal')
+    digest = record(text, 'prom sha256=', r'prom sha256=([0-9a-f]{64})')[1]
+    prom = directory / name
+    require(not prom.is_symlink() and prom.is_file() and prom.stat().st_size == 0x100000, 'Need that card\'s exact 1MiB PROM file')
+    require(hashlib.sha256(prom.read_bytes()).hexdigest() == digest, 'PROM hash mismatch; do not swap cards\' ROM files')
+    return {'bdf': bdf, 'pci_id': ident, 'subsystem': f'{cfg[11]:08x}', 'chip': f'{chip:08x}',
+            'memory_mib': memory, 'bar0': base, 'pci_config': cfg, 'mmio': mmio,
+            'prom_sha256': digest, 'prom_file': name}
+
+
+def capture(path, envelope):
+    path = Path(path)
+    require(not path.is_symlink() and path.is_file() and path.stat().st_size <= 8 * 1024 * 1024, 'Need a bounded regular capture file')
+    raw = path.read_bytes()
+    text = raw.decode('utf-8-sig').replace('\r\n', '\n')
+    require(text.splitlines().count('dual-probe-v1 max-targets=2 readonly=1') == 1, 'Need the explicit experimental dual-probe format')
+    require(not any(line.startswith('incomplete ') for line in text.splitlines()), 'Probe reported an incomplete capture')
+    try:
+        blocks = _graph.parse_handles(text)
+    except ValueError as error:
+        raise Refused(str(error)) from error
+    parts = re.findall(r'^dual-card-begin index=([0-9a-f]{4})\n(.*?)^dual-card-end index=\1\n', text, re.M | re.S)
+    require(1 <= len(parts) <= 2 and len(re.findall(r'^dual-card-(?:begin|end)', text, re.M)) == 2 * len(parts), 'Need one or two closed card records')
+    require([index for index, _ in parts] == [f'{index:04x}' for index in range(len(parts))], 'Duplicate or unordered card ordinal')
+    summary = record(text, 'probe targets=', r'probe targets=([0-9a-f]{4}) cfg-incomplete=([0-9a-f]{4})')
+    require(int(summary[1], 16) == len(parts) and int(summary[2], 16) == 0 and
+            len(re.findall(r'^probe-target ', text, re.M)) == len(parts), 'Probe cardinality disagrees with the pair records')
+    cards = [card(section, ordinal, path.parent, envelope) for ordinal, (_, section) in enumerate(parts)]
+    bdfs = [entry['bdf'] for entry in cards]
+    require(bdfs == sorted(set(bdfs)), 'Cards must have unique, sorted physical BDFs')
+    for index, entry in enumerate(cards):
+        for peer in cards[index + 1:]:
+            require(abs(entry['bar0'] - peer['bar0']) >= 0x1000000, 'Target BAR0 windows overlap')
+    graph_cards = {}
+    for block in blocks.values():
+        if PCI_IO not in block['protocols']:
+            continue
+        row = record(block['raw'], 'pci config-dwords=', r'pci config-dwords=([0-9a-f ]+)')
+        cfg = [int(value, 16) for value in row[1].split()]
+        if cfg[0] & 0xffff != 0x10de or cfg[2] >> 24 != 3:
+            continue
+        location = record(block['raw'], 'pci location-status=', r'pci location-status=0x([0-9a-f]{1,16}) segment=0x([0-9a-f]{1,16}) bus=0x([0-9a-f]{1,16}) device=0x([0-9a-f]{1,16}) function=0x([0-9a-f]{1,16})')
+        status, seg, bus, dev, fun = (int(value, 16) for value in location.groups())
+        bdf = f'{seg:08x}:{bus:02x}:{dev:02x}.{fun:x}'
+        require(status == 0 and seg <= 0xffff and 1 <= bus <= 255 and dev == 0 and fun == 0 and bdf not in graph_cards, 'Ambiguous graph PCI identity')
+        graph_cards[bdf] = cfg
+    require(set(graph_cards) == set(bdfs), 'Whole graph contains a missing, extra or different NVIDIA controller')
+    for entry in cards:
+        require(graph_cards[entry['bdf']] == entry['pci_config'][:16], 'Graph and deep capture disagree on a card')
+    return {'cards': cards, 'capture_sha256': hashlib.sha256(raw).hexdigest()}
+
+
+def analyze(first, second, envelope):
+    require(Path(first).resolve() != Path(second).resolve(), 'Two different capture files are required')
+    before, after = capture(first, envelope), capture(second, envelope)
+    require(before['cards'] == after['cards'], 'The complete installed card set changed between captures')
+    return {'schema': 'dual-capture-review-v1', 'can_unlock': False, 'can_build_write_efi': False,
+            'physical_qualification': False, 'card_count': len(before['cards']), 'cards': before['cards'],
+            'captures': [before['capture_sha256'], after['capture_sha256']],
+            'pending': ['Exact driver-code and whole-pair ownership/release replay',
+                        'Per-card actual-PROM/firmware host transaction jobs',
+                        'Supervised physical two-card boot and per-card measurements']}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--first', required=True, type=Path)
+    parser.add_argument('--second', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path, help='New private JSON filename; never an arming profile')
+    args = parser.parse_args(argv)
+    envelope = json.loads((REPO / 'research/profile/proven.json').read_text(encoding='utf-8'))
+    try:
+        result = analyze(args.first, args.second, envelope)
+        with args.output.open('x', encoding='utf-8') as stream:
+            json.dump(result, stream, indent=2)
+            stream.write('\n')
+    except (OSError, ValueError) as error:
+        parser.exit(1, 'Capture review refused: ' + str(error) + '\n')
+    print(f"Reviewed {result['card_count']} candidate card(s); no write build or unlock is authorized. Keep the JSON private.")
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/dual/build-probe.ps1 b/research/dual/build-probe.ps1
new file mode 100644
index 0000000..91feaf9
--- /dev/null
+++ b/research/dual/build-probe.ps1
@@ -0,0 +1,51 @@
+# GPL-2.0-only. Explicit experimental read-only build only; never stages or boots.
+# Separate artifact directory/manifest prevents use by the single-card pipeline.
+param([Parameter(Mandatory)][guid]$WindowsEspGuid,[string]$Clang='clang',[string]$LldLink='lld-link',
+      [string]$Python='python',[ValidateSet(1,2)][int]$MaxTargets=1,[switch]$ExperimentalDual)
+$ErrorActionPreference='Stop'
+if(!$ExperimentalDual -or $MaxTargets -ne 2){throw 'This read-only experiment requires both -ExperimentalDual and -MaxTargets 2.'}
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+$boot=Join-Path $repo 'internal-boot/boot'
+. (Join-Path $repo 'research/profile/probe-manifest.ps1')
+$files=@(Get-GuGenericProbeFiles)+@('research/dual/build-probe.ps1')
+$sourceRows=@($files | ForEach-Object {[ordered]@{Path=$_;Sha256=(Get-FileHash -LiteralPath (Join-Path $repo $_)).Hash.ToLowerInvariant()}})
+$windows=@(Get-Partition | Where-Object {$_.Guid -and [guid]$_.Guid -eq $WindowsEspGuid})
+if($windows.Count -ne 1 -or !$windows[0].IsSystem){throw 'WindowsEspGuid must identify the current system EFI partition.'}
+function GuidC([guid]$Value){
+ $b=$Value.ToByteArray();$tail=($b[8..15] | ForEach-Object {'0x{0:x2}' -f $_}) -join ','
+ return ('{{0x{0:x8},0x{1:x4},0x{2:x4},{{{3}}}}}' -f [BitConverter]::ToUInt32($b,0),[BitConverter]::ToUInt16($b,4),[BitConverter]::ToUInt16($b,6),$tail)
+}
+$config=Join-Path $boot 'platform-config.h'
+$marker='/* Local USB configuration (build-usb.ps1). Internal partition unused under GU_USB_MEDIA. */'
+if((Test-Path -LiteralPath $config) -and (Get-Content -LiteralPath $config -TotalCount 1) -ne $marker){throw 'platform-config.h belongs to a different setup; preserve it before a separate USB experiment.'}
+@($marker,('#define GU_INTERNAL_PARTITION_INITIALIZER '+(GuidC ([guid]::Empty))),('#define GU_WINDOWS_PARTITION_INITIALIZER '+(GuidC $WindowsEspGuid))) | Set-Content -LiteralPath $config -Encoding ascii
+$generated=Join-Path $boot 'generated.h'
+if(!(Test-Path -LiteralPath $generated)){'/* Read-only experimental probe: no unlock child. */' | Set-Content -LiteralPath $generated -Encoding ascii}
+Push-Location -LiteralPath $boot
+try {
+ $out='build/probe-dual-experimental'
+ New-Item -ItemType Directory -Path $out -Force | Out-Null
+ $sources=@('handoff.c','diagnostic.c','../efi_runtime.c','probe.c','probe-parent.c','../unlock/sha256.c',
+   '../../research/pci-decode/efi-capture.c','../../research/pci-decode/snapshot.c')
+ $defines=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_USB_PROBE',
+   '-DGU_PROBE_PARENT_BASELINE','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2')
+ $objects=@()
+ foreach($source in $sources){
+  $obj="$out/"+[IO.Path]::GetFileNameWithoutExtension($source)+'.obj'
+  & $Clang -target x86_64-pc-windows-msvc -std=c11 -ffreestanding -fno-builtin -fno-stack-protector -mno-red-zone -fshort-wchar -Os -Wall -Wextra -Werror @defines -I ../../deps/edk2/MdePkg/Include -I ../../deps/edk2/MdePkg/Include/X64 -c $source -o $obj
+  if($LASTEXITCODE -ne 0){throw "Experimental dual compile failed: $source"};$objects+=$obj
+ }
+ & $LldLink /nologo /nodefaultlib /subsystem:efi_application /entry:efi_main /machine:x64 /base:0 /dynamicbase /nxcompat /timestamp:0 /opt:ref /opt:icf "/map:$out/PROBE.map" "/out:$out/BOOTX64.EFI" @objects
+ if($LASTEXITCODE -ne 0){throw 'Experimental dual probe link failed'}
+ & $Python -I ../unlock/verify_pe.py "$out/BOOTX64.EFI" "$out/PROBE.map" --output "$out/pe-verification.json"
+ if($LASTEXITCODE -ne 0){throw 'Experimental dual PE verification failed'}
+ $map=[IO.File]::ReadAllText((Join-Path $boot "$out/PROBE.map"))
+ if($map -match '\b(GuDecodeSync|GuDsEfiRun|GuDsEfiInitialize)\b'){throw 'Write/correction actuator reached the read-only image'}
+ foreach($row in $sourceRows){if((Get-FileHash -LiteralPath (Join-Path $repo $row.Path)).Hash.ToLowerInvariant() -cne $row.Sha256){throw 'Source changed during the experimental build'}}
+ [ordered]@{Mode='experimental-dual-read-only-probe-then-windows-usb';Format='dual-probe-v1';MaxTargets=2
+  CanUnlock=$false;CanDetach=$false;WritesFirmwareVariables=$false;HardwareTested=$false
+  Experimental=$true;Defines=$defines;ProbeBusMode='auto';TargetBus=$null
+  EfiSha256=(Get-FileHash -LiteralPath "$out/BOOTX64.EFI").Hash.ToLowerInvariant();BuiltUtc=[DateTime]::UtcNow.ToString('o');Sources=$sourceRows
+ } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath "$out/manifest.json" -Encoding utf8
+ Write-Output "Built $out/BOOTX64.EFI: experimental read-only capture, not an unlock. Nothing staged or booted."
+} finally {Pop-Location}
diff --git a/research/dual/test-probe.ps1 b/research/dual/test-probe.ps1
new file mode 100644
index 0000000..bb8a492
--- /dev/null
+++ b/research/dual/test-probe.ps1
@@ -0,0 +1,44 @@
+# GPL-2.0-only. RAM-only EFI mocks and compile guards; no disk/GPU/UEFI actions.
+param([Parameter(Mandatory)][string]$Clang,[string]$VcVars)
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+. (Join-Path $repo 'research/profile/host.ps1')
+Import-GuHostCompiler $VcVars
+Push-Location -LiteralPath (Join-Path $repo 'internal-boot/boot')
+try {
+ New-Item -ItemType Directory -Path 'build/dual-tests' -Force | Out-Null
+ $includes=@('-I','../../deps/edk2/MdePkg/Include','-I','../../deps/edk2/MdePkg/Include/X64')
+ $flags=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2')
+ & $Clang -std=c11 -O1 -Wall -Wextra -Werror -D_CRT_SECURE_NO_WARNINGS @flags @includes test_probe_dual.c probe.c ../unlock/sha256.c -o build/dual-tests/test-probe-dual.exe
+ if($LASTEXITCODE -ne 0){throw 'Dual RAM-only test compile failed'}
+ & ./build/dual-tests/test-probe-dual.exe
+ if($LASTEXITCODE -ne 0){throw 'Dual RAM-only test failed'}
+ $guardChecks=0
+ foreach($bad in @('-UGU_DIAGNOSTIC_ONLY','-UGU_PROBE_GENERIC','-UGU_DIAGNOSTIC_PROBE','-UGU_PROBE_AUTO_BUS','-DGU_FULL_UNLOCK','-DGU_EXPERIMENTAL_3090','-DGU_PROBE_MAX_TARGETS=1','-UGU_PROBE_DUAL')){
+  $messages=& $Clang -target x86_64-pc-windows-msvc -std=c11 -ffreestanding -fshort-wchar -fsyntax-only @flags $bad @includes probe.c 2>&1 | Out-String
+  if($LASTEXITCODE -eq 0 -or $messages -notmatch 'GU_PROBE_DUAL|Multiple probe targets require'){throw "Unsafe dual compile mode accepted: $bad"};$guardChecks++
+ }
+ Write-Output "PASS $guardChecks experimental dual compile guards."
+ # Invalid CLI combinations must stop before even a partition query. The valid
+ # build below uses a dummy ESP and mocked query; its EFI must never be booted.
+ $dummy=[guid]'11111111-2222-3333-4444-555555555555';$queryCounter=@{Count=0}
+ function Get-Partition {$queryCounter.Count++;[pscustomobject]@{Guid=$dummy;IsSystem=$true}}
+ $entry=Join-Path $repo 'research/profile/build-probe.ps1'
+ foreach($case in @(@{MaxTargets=2},@{ExperimentalDual=$true},@{ExperimentalDual=$true;MaxTargets=2;TargetBus=1})){
+  $refused=$false
+  try {& $entry -WindowsEspGuid $dummy @case} catch {$refused=$true}
+  if(!$refused -or $queryCounter.Count){throw 'Unsafe dual CLI reached a partition query'}
+ }
+ $linker=Join-Path (Split-Path $Clang) 'lld-link.exe'
+ $python=(Get-Command python.exe -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source
+ & $entry -WindowsEspGuid $dummy -Clang $Clang -LldLink $linker -Python $python -ExperimentalDual -MaxTargets 2
+ if(!$? -or $queryCounter.Count -ne 1){throw 'Dummy-ESP dual build failed'}
+ $artifact=Join-Path $repo 'internal-boot/boot/build/probe-dual-experimental'
+ $manifest=Get-Content -LiteralPath (Join-Path $artifact 'manifest.json') -Raw | ConvertFrom-Json
+ if($manifest.MaxTargets -ne 2 -or !$manifest.Experimental -or $manifest.CanUnlock -or $manifest.CanDetach -or $manifest.WritesFirmwareVariables -or $manifest.HardwareTested){throw 'Invalid experimental read-only manifest'}
+ . (Join-Path $repo 'research/profile/probe-manifest.ps1')
+ $refused=$false
+ try {Assert-GuGenericProbeManifest $repo $manifest (Join-Path $artifact 'BOOTX64.EFI')} catch {$refused=$true}
+ if(!$refused){throw 'Production single-card manifest accepted the dual experimental image'}
+ Write-Output 'PASS 5 dual CLI/build checks: dummy ESP only; nothing staged; never boot the test artifact.'
+} finally {Pop-Location}
diff --git a/research/dual/test_analyze_pair.py b/research/dual/test_analyze_pair.py
new file mode 100644
index 0000000..5361e40
--- /dev/null
+++ b/research/dual/test_analyze_pair.py
@@ -0,0 +1,320 @@
+"""Synthetic offline pair-capture admission tests; no firmware/GPU execution.
+
+The ROM buffers and logs below are invented. Passing these checks never supplies
+driver-release replay, an arming profile or physical two-card qualification.
+"""
+import contextlib
+import copy
+import hashlib
+import importlib.util
+import io
+import json
+from pathlib import Path
+import re
+import struct
+import tempfile
+import unittest
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+PAIR = load_module("synthetic_pair_analyzer", HERE / "analyze_pair.py")
+LEGACY = load_module("synthetic_pair_legacy_profile", REPO / "research/profile/make-profile.py")
+ENVELOPE = json.loads((REPO / "research/profile/proven.json").read_text(encoding="utf-8"))
+PCI_IO = "4cf5b200-68b8-4ca5-9eec-b23e3f50029a"
+DRIVER = "18a031ab-b443-4d1a-a5c0-0c09261e9f71"
+OTHER = "12345678-0000-0000-0000-000000000000"
+PROM_BYTES = 0x100000
+
+
+def cards():
+    return [dict(bus=1, board=0x220410de, chip=0xb72000a1, memory=0x6000,
+                 subsystem=0x147d10de, bar=0xf5000000, prom=b"\xa1" * PROM_BYTES),
+            dict(bus=2, board=0x248410de, chip=0xb74000a1, memory=0x2000,
+                 subsystem=0x38811462, bar=0xf6000000, prom=b"\xb2" * PROM_BYTES)]
+
+
+def config(card):
+    words = [0] * 64
+    for index, value in {0: card["board"], 1: 0x00100002, 2: 0x030000a1,
+                         4: card["bar"], 11: card["subsystem"], 13: 0x40,
+                         16: 0x00014801, 18: 0x00020010, 19: 1 << 28}.items():
+        words[index] = value
+    return words
+
+
+def bar_resource(base, inclusive=False):
+    # Packed EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR (46 bytes) plus 2-byte end tag.
+    return struct.pack("<BHBBBQQQQQBB", 0x8a, 43, 0, 0, 0, 32, base,
+                       base + 0xffffff if inclusive else 0xffffff, 0, 0x1000000, 0x79, 0)
+
+
+def render(card_set, *, boot=0, graph_cards=None, graph_reverse=False, inclusive=False):
+    """Whole graph with real-format PCI_IO nodes and one shared driver agent."""
+    lines = ["SYNTHETIC FIXTURE; no hardware observations; boot=" + str(boot),
+             PAIR._graph.MARKER, "dual-probe-v1 max-targets=2 readonly=1"]
+    for ordinal, card in enumerate(card_set):
+        cfg = config(card)
+        lines += [f"dual-card-begin index={ordinal:04x}",
+                  f"probe-target seg=0x0000 bus=0x{card['bus']:04x} dev=0x0000 fun=0x0000",
+                  "cfg256 status=0x0000000000000000",
+                  "cfg dwords=" + " ".join(f"{word:08x}" for word in cfg),
+                  "pci-bar0-resource raw=" + bar_resource(card["bar"], inclusive).hex(),
+                  "pci-attributes status=0x0000000000000000 value=0x0000000000000200"]
+        values = (card["chip"], 0xffffff8f, 0x8b8f, 0x3ff, 0x10, 0, 0x03000062, 6, card["memory"])
+        lines += [f"mmio off=0x{offset:08x} status=0x0000000000000000 value=0x{value:08x}"
+                  for offset, value in zip(PAIR.COLD, values)]
+        lines += [f"prom dump=PROM{ordinal:02d}.BIN",
+                  "prom sha256=" + hashlib.sha256(card["prom"]).hexdigest(),
+                  f"dual-card-end index={ordinal:04x}"]
+    lines.append(f"probe targets={len(card_set):04x} cfg-incomplete=0000")
+    graph_cards = card_set if graph_cards is None else graph_cards
+    graph = []
+    for index, card in enumerate(graph_cards):
+        handle = 0x10 + index
+        graph.append([f"handle id=0x{handle:x}", "protocol guid=" + PCI_IO,
+                      "opens status=0x0000000000000000 count=0x1",
+                      f"open agent=0x90 controller=0x{handle:x} attributes=0x10 count=0x1",
+                      f"pci location-status=0x0 segment=0x0 bus=0x{card['bus']:x} device=0x0 function=0x0",
+                      "pci config-status=0x0000000000000000",
+                      "pci config-dwords=" + " ".join(f"{word:08x}" for word in config(card)[:16])])
+    # Unrelated protected ownership and the referenced shared driver both resolve.
+    graph += [["handle id=0x80", "protocol guid=" + OTHER,
+               "opens status=0x0000000000000000 count=0x1",
+               "open agent=0x90 controller=0x80 attributes=0x10 count=0x1"],
+              ["handle id=0x90", "protocol guid=" + DRIVER,
+               "opens status=0x0000000000000000 count=0x0"]]
+    if graph_reverse:
+        graph.reverse()
+    lines.append(f"handles status=0x0000000000000000 count=0x{len(graph):x}")
+    for block in graph:
+        lines += block
+    lines += ["capture-complete=1", "diagnostic-result status=0x0000000000000000"]
+    return "\n".join(lines) + "\n"
+
+
+class AnalyzePairTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.first = self.root / "DIAG00.TXT"
+        self.second = self.root / "DIAG01.TXT"
+        self.card_set = cards()
+        self.write_pair(self.card_set)
+
+    def write_pair(self, card_set, *, second_cards=None, **kwargs):
+        for ordinal, card in enumerate(card_set):
+            (self.root / f"PROM{ordinal:02d}.BIN").write_bytes(card["prom"])
+        self.first.write_text(render(card_set, boot=0, **kwargs), encoding="ascii")
+        self.second.write_text(render(card_set if second_cards is None else second_cards, boot=1, **kwargs), encoding="ascii")
+
+    def analyze(self):
+        return PAIR.analyze(self.first, self.second, ENVELOPE)
+
+    def reject_text(self, mutate, regex=None):
+        original = self.second.read_text(encoding="ascii")
+        changed = mutate(original)
+        self.assertNotEqual(changed, original, "test mutation must change the fixture")
+        self.second.write_text(changed, encoding="ascii")
+        try:
+            with self.assertRaisesRegex(PAIR.Refused, regex or ".+"):
+                self.analyze()
+        finally:
+            self.second.write_text(original, encoding="ascii")
+
+    def test_one_and_two_cards_remain_observations_without_build_permission(self):
+        self.assertEqual(len(bar_resource(self.card_set[0]["bar"])), 48)
+        for count in (1, 2):
+            for inclusive in (False, True):
+                with self.subTest(count=count, inclusive=inclusive):
+                    self.write_pair(self.card_set[:count], inclusive=inclusive)
+                    report = self.analyze()
+                    self.assertEqual(report["schema"], "dual-capture-review-v1")
+                    self.assertEqual(report["card_count"], count)
+                    self.assertEqual([card["bdf"] for card in report["cards"]],
+                                     [f"00000000:{index:02x}:00.0" for index in range(1, count + 1)])
+                    for key in ("can_unlock", "can_build_write_efi", "physical_qualification"):
+                        self.assertIs(report[key], False)
+                    self.assertTrue(any("driver" in item.lower() and "replay" in item.lower() for item in report["pending"]))
+                    self.assertTrue(any("physical" in item.lower() for item in report["pending"]))
+                    self.assertEqual(report["captures"], [hashlib.sha256(path.read_bytes()).hexdigest()
+                                                          for path in (self.first, self.second)])
+
+    def test_whole_graph_order_is_irrelevant_but_card_order_must_be_sorted(self):
+        self.second.write_text(render(self.card_set, boot=1, graph_reverse=True), encoding="ascii")
+        self.assertEqual(self.analyze()["card_count"], 2)
+        self.write_pair(list(reversed(self.card_set)))
+        with self.assertRaisesRegex(PAIR.Refused, "sorted physical BDF"):
+            self.analyze()
+
+    def test_identical_card_models_and_rom_hashes_still_use_distinct_bdfs(self):
+        twins = [copy.deepcopy(self.card_set[0]), copy.deepcopy(self.card_set[0])]
+        twins[1].update(bus=2, bar=0xf6000000)
+        self.write_pair(twins)
+        report = self.analyze()
+        self.assertEqual(report["card_count"], 2)
+        self.assertEqual(report["cards"][0]["pci_id"], report["cards"][1]["pci_id"])
+        self.assertEqual(report["cards"][0]["prom_sha256"], report["cards"][1]["prom_sha256"])
+        self.assertNotEqual(report["cards"][0]["bdf"], report["cards"][1]["bdf"])
+        self.assertEqual([card["prom_file"] for card in report["cards"]], ["PROM00.BIN", "PROM01.BIN"])
+        self.assertIs(report["can_build_write_efi"], False)
+
+    def test_same_capture_path_is_not_two_boot_evidence(self):
+        with self.assertRaisesRegex(PAIR.Refused, "different capture"):
+            PAIR.analyze(self.first, self.root / "." / self.first.name, ENVELOPE)
+
+    def test_swapped_missing_wrong_sized_and_modified_prom_files_fail(self):
+        first_prom = self.root / "PROM00.BIN"
+        second_prom = self.root / "PROM01.BIN"
+        first_prom.write_bytes(self.card_set[1]["prom"])
+        second_prom.write_bytes(self.card_set[0]["prom"])
+        with self.assertRaisesRegex(PAIR.Refused, "PROM hash mismatch"):
+            self.analyze()
+        for payload in (None, b"", b"x" * (PROM_BYTES - 1), b"x" * (PROM_BYTES + 1), b"x" * PROM_BYTES):
+            self.write_pair(self.card_set)
+            if payload is None:
+                second_prom.unlink()
+            else:
+                second_prom.write_bytes(payload)
+            with self.subTest(size=None if payload is None else len(payload)), self.assertRaises(PAIR.Refused):
+                self.analyze()
+
+    def test_prom_name_cannot_select_another_card_or_escape_directory(self):
+        for name in ("PROM00.BIN", "PROM.BIN", "../PROM01.BIN", "PROM02.BIN"):
+            with self.subTest(name=name):
+                self.reject_text(lambda text, name=name: text.replace("prom dump=PROM01.BIN", "prom dump=" + name))
+
+    def test_third_missing_extra_graph_and_duplicate_bdf_cards_fail(self):
+        third = dict(self.card_set[0], bus=3, bar=0xf7000000, prom=b"\xc3" * PROM_BYTES)
+        self.write_pair(self.card_set + [third])
+        with self.assertRaisesRegex(PAIR.Refused, "one or two"):
+            self.analyze()
+        self.write_pair(self.card_set)
+        for graph_cards in (self.card_set[:1], self.card_set + [third], [self.card_set[0], self.card_set[0]]):
+            self.second.write_text(render(self.card_set, graph_cards=graph_cards), encoding="ascii")
+            with self.subTest(graph_count=len(graph_cards)), self.assertRaises(PAIR.Refused):
+                self.analyze()
+        duplicate = copy.deepcopy(self.card_set)
+        duplicate[1]["bus"] = duplicate[0]["bus"]
+        self.write_pair(duplicate)
+        with self.assertRaisesRegex(PAIR.Refused, "unique, sorted"):
+            self.analyze()
+
+    def test_overlapping_bars_unsupported_id_and_unreviewed_vram_fail(self):
+        for field, value, expected in (("bar", 0xf5000000, "overlap"), ("board", 0x220610de, "Device ID"),
+                                       ("memory", 0x6000, "chip/device/VRAM"), ("chip", 0xb76000a1, "chip/device/VRAM")):
+            changed = copy.deepcopy(self.card_set)
+            changed[1][field] = value
+            self.write_pair(changed)
+            with self.subTest(field=field), self.assertRaisesRegex(PAIR.Refused, expected):
+                self.analyze()
+
+    def test_failed_duplicate_missing_mmio_and_non_cold_state_fail(self):
+        row = "mmio off=0x001183a4 status=0x0000000000000000 value=0x00002000"
+        for replacement in (row.replace("status=0x0000000000000000", "status=0x8000000000000007"),
+                            row + "\n" + row, "", "mmio off=bad"):
+            with self.subTest(replacement=replacement):
+                self.reject_text(lambda text, replacement=replacement: text.replace(row, replacement))
+        for offset, value in ((0x1fa828, 1), (0x823804, 0), (0x82381c, 0x88888888),
+                              (0x82381c, 0xffffffff), (0x82381c, 0xbadf0001), (0x823820, 16)):
+            pattern = rf"(mmio off=0x{offset:08x} status=0x0000000000000000 value=0x)[0-9a-f]+"
+            with self.subTest(offset=offset, value=value):
+                self.reject_text(lambda text, pattern=pattern, value=value:
+                                 re.sub(pattern, lambda match: match[1] + f"{value:08x}", text, count=1))
+
+    def test_complete_footer_header_card_markers_and_counts_are_strict(self):
+        mutations = [lambda text: text.replace("capture-complete=1", "capture-complete=0"),
+                     lambda text: text.replace("capture-complete=1", "capture-complete=1\ncapture-complete=1"),
+                     lambda text: text.replace("diagnostic-result status=0x0000000000000000", "diagnostic-result status=0x8000000000000007"),
+                     lambda text: text.replace("readonly=1", "readonly=0"),
+                     lambda text: text.replace("dual-probe-v1 max-targets=2 readonly=1", ""),
+                     lambda text: text.replace("dual-probe-v1 max-targets=2 readonly=1", "dual-probe-v1 max-targets=2 readonly=1\ndual-probe-v1 max-targets=2 readonly=1"),
+                     lambda text: text.replace("dual-card-end index=0001", "dual-card-end index=0000"),
+                     lambda text: text.replace("dual-card-begin index=0001", "dual-card-begin index=0002"),
+                     lambda text: text.replace("probe targets=0002 cfg-incomplete=0000", "probe targets=0001 cfg-incomplete=0000"),
+                     lambda text: text.replace("cfg-incomplete=0000", "cfg-incomplete=0001"),
+                     lambda text: text.replace("capture-complete=1", "incomplete reason=probe-MMIO status=0x8000000000000007\ncapture-complete=1")]
+        for index, mutation in enumerate(mutations):
+            with self.subTest(case=index):
+                self.reject_text(mutation)
+
+    def test_cfg_attributes_resource_and_graph_snapshots_are_required(self):
+        cfg = "cfg dwords=" + " ".join(f"{word:08x}" for word in config(self.card_set[0]))
+        resource = "pci-bar0-resource raw=" + bar_resource(self.card_set[0]["bar"]).hex()
+        mutations = [lambda text: text.replace("cfg256 status=0x0000000000000000", "cfg256 status=0x8000000000000007", 1),
+                     lambda text: text.replace(cfg, "cfg dwords=" + " ".join(cfg.split("=", 1)[1].split()[:-1]), 1),
+                     lambda text: text.replace(resource, resource[:-2], 1),
+                     lambda text: text.replace(resource, "pci-bar0-resource raw=" + (bar_resource(self.card_set[0]["bar"])[:-1] + b"\x01").hex(), 1),
+                     lambda text: text.replace("value=0x0000000000000200", "value=0x0000000000000600", 1),
+                     lambda text: text.replace("pci config-status=0x0000000000000000", "pci config-status=0x8000000000000007", 1),
+                     lambda text: text.replace("controller=0x10 attributes=0x10 count=0x1", "controller=0x99 attributes=0x10 count=0x1", 1)]
+        for index, mutation in enumerate(mutations):
+            with self.subTest(case=index):
+                self.reject_text(mutation)
+
+    def test_graph_and_deep_card_identity_disagreement_is_rejected(self):
+        graph = copy.deepcopy(self.card_set)
+        graph[1]["subsystem"] ^= 1
+        self.second.write_text(render(self.card_set, graph_cards=graph), encoding="ascii")
+        with self.assertRaisesRegex(PAIR.Refused, "Graph and deep capture disagree"):
+            self.analyze()
+
+    def test_complete_installed_set_must_agree_between_boots(self):
+        changed = copy.deepcopy(self.card_set)
+        changed[0]["subsystem"] ^= 1
+        self.write_pair(self.card_set, second_cards=changed)
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+        changed = copy.deepcopy(self.card_set)
+        for key in ("board", "chip", "memory", "subsystem"):
+            changed[0][key], changed[1][key] = changed[1][key], changed[0][key]
+        self.write_pair(self.card_set, second_cards=changed)
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+        self.second.write_text(render(self.card_set[:1]), encoding="ascii")
+        with self.assertRaisesRegex(PAIR.Refused, "changed between captures"):
+            self.analyze()
+
+    def test_legacy_generator_refuses_dual_header_even_single_card_with_renamed_prom(self):
+        self.write_pair(self.card_set[:1])
+        renamed = self.first.read_text().replace("prom dump=PROM00.BIN", "prom dump=PROM.BIN")
+        self.first.write_text(renamed, encoding="ascii")
+        (self.root / "PROM.BIN").write_bytes(self.card_set[0]["prom"])
+        with self.assertRaisesRegex(LEGACY.Refused, "experimental dual captures cannot authorize"):
+            LEGACY.analyze(self.first, None, ENVELOPE)
+
+    def test_cli_writes_only_non_authorizing_json_and_refuses_existing_output(self):
+        output = self.root / "private-review.json"
+        arguments = ["--first", str(self.first), "--second", str(self.second), "--output", str(output)]
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            PAIR.main(arguments)
+        report = json.loads(output.read_text())
+        self.assertIs(report["can_unlock"], False)
+        self.assertIs(report["can_build_write_efi"], False)
+        original = output.read_bytes()
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as stopped:
+                PAIR.main(arguments)
+        self.assertEqual(stopped.exception.code, 1)
+        self.assertEqual(output.read_bytes(), original)
+        invalid_output = self.root / "invalid.json"
+        self.second.write_text(self.second.read_text().replace("capture-complete=1", "capture-complete=0"))
+        arguments[-1] = str(invalid_output)
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                PAIR.main(arguments)
+        self.assertFalse(invalid_output.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
