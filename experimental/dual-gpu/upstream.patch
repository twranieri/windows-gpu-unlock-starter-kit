index 0000000000000000000000000000000000000000..91feaf9e5bdbeff43e532c663cedcf6878e0500f
--- /dev/null
+++ b/research/dual/build-probe.ps1
@@ -0,0 +1,51 @@
+# GPL-2.0-only. Explicit experimental read-only build only; never stages or boots.
+# Separate artifact directory/manifest prevents use by the single-card pipeline.
+param([Parameter(Mandatory)][guid]$WindowsEspGuid,[string]$Clang='clang',[string]$LldLink='lld-link',
+      [string]$Python='python',[ValidateSet(1,2)][int]$MaxTargets=1,[switch]$ExperimentalDual)
+$ErrorActionPreference='Stop'
+if(!$ExperimentalDual -or $MaxTargets -ne 2){throw 'This read-only experiment requires both -ExperimentalDual and -MaxTargets 2.'}
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+$boot=Join-Path $repo 'internal-boot/boot'
+. (Join-Path $repo 'research/profile/probe-manifest.ps1')
+$files=@(Get-GuGenericProbeFiles)+@('research/dual/build-probe.ps1')
+$sourceRows=@($files | ForEach-Object {[ordered]@{Path=$_;Sha256=(Get-FileHash -LiteralPath (Join-Path $repo $_)).Hash.ToLowerInvariant()}})
+$windows=@(Get-Partition | Where-Object {$_.Guid -and [guid]$_.Guid -eq $WindowsEspGuid})
+if($windows.Count -ne 1 -or !$windows[0].IsSystem){throw 'WindowsEspGuid must identify the current system EFI partition.'}
+function GuidC([guid]$Value){
+ $b=$Value.ToByteArray();$tail=($b[8..15] | ForEach-Object {'0x{0:x2}' -f $_}) -join ','
+ return ('{{0x{0:x8},0x{1:x4},0x{2:x4},{{{3}}}}}' -f [BitConverter]::ToUInt32($b,0),[BitConverter]::ToUInt16($b,4),[BitConverter]::ToUInt16($b,6),$tail)
+}
+$config=Join-Path $boot 'platform-config.h'
+$marker='/* Local USB configuration (build-usb.ps1). Internal partition unused under GU_USB_MEDIA. */'
+if((Test-Path -LiteralPath $config) -and (Get-Content -LiteralPath $config -TotalCount 1) -ne $marker){throw 'platform-config.h belongs to a different setup; preserve it before a separate USB experiment.'}
+@($marker,('#define GU_INTERNAL_PARTITION_INITIALIZER '+(GuidC ([guid]::Empty))),('#define GU_WINDOWS_PARTITION_INITIALIZER '+(GuidC $WindowsEspGuid))) | Set-Content -LiteralPath $config -Encoding ascii
+$generated=Join-Path $boot 'generated.h'
+if(!(Test-Path -LiteralPath $generated)){'/* Read-only experimental probe: no unlock child. */' | Set-Content -LiteralPath $generated -Encoding ascii}
+Push-Location -LiteralPath $boot
+try {
+ $out='build/probe-dual-experimental'
+ New-Item -ItemType Directory -Path $out -Force | Out-Null
+ $sources=@('handoff.c','diagnostic.c','../efi_runtime.c','probe.c','probe-parent.c','../unlock/sha256.c',
+   '../../research/pci-decode/efi-capture.c','../../research/pci-decode/snapshot.c')
+ $defines=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_USB_PROBE',
+   '-DGU_PROBE_PARENT_BASELINE','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2')
+ $objects=@()
+ foreach($source in $sources){
+  $obj="$out/"+[IO.Path]::GetFileNameWithoutExtension($source)+'.obj'
+  & $Clang -target x86_64-pc-windows-msvc -std=c11 -ffreestanding -fno-builtin -fno-stack-protector -mno-red-zone -fshort-wchar -Os -Wall -Wextra -Werror @defines -I ../../deps/edk2/MdePkg/Include -I ../../deps/edk2/MdePkg/Include/X64 -c $source -o $obj
+  if($LASTEXITCODE -ne 0){throw "Experimental dual compile failed: $source"};$objects+=$obj
+ }
+ & $LldLink /nologo /nodefaultlib /subsystem:efi_application /entry:efi_main /machine:x64 /base:0 /dynamicbase /nxcompat /timestamp:0 /opt:ref /opt:icf "/map:$out/PROBE.map" "/out:$out/BOOTX64.EFI" @objects
+ if($LASTEXITCODE -ne 0){throw 'Experimental dual probe link failed'}
+ & $Python -I ../unlock/verify_pe.py "$out/BOOTX64.EFI" "$out/PROBE.map" --output "$out/pe-verification.json"
+ if($LASTEXITCODE -ne 0){throw 'Experimental dual PE verification failed'}
+ $map=[IO.File]::ReadAllText((Join-Path $boot "$out/PROBE.map"))
+ if($map -match '\b(GuDecodeSync|GuDsEfiRun|GuDsEfiInitialize)\b'){throw 'Write/correction actuator reached the read-only image'}
+ foreach($row in $sourceRows){if((Get-FileHash -LiteralPath (Join-Path $repo $row.Path)).Hash.ToLowerInvariant() -cne $row.Sha256){throw 'Source changed during the experimental build'}}
+ [ordered]@{Mode='experimental-dual-read-only-probe-then-windows-usb';Format='dual-probe-v1';MaxTargets=2
+  CanUnlock=$false;CanDetach=$false;WritesFirmwareVariables=$false;HardwareTested=$false
+  Experimental=$true;Defines=$defines;ProbeBusMode='auto';TargetBus=$null
+  EfiSha256=(Get-FileHash -LiteralPath "$out/BOOTX64.EFI").Hash.ToLowerInvariant();BuiltUtc=[DateTime]::UtcNow.ToString('o');Sources=$sourceRows
+ } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath "$out/manifest.json" -Encoding utf8
+ Write-Output "Built $out/BOOTX64.EFI: experimental read-only capture, not an unlock. Nothing staged or booted."
+} finally {Pop-Location}
diff --git a/research/dual/make-console-fixture.py b/research/dual/make-console-fixture.py
new file mode 100644
index 0000000000000000000000000000000000000000..0834b64fbd2881676b5e363fe95b3d8cae6224cc
--- /dev/null
+++ b/research/dual/make-console-fixture.py
@@ -0,0 +1,155 @@
+"""Build a whole, unfiltered pair graph replay header from bound private data.
+
+Addresses become ordinal handles. No firmware, GPU or boot access occurs.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import uuid
+
+REPO=Path(__file__).resolve().parents[2]
+spec=importlib.util.spec_from_file_location('pair_fixture_profile',Path(__file__).with_name('make-pair-profile.py'))
+PROFILE=importlib.util.module_from_spec(spec);spec.loader.exec_module(PROFILE)
+P=PROFILE.LEGACY
+PAIR=PROFILE.PAIR
+
+
+def require(value,message):
+    if not value: raise ValueError(message)
+
+
+def guid(value):
+    g=uuid.UUID(value)
+    return '{'+f'0x{g.time_low:x},0x{g.time_mid:x},0x{g.time_hi_version:x},'+'{'+','.join(f'0x{x:x}' for x in g.bytes[8:])+'}}'
+
+
+def one(raw,pattern,message):
+    rows=re.findall(pattern,raw,re.M)
+    require(len(rows)==1,message)
+    return rows[0]
+
+
+def build(report,root=REPO):
+    for relative,digest in report['Fixtures'].items():
+        path=root/relative
+        require(hashlib.sha256(PROFILE.regular(path)).hexdigest()==digest,'Pair fixture changed: '+relative)
+    capture=root/'research/dual/local/fixtures/console/DIAG.TXT'
+    raw=PROFILE.regular(capture);text=raw.decode('utf-8-sig').replace('\r\n','\n')
+    blocks=P.parse_handles(text);bindings=P.parse_bindings(text.splitlines())
+    indices={handle:i+1 for i,handle in enumerate(blocks)}
+    ordinal=lambda h: f'(EFI_HANDLE){indices[h]}' if h else 'NULL'
+    cards=report['Cards'];console_index=report['ConsoleCardIndex'];console=cards[console_index]
+    roles={'RtxPci':console['Graph']['PciHandle'],'Rtx':console['Graph']['GopHandles'][0]}
+    peers=set().union(*(set([card['Graph']['PciHandle'],*card['Graph']['ChildHandles']]) for card in cards if card['Index']!=console_index))
+    if console['ConsoleAggregate']:
+        topology=P.aggregate_roles(text,blocks,roles['RtxPci'],roles['Rtx'],bindings,peer_handles=peers)
+        require(topology is not None,'Captured aggregate ownership missing')
+        roles['Agg']=topology['aggregate']
+    owner=roles.get('Agg',roles['Rtx'])
+    for role,protocol,handle in [('OutAgent',P.TEXT_OUT,owner),('GfxAgent',P.GOP,owner),('NvAgent',P.PCI_IO,roles['RtxPci'])]+([] if console['NoEdidDriver'] else [('EdidAgent',P.EDID_DISCOVERED,roles['Rtx'])])+([('ComboAgent',P.GOP,roles['Rtx'])] if console['ConsoleAggregate'] else []):
+        roles[role]=P.sole_driver(blocks,handle,protocol)
+        roles[role[:-5]+'Image']=P.binding_for(bindings,roles[role])['image']
+    table=one(text,r'^console out=0x([0-9a-f]+) error=0x([0-9a-f]+) input=0x([0-9a-f]+)$','Missing console table')
+    roles.update(zip(('Console','Error','Input'),(int(value,16) for value in table)))
+    others=[h for h,b in blocks.items() if P.PCI_IO in b['protocols'] and (cfg:=P.pci_config(b['raw'])) and cfg[0]&0xffff!=0x10de and cfg[2]>>24==3]
+    require(len(others)<=1,'Too many other display controllers')
+    roles['AmdPci']=others[0] if others else None;roles['Amd']=None
+    siblings=[h for h in console['Graph']['ChildHandles'] if h!=roles['Rtx']]
+    roles['EdidChild']=siblings[0] if siblings else None
+    primary_path=P.path_of(blocks[roles['Rtx']]['raw']);layout=P.gpu_display_path(primary_path)
+    lines=['/* Private whole-pair graph fixture; actual input SHA-256 '+hashlib.sha256(raw).hexdigest()+' */',
+           f'#define FX_HANDLES {len(blocks)}',f'#define FX_PAIR_TARGET_COUNT {len(cards)}',
