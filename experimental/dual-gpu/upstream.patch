index 0000000000000000000000000000000000000000..69011f585e4dae6ca44814a9f5b5f9e79405bd48
--- /dev/null
+++ b/research/dual/test-pair-policy.ps1
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Real pair policy/SHA compiled against a hosted synthetic table; no GPU access.
+param([Parameter(Mandatory)][string]$Clang,[string]$VcVars,[string]$Output)
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+. (Join-Path $repo 'research/profile/host.ps1')
+Import-GuHostCompiler $VcVars
+if(!$Output){$Output=Join-Path $repo ('research/dual/build/policy-'+[guid]::NewGuid().ToString('N'))}
+$out=[IO.Path]::GetFullPath($Output)
+if(Test-Path -LiteralPath $out){throw 'Use a new policy-test output directory.'}
+[void][IO.Directory]::CreateDirectory($out)
+function Hash-Buffer([int]$Size,[byte]$Value) {
+    $data=New-Object byte[] $Size
+    if($Value){for($i=0;$i -lt $Size;$i++){$data[$i]=$Value}}
+    $sha=[Security.Cryptography.SHA256]::Create()
+    try{return ([BitConverter]::ToString($sha.ComputeHash($data))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()}
+}
+$prom0=Hash-Buffer 1048576 0;$prom1=Hash-Buffer 1048576 1
+$nv0=Hash-Buffer 64 0;$nv1=Hash-Buffer 64 17
+$machine=Join-Path $out 'machine-profile-host.h'
+@'
+/* Synthetic immutable hosted table only; never a firmware profile. */
+#if !defined(GU_TEST_PAIR_POLICY) || __STDC_HOSTED__ != 1
+#error Synthetic policy fixtures are forbidden in firmware
+#endif
+#define GU_PAIR_TARGET_TABLE GU_TEST_PAIR_ROWS
+'@ | Set-Content -LiteralPath $machine -Encoding ascii
+$overlay=Join-Path $out 'overlay.json'
+@{version=0;roots=@(@{type='file';name=(Join-Path $repo 'internal-boot/unlock/machine-profile.h');'external-contents'=$machine;'use-external-name'=$false})} |
+    ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $overlay -Encoding ascii
+$flags=@('-std=c11','-O1','-Wall','-Wextra','-Werror','-fshort-wchar','-D_CRT_SECURE_NO_WARNINGS',
+    '-DGU_PROFILE_LOCAL','-DGU_PROFILE_LOCAL_DUAL','-DGU_TEST_PAIR_POLICY','-ivfsoverlay',$overlay,
+    '-I',$out,'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include'),'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include/X64'))
+$results=@()
+foreach($variant in @('one','two-shared','two-distinct')) {
+    $count=if($variant -eq 'one'){1}else{2}
+    $fingerprint=if($variant -eq 'two-distinct'){$nv1}else{$nv0}
+    @("#define TEST_PROM0_SHA `"$prom0`"","#define TEST_PROM1_SHA `"$prom1`"", "#define TEST_NV0_SHA `"$nv0`"","#define TEST_NV1_SHA `"$fingerprint`"") |
+        Set-Content -LiteralPath (Join-Path $out 'pair-policy-fixture.h') -Encoding ascii
+    $extra=@('-DGU_TEST_CARD_COUNT='+$count)
+    if($variant -eq 'two-distinct'){$extra+='-DGU_TEST_DISTINCT_DRIVERS'}
+    $exe=Join-Path $out ($variant+'.exe')
+    & $Clang @flags @extra (Join-Path $repo 'internal-boot/boot/test_pair_policy.c') (Join-Path $repo 'internal-boot/unlock/sha256.c') -o $exe
+    if($LASTEXITCODE -ne 0){throw "Pair policy host compile failed: $variant"}
+    $result=@(& $exe)
+    if($LASTEXITCODE -ne 0){throw "Pair policy host test failed: $variant"}
+    $result | Write-Output
+    $results+=@{Variant=$variant;Result=($result -join "`n")}
+}
+@{SyntheticOnly=$true;HardwareAccess=$false;PhysicalQualification=$false;Results=$results} |
+    ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (Join-Path $out 'results.json') -Encoding ascii
diff --git a/research/dual/test-pair-replay.ps1 b/research/dual/test-pair-replay.ps1
