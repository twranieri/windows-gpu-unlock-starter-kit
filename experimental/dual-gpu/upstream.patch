+    lines += [f'#define {key} {value}' for key, value in values.items()]
+    state, _ = cold_lines(card)
+    lines += [f'#define GU_LOCAL_TEST_COLD_LINE {json.dumps(state)}',
+              f'#define GU_LOCAL_FWSEC_IMAGE_OFF 0x{fwsec[primary]["image_off"]:x}U',
+              f'#define GU_LOCAL_FWSEC_IMAGE_SIZE 0x{fwsec[primary]["image_size"]:x}U']
+    rows, pins, targets = [], [], []
+    for index in selected:
+        item = cards[index]
+        seg, bus, dev, fun = (int(value, 16) for value in re.split(r'[:.]', item['bdf']))
+        rows.append('{'+','.join((f'0x{item["pci_id"]}U',f'0x{item["subsystem"]}U',f'0x{item["chip"]}U',f'0x{item["memory_mib"]:x}U',json.dumps(item['prom_sha256']),json.dumps(name+'-'+str(index))))+'}')
+        pins.append('{'+f'0x{seg:x}U,0x{bus:x}U,{dev}U,{fun}U,0x{item["bar0"]:x}ULL,{int(index==console_index)}'+'}')
+        targets.append(target_row(item, graph[index], index == console_index))
+    for key, data in (('GU_CARD_TABLE', rows), ('GU_CARD_PINS', pins), ('GU_PAIR_TARGET_TABLE', targets)):
+        lines.append('#define '+key+' \\\n  '+', \\\n  '.join(data))
+    return '\n'.join(lines)+'\n'
+
+
+def generate(directory, locator, envelope):
+    directory = Path(directory)
+    diags = sorted(directory.glob('DIAG[0-9][0-9].TXT'))
+    require(len(diags) >= max(2, envelope['min_captures']), 'Need at least two complete whole-set captures from separate full shutdowns')
+    captured = [PAIR.capture(path, envelope) for path in diags]
+    cards = captured[-1]['cards']
+    require(all(row['cards'] == cards for row in captured), 'Installed cards or cold snapshots changed between captures')
+    latest_text = regular(diags[-1]).decode('utf-8-sig').replace('\r\n','\n')
+    blocks, bindings, graph = inspect_graph(latest_text, cards, directory, envelope)
+    console_index, console = console_analysis(diags[-1], cards, graph, envelope)
+    for index, meta in enumerate(graph):
+        if index == console_index:
+            continue
+        # The current peer release disconnects the exact NVIDIA owner. EDID,
+        # combo or text/graphics consumers need a different reviewed release.
+        for child in meta['children']:
+            require(all(edge[3] in (1,2,4) or (edge[1] == meta['nv_agent'] and edge[4] == 1)
+                        for edge in blocks[child]['edges']), 'Peer child has an active non-NVIDIA owner; this release route is not qualified')
+    stable = lambda rows: [(row['controller'].hex(),[p.hex() for p in row['paths']],
+                           None if row['nv'] is None else (row['nv']['version'],row['nv']['size'],row['nv']['stop']-row['nv']['base']),
+                           row['code']) for row in rows]
+    for path in diags[:-1]:
+        text = regular(path).decode('utf-8-sig').replace('\r\n','\n')
+        _, _, prior = inspect_graph(text, cards, directory, envelope)
+        previous_index, previous = console_analysis(path, cards, prior, envelope)
+        require(previous_index == console_index and stable(prior) == stable(graph) and previous['defines'] == console['defines'] and
+                previous['child_paths'] == console['child_paths'], 'Console ownership, paths or driver fingerprints changed between captures')
+    fwsec = [LEGACY.locate_fwsec(locator, directory/card['prom_file'], regular(directory/card['prom_file'], 0x100000)) for card in cards]
+    token = hashlib.sha256(json.dumps(dict(cards=cards,console=console_index,defines=console['defines']),sort_keys=True).encode()).hexdigest()[:16]
+    name = 'LOCAL-DUAL-'+token
+    header = make_header(name, console['defines'], cards, graph, console_index, fwsec)
+    outputs = {'internal-boot/unlock/profile-local-dual.h':header.encode()}
+    report_cards=[]
+    for index, (card, meta) in enumerate(zip(cards, graph)):
+        card_header = make_header(name+'-'+str(index), console['defines'], cards, graph, console_index, fwsec,host_index=index)
+        header_path=f'internal-boot/unlock/profile-local-dual-card{index}.h'
+        outputs[header_path]=card_header.encode()
+        prefix=f'research/dual/local/fixtures/cards/{index:04d}'
+        words=[f'{word:08x}' for word in card['pci_config']]
+        state, observed = cold_lines(card)
+        outputs[prefix+'/PROM.BIN']=regular(directory/card['prom_file'],0x100000)
+        outputs[prefix+'/probe/REPORT.TXT']=''.join(f'config_offset=0x{i*4:x}\nvalue=0x{word}\n' for i,word in enumerate(words)).encode()
+        outputs[prefix+'/cold/REPORT.TXT']=(''.join(f'config[{i*4:x}]={" ".join(words[i:i+4])}\n' for i in range(0,64,4))+state+'\n'+observed+'\n').encode()
+        outputs[prefix+'/config.bin']=struct.pack('<64I',*card['pci_config'])
+        report_cards.append(dict(Index=index,Bdf=card['bdf'],PciId=card['pci_id'],Subsystem=card['subsystem'],Chip=card['chip'],MemoryMiB=card['memory_mib'],
+            PromSha256=card['prom_sha256'],HeaderFile=header_path,HeaderSha256=hashlib.sha256(card_header.encode()).hexdigest(),Console=index==console_index,
+            NoEdidDriver=console['no_edid_driver'] if index==console_index else True,ConsoleAggregate=console['aggregate'] if index==console_index else False,
+            ChildCount=len(meta['paths']),ControllerPath=meta['controller'].hex(),ChildPaths=[path.hex() for path in meta['paths']],Fwsec=fwsec[index],
+            Code={'nvgop':meta['code'],'edid':console['code']['edid'] if index==console_index else None},
+            Graph=dict(PciHandle=meta['pci'],ChildHandles=meta['children'],GopHandles=meta['gops'],NvAgent=meta['nv_agent']),
+            NvgopVersion=meta['nv']['version'] if meta['nv'] else 0,NvgopImageSize=meta['nv']['size'] if meta['nv'] else 0,
+            NvgopStop=meta['nv']['stop']-meta['nv']['base'] if meta['nv'] else 0))
+    for path in diags:
+        outputs['research/dual/local/captures/'+path.name]=regular(path)
+    for path in directory.glob('IMG[0-9][0-9].BIN'):
+        outputs['research/dual/local/captures/'+path.name]=regular(path,LEGACY.IMAGE_MAX)
+    for card in cards:
+        outputs['research/dual/local/captures/'+card['prom_file']]=regular(directory/card['prom_file'],0x100000)
+    outputs['research/dual/local/fixtures/console/DIAG.TXT']=regular(diags[-1])
+    report=dict(Format=2,GeneratorVersion=2,ProfileName=name,HeaderSha256=hashlib.sha256(header.encode()).hexdigest(),HardwareTested=False,
+                ConsoleCardIndex=console_index,Cards=report_cards,Code=console['code'],
+                Captures=[dict(name=path.name,sha256=hashlib.sha256(regular(path)).hexdigest()) for path in diags],
+                Replay=console,Fixtures={path:hashlib.sha256(data).hexdigest() for path,data in outputs.items() if path.startswith('research/dual/local/')})
+    return outputs,report
+
+
+def main(argv=None):
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('captures',type=Path)
+    parser.add_argument('locator',type=Path)
+    args=parser.parse_args(argv)
+    try:
+        # A refused regeneration must not leave an earlier passing permit.
+        evidence=REPO/'research/dual/local/test-results.json'
+        evidence.unlink(missing_ok=True)
+        envelope=json.loads((REPO/'research/profile/proven.json').read_text())
+        outputs,report=generate(args.captures,args.locator,envelope)
+        for relative,data in outputs.items():
+            target=REPO/relative
+            require(not target.is_symlink(),'Indirect generated output refused')
+            target.parent.mkdir(parents=True,exist_ok=True)
+            target.write_bytes(data)
+        target=REPO/'research/dual/local/pair.json'
+        target.write_text(json.dumps(report,indent=2)+'\n')
+    except (OSError,ValueError,KeyError,TypeError,StopIteration,struct.error,subprocess.SubprocessError) as error:
+        parser.exit(2,'Pair profile refused: '+str(error)+'\n')
+    print(f'Generated exact {len(report["Cards"])}-card profile {report["ProfileName"]}; actual-input host/release evidence is still required before a write build.')
+    return 0
+
+
+if __name__=='__main__':
+    raise SystemExit(main())
diff --git a/research/dual/new-machine.ps1 b/research/dual/new-machine.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..13a30c18952cbc54d84d5480886a8731ebe9a66c
--- /dev/null
+++ b/research/dual/new-machine.ps1
@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Resumable one/two-card flow: whole-set probe -> actual-input host jobs -> USB.
+# Files only. Never partitions/formats, changes boot order, or runs a GPU unlock.
+param([Parameter(Mandatory)][ValidatePattern('^[D-Zd-z]$')][string]$Drive,
+ [Parameter(Mandatory)][guid]$WindowsEspGuid,[Parameter(Mandatory)][string]$Assets,
+ [string]$Python='python',[string]$Clang='clang',[string]$LldLink='lld-link',[string]$VcVars,[switch]$StageUnlock,[switch]$ProbeOnly)
+$ErrorActionPreference='Stop'
+
+function Test-DualDataUsb($Partition,$Disk,$Volume,[string]$SystemDrive) {
+    $letter=[string]$Partition.DriveLetter
+    return ($letter -match '^[D-Zd-z]$' -and ($letter+':') -ne $SystemDrive -and
+        [string]$Disk.BusType -eq 'USB' -and [string]$Volume.FileSystem -eq 'FAT32' -and
+        !$Partition.IsSystem -and !$Partition.IsBoot -and !$Disk.IsBoot -and !$Disk.IsSystem)
+}
+function Get-DualUsbRoot([string]$Drive) {
+    $part=Get-Partition -DriveLetter $Drive -ErrorAction Stop
+    $disk=Get-Disk -Number $part.DiskNumber -ErrorAction Stop
+    $volume=Get-Volume -DriveLetter $Drive -ErrorAction Stop
+    if(!(Test-DualDataUsb $part $disk $volume $env:SystemDrive)){throw 'Select an existing FAT32 USB data volume, never a system/boot disk.'}
+    return $Drive.ToUpperInvariant()+':\'
+}
+function Get-DualInstalledCount([string]$Repo,[switch]$ProbeOnly) {
+    $seen=@{};$count=0
+    if(!$ProbeOnly) {
+        $envelope=Get-Content -LiteralPath (Join-Path $Repo 'research/profile/proven.json') -Raw | ConvertFrom-Json
+        $allowed=@($envelope.probe_device_ids)
+        if(!$allowed.Count -or @($allowed | Where-Object {$_ -isnot [string] -or $_ -cnotmatch '^[0-9a-f]{4}10de$'}).Count -or
+           @($allowed | Sort-Object -Unique).Count -ne $allowed.Count){throw 'Invalid installed PCI candidate envelope.'}
+        $subsystems=$envelope.probe_subsystems
+        if($null -ne $subsystems -and $subsystems -isnot [pscustomobject]){throw 'Invalid installed PCI subsystem envelope.'}
+    }
+    foreach($row in @(Get-CimInstance -ClassName Win32_VideoController -Property Name,PNPDeviceID -ErrorAction Stop)) {
+        $pnp=[string]$row.PNPDeviceID;$match=[regex]::Match($pnp,'(?i)^PCI\\VEN_([0-9a-f]{4})&DEV_([0-9a-f]{4})(?=&|\\|$)')
+        if($match.Success -and $match.Groups[1].Value -ieq '10de') {
+            $id=$match.Groups[2].Value.ToLowerInvariant()+'10de'
+            if($seen.ContainsKey($pnp)){throw 'Every installed NVIDIA card must have a unique PCI instance.'}
+            if(!$ProbeOnly) {
+                if($allowed -cnotcontains $id){throw "PCI $id is outside the reviewed envelope. Use -ProbeOnly for read-only diagnostics."}
+                $rule=if($null -ne $subsystems){$subsystems.PSObject.Properties[$id]}
+                if($null -ne $rule) {
+                    $reviewed=@($rule.Value)
+                    if(!$reviewed.Count -or @($reviewed | Where-Object {$_ -isnot [string] -or $_ -cnotmatch '^[0-9a-f]{8}$'}).Count){throw 'Invalid installed PCI subsystem envelope.'}
+                    $observed=[regex]::Matches($pnp,'(?i)&SUBSYS_([0-9a-f]{8})(?=&|\\|$)')
+                    if($observed.Count -ne 1 -or $reviewed -cnotcontains $observed[0].Groups[1].Value.ToLowerInvariant()){
+                        throw "PCI $id requires a reviewed subsystem. Use -ProbeOnly for read-only diagnostics."
+                    }
+                }
+            }
+            $seen[$pnp]=$true;$count++
+        } elseif([string]$row.Name -match '(?i)NVIDIA' -or $pnp -match '(?i)^PCI\\VEN_10DE'){throw 'An NVIDIA PCI identity could not be established.'}
+    }
+    if($count -lt 1 -or $count -gt 2){throw 'This route requires one or two installed candidate NVIDIA cards.'}
+    return $count
+}
+function Get-DualWholeCaptures([string]$Directory,[int]$TargetCount) {
+    foreach($file in @(Get-ChildItem -LiteralPath $Directory -Filter 'DIAG??.TXT' -File -ErrorAction SilentlyContinue)) {
+        if($file.Name -cnotmatch '^DIAG[0-9]{2}\.TXT$' -or $file.Length -gt 8MB -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)){continue}
+        $text=[IO.File]::ReadAllText($file.FullName).Replace("`r`n","`n")
+        if([regex]::IsMatch($text,'(?im)^[ \t]*probe-capture-only')){continue}
+        $summary=@([regex]::Matches($text,'(?m)^probe targets=([0-9a-f]{4}) cfg-incomplete=0000$'))
+        $parts=@([regex]::Matches($text,'(?ms)^dual-card-begin index=([0-9a-f]{4})\n(.*?)^dual-card-end index=\1\n'))
+        if(@([regex]::Matches($text,'(?m)^dual-probe-v1 max-targets=2 readonly=1$')).Count -ne 1 -or
+           @([regex]::Matches($text,'(?m)^capture-complete=.*$')).Count -ne 1 -or
+           @([regex]::Matches($text,'(?m)^capture-complete=1$')).Count -ne 1 -or
+           @([regex]::Matches($text,'(?m)^diagnostic-result status=.*$')).Count -ne 1 -or
+           @([regex]::Matches($text,'(?m)^diagnostic-result status=0x0000000000000000$')).Count -ne 1 -or
+           [regex]::IsMatch($text,'(?m)^incomplete(?:\s|$)') -or $summary.Count -ne 1 -or
+           [Convert]::ToInt32($summary[0].Groups[1].Value,16) -ne $TargetCount -or $parts.Count -ne $TargetCount -or
+           @([regex]::Matches($text,'(?m)^dual-card-(?:begin|end)')).Count -ne 2*$TargetCount){continue}
+        $valid=$true
+        for($index=0;$index -lt $parts.Count;$index++) {
+            if($parts[$index].Groups[1].Value -cne ('{0:x4}' -f $index) -or @([regex]::Matches($parts[$index].Groups[2].Value,'(?m)^probe-target ')).Count -ne 1){$valid=$false}
+        }
+        if($valid){$file}
+    }
+}
+function Assert-DualProbeManifest([string]$Repo,$Manifest,[string]$Efi) {
+    foreach($name in @('CanUnlock','CanDetach','WritesFirmwareVariables','HardwareTested')) {
+        if($Manifest.$name -isnot [bool] -or $Manifest.$name){throw 'Probe is not strictly read-only.'}
+    }
+    if($Manifest.Mode -cne 'experimental-dual-read-only-probe-then-windows-usb' -or $Manifest.Format -cne 'dual-probe-v1' -or
+       !(Test-GuExactInteger $Manifest.MaxTargets 2) -or $Manifest.Experimental -isnot [bool] -or !$Manifest.Experimental -or
+       $Manifest.ProbeBusMode -cne 'auto' -or $null -ne $Manifest.TargetBus){throw 'Wrong whole-set probe contract.'}
+    $defines=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_USB_PROBE','-DGU_PROBE_PARENT_BASELINE','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2')
+    if(@($Manifest.Defines).Count -ne $defines.Count){throw 'Incomplete probe defines.'}
+    foreach($define in $defines){if(@($Manifest.Defines | Where-Object {$_ -ceq $define}).Count -ne 1){throw 'Wrong probe define set.'}}
+    $expected=@(Get-GuGenericProbeFiles)+@('research/dual/build-probe.ps1')
+    if(@($Manifest.Sources).Count -ne $expected.Count){throw 'Incomplete probe source binding.'}
+    foreach($relative in $expected) {
+        $row=@($Manifest.Sources | Where-Object {$_.Path -ceq $relative})
+        if($row.Count -ne 1 -or $row[0].Sha256 -cnotmatch '^[0-9a-f]{64}$' -or (Get-GuSha256 (Join-Path $Repo $relative)) -cne $row[0].Sha256){throw 'Probe source changed.'}
+    }
+    if($Manifest.EfiSha256 -cnotmatch '^[0-9a-f]{64}$' -or (Get-GuSha256 $Efi) -cne $Manifest.EfiSha256){throw 'Probe EFI hash mismatch.'}
+}
+function Assert-DualChildPath([string]$Parent,[string]$Child) {
+    $root=[IO.Path]::GetFullPath($Parent).TrimEnd('\','/')+[IO.Path]::DirectorySeparatorChar
+    $path=[IO.Path]::GetFullPath($Child)
+    if(!$path.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)){throw 'Local capture/archive path escaped its intended parent.'}
+    if((Test-Path -LiteralPath $path) -and ((Get-Item -LiteralPath $path -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Indirect capture/archive path refused.'}
+}
+function Publish-DualProbe([string]$Repo,[string]$Usb,[string]$Directory,[guid]$WindowsEspGuid,[string]$Python,[string]$Clang,[string]$LldLink) {
+    & (Join-Path $Repo 'research/dual/build-probe.ps1') -WindowsEspGuid $WindowsEspGuid -Clang $Clang -LldLink $LldLink -Python $Python -ExperimentalDual -MaxTargets 2
+    if(!$?){throw 'Whole-set read-only probe build failed.'}
+    $built=Join-Path $Repo 'internal-boot/boot/build/probe-dual-experimental'
+    $manifest=Get-Content -LiteralPath (Join-Path $built 'manifest.json') -Raw | ConvertFrom-Json
+    $efi=Join-Path $built 'BOOTX64.EFI';Assert-DualProbeManifest $Repo $manifest $efi
+    $bootFile=Join-Path $Usb 'EFI/BOOT/BOOTX64.EFI'
+    $current=if(Test-Path -LiteralPath $bootFile){Get-GuSha256 $bootFile}else{''}
+    if($current -ceq $manifest.EfiSha256){return}
+    [void][IO.Directory]::CreateDirectory($Directory)
+    if($current) {
+        $backup=Join-Path $Directory ('backup/BOOTX64-'+$current.Substring(0,12)+'.EFI')
+        Assert-DualChildPath $Directory $backup
+        if(!(Test-Path -LiteralPath $backup)){[void][IO.Directory]::CreateDirectory((Split-Path $backup));Copy-Item -LiteralPath $bootFile -Destination $backup}
+    }
+    $old=@(Get-ChildItem -LiteralPath $Directory -File | Where-Object {$_.Name -cmatch '^(DIAG[0-9]{2}\.TXT|IMG[0-9]{2}\.BIN|PROM(?:[0-9]{2})?\.BIN)$'})
+    if($old.Count) {
+        $archive=Join-Path $Directory ('old-'+[guid]::NewGuid().ToString('N'));Assert-DualChildPath $Directory $archive
+        [void][IO.Directory]::CreateDirectory($archive)
+        foreach($file in $old){Assert-DualChildPath $Directory $file.FullName;Move-Item -LiteralPath $file.FullName -Destination (Join-Path $archive $file.Name)}
+    }
+    Assert-DualProbeManifest $Repo $manifest $efi
+    [void][IO.Directory]::CreateDirectory((Split-Path $bootFile));Copy-Item -LiteralPath $efi -Destination $bootFile -Force
+    if((Get-GuSha256 $bootFile) -cne $manifest.EfiSha256){throw 'Whole-set probe copy verification failed.'}
+}
+function Invoke-DualNewMachine([string]$Drive,[guid]$WindowsEspGuid,[string]$Assets,[string]$Python,[string]$Clang,[string]$LldLink,[string]$VcVars,[bool]$StageUnlock,[bool]$ProbeOnly=$false) {
+    if($ProbeOnly -and $StageUnlock){throw '-ProbeOnly cannot be combined with -StageUnlock.'}
+    $repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+    . (Join-Path $repo 'internal-boot/unlock/local-profile.ps1')
+    . (Join-Path $repo 'research/profile/host.ps1')
+    . (Join-Path $repo 'research/profile/probe-manifest.ps1')
+    $usb=Get-DualUsbRoot $Drive;$targetCount=Get-DualInstalledCount $repo -ProbeOnly:$ProbeOnly
+    $directory=Join-Path $usb 'RTX3090-UNLOCK'
+    $captures=@(Get-DualWholeCaptures $directory $targetCount)
+    if($ProbeOnly -or $captures.Count -lt 2) {
+        Publish-DualProbe $repo $usb $directory $WindowsEspGuid $Python $Clang $LldLink
+        $have=@(Get-DualWholeCaptures $directory $targetCount).Count
+        Write-Host ("Read-only whole-set probe staged: $have/2 complete boots for $targetCount card(s).")
+        if($ProbeOnly -and $have -ge 2) {
+            Write-Host 'Existing complete files were preserved. Probe-only mode completed without building an unlock.'
+        } else {
+            Write-Host 'Fully shut down, boot the USB, and review the diagnostic result after Windows returns. Building requires two separate complete cold captures.'
+        }
+        return
+    }
+    $private=Join-Path $repo 'research/dual/local';$capture=Join-Path $private 'captures'
+    if(Test-Path -LiteralPath $capture) {
+        Assert-DualChildPath $private $capture
+        $archive=Join-Path $private ('captures-archive-'+[guid]::NewGuid().ToString('N'));Assert-DualChildPath $private $archive
+        Move-Item -LiteralPath $capture -Destination $archive
+    }
+    [void][IO.Directory]::CreateDirectory($capture)
+    foreach($file in $captures){Assert-DualChildPath $directory $file.FullName;Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $capture $file.Name)}
+    foreach($file in @(Get-ChildItem -LiteralPath $directory -File | Where-Object {$_.Name -cmatch '^(IMG[0-9]{2}\.BIN|PROM[0-9]{2}\.BIN)$'})) {
+        Assert-DualChildPath $directory $file.FullName;Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $capture $file.Name)
+    }
+    Import-GuHostCompiler $VcVars
+    $locator=Build-GuFwsecLocate $repo $Clang
+    & $Python -I (Join-Path $PSScriptRoot 'make-pair-profile.py') $capture $locator
+    if($LASTEXITCODE -ne 0){throw 'Whole-set profile generation refused; no write build/staging was attempted.'}
+    & (Join-Path $PSScriptRoot 'test-profile.ps1') -Assets $Assets -Clang $Clang -Python $Python -VcVars $VcVars
+    if(!$?){throw 'Actual per-card/pair host tests failed.'}
+    $null=Assert-DualProfileEvidence $repo
+    & (Join-Path $repo 'research/headless/build-usb.ps1') -WindowsEspGuid $WindowsEspGuid -HardwareProfile local-dual -Clang $Clang -LldLink $LldLink -Python $Python
+    if(!$?){throw 'Evidence-gated one/two-card package build failed.'}
+    if(!$StageUnlock){Write-Host 'Actual-input host tests passed and the exact one/two-card package is built. StageUnlock remains a separate explicit step.';return}
+    $null=Assert-DualProfileEvidence $repo
+    & (Join-Path $repo 'research/headless/stage-usb.ps1') -Drive $Drive -Assets $Assets
+    if(!$?){throw 'Exact one/two-card package staging failed.'}
+}
+if($MyInvocation.InvocationName -ne '.') {Invoke-DualNewMachine $Drive $WindowsEspGuid $Assets $Python $Clang $LldLink $VcVars ([bool]$StageUnlock) ([bool]$ProbeOnly)}
diff --git a/research/dual/test-efi-controls.ps1 b/research/dual/test-efi-controls.ps1
