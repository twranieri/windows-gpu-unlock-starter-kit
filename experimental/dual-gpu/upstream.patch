+  UINTN keep=0;
+  for(UINTN j=0;j<ChildCounts[row];j++)if(Children[row][j] && Children[row][j]!=FX_Console && Children[row][j]!=FX_Error)Dead[(UINTN)Children[row][j]]=TRUE;
+  for(UINTN i=0;i<Live.Count;i++) {
+   EDGE *e=&Live.Edges[i];BOOLEAN remove=e->Handle==h && e->Agent==agent;
+   for(UINTN j=0;j<ChildCounts[row];j++)if(e->Handle==Children[row][j])remove=TRUE;
+#if GU_CONSOLE_AGGREGATE
+   if(GuPairTargets[row].Console && (e->Handle==FX_Agg || (e->Agent==FX_ComboAgent && e->Handle!=h)))remove=TRUE;
+#endif
+   if(!remove)Live.Edges[keep++]=*e;
+  }Live.Count=keep;
+  for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==h){Configs[i][1]&=~3U;Attrs[i]&=~0x300ULL;}
+  /* The aggregate's zero-FB GOP can disappear with its physical child. */
+#ifdef FX_Agg
+  if(GuPairTargets[row].Console && (UINTN)FX_Agg<=FX_HANDLES)for(UINTN i=0;i<N(Gops);i++)if(FixtureGops[i].Handle==FX_Agg)GopModes[i].FrameBufferBase=GopModes[i].FrameBufferSize=0;
+#endif
+  return EFI_SUCCESS;
+ }
+ if(agent==FX_GfxAgent)TextGone[(UINTN)h]=TRUE;
+ UINTN n=0,removed=0;for(UINTN i=0;i<Live.Count;i++){EDGE *e=&Live.Edges[i];if(e->Handle==h && e->Agent==agent)removed++;else Live.Edges[n++]=*e;}Live.Count=n;
