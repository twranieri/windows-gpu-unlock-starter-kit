+"""Synthetic-only regression for the production pair write-build gate; no GPU IO."""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[2]
+SHELL = shutil.which('pwsh') or shutil.which('powershell')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+@unittest.skipUnless(SHELL, 'PowerShell required')
+class PairEvidence(unittest.TestCase):
+    def test_exact_inputs_and_job_cardinality(self):
+        with tempfile.TemporaryDirectory(prefix='gu-dual-evidence-') as temp:
+            root = Path(temp)
+            def put(name, value):
+                path = root / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text(value, encoding='utf-8')
+                return path
+            report = {'Format': 2, 'GeneratorVersion': 2,
+                      'ProfileName': 'LOCAL-DUAL-0123456789abcdef',
+                      'HardwareTested': False, 'ConsoleCardIndex': 0,
+                      'Cards': [], 'Fixtures': {}, 'Captures': []}
+            header = put('internal-boot/unlock/profile-local-dual.h',
+                         '#define GU_LOCAL_PAIR_GENERATOR 2\n#define GU_PAIR_TARGET_COUNT 2U\n'
+                         '#define GU_PROFILE_NAME "LOCAL-DUAL-0123456789abcdef"\n')
+            report['HeaderSha256'] = sha(header)
+            for index in range(2):
+                card_header = f'internal-boot/unlock/profile-local-dual-card{index}.h'
+                ch = put(card_header, f'/* synthetic card {index} */\n')
+                for suffix in ('PROM.BIN', 'probe/REPORT.TXT', 'cold/REPORT.TXT'):
+                    name = f'research/dual/local/fixtures/cards/{index:04d}/{suffix}'
+                    path = put(name, f'explicitly synthetic {index} {suffix}\n')
+                    report['Fixtures'][name] = sha(path)
+                report['Cards'].append({'Index': index, 'Bdf': f'00000000:0{index+1}:00.0',
+                    'PciId': '220410de' if index == 0 else '250410de',
+                    'Subsystem': '000110de', 'Chip': 'b72000a1', 'MemoryMiB': 24576,
+                    'PromSha256': report['Fixtures'][f'research/dual/local/fixtures/cards/{index:04d}/PROM.BIN'],
+                    'HeaderSha256': sha(ch), 'HeaderFile': card_header,
+                    'Console': index == 0, 'NoEdidDriver': True,
+                    'ConsoleAggregate': False, 'ChildCount': 1 if index == 0 else 0})
+            graph = 'research/dual/local/fixtures/console/DIAG.TXT'
+            report['Fixtures'][graph] = sha(put(graph, 'synthetic whole graph\n'))
+            put('research/dual/local/pair.json', json.dumps(report))
+            put('synthetic-source.c', '/* source fixture */\n')
+            gate = REPO / 'internal-boot/unlock/local-profile.ps1'
+            script = r'''
+param($Repo,$Gate)
+$ErrorActionPreference='Stop'
+. $Gate
+# Only the source inventory is adapted to this tiny synthetic repository. All
+# report, fixture, evidence and job validation below executes production code.
+function Get-LocalTreeInputs($Repo) {
+ [pscustomobject]@{Path='synthetic-source.c';Sha256=(Get-GuSha256 (Join-Path $Repo 'synthetic-source.c'))}
+}
+function SaveJson($Value,$Path){$Value|ConvertTo-Json -Depth 30|Set-Content -LiteralPath $Path -Encoding utf8}
+function Refused([scriptblock]$Action){$failed=$false;try{&$Action|Out-Null}catch{$failed=$true};if(!$failed){throw 'Expected refusal'}}
+$hw=Get-DualProfile $Repo
+$inputs=@(Get-DualTreeInputs $Repo)
+$e=[ordered]@{Format=3;ProfileName=$hw.Name;HeaderSha256=$hw.HeaderSha256;ProfileReportSha256=(Get-GuSha256 (Join-Path $Repo 'research/dual/local/pair.json'));AllPassed=$true;HardwareAccess=$false;Inputs=$inputs;TreeSha256=(Get-LocalInputDigest $inputs);Cards=@();PairResults=[ordered]@{}}
+function SyntheticJob([int]$Code){return [ordered]@{Exit=$Code;Expected=$Code;Kind='compiled';Adapter='synthetic-source.c';Command=@('synthetic.exe');CompileCommand=@('synthetic-clang',(Join-Path $Repo 'synthetic-source.c'));CompileExit=0}}
+foreach($card in $hw.Report.Cards){
+ $jobs=Get-DualExpectedJobs $card.Console $card.NoEdidDriver $card.ConsoleAggregate
+ if($jobs.Count -ne $(if($card.Console){22}else{11})){throw 'Wrong applicable job cardinality'}
+ $results=[ordered]@{};foreach($name in $jobs.Keys){$results[$name]=SyntheticJob $jobs[$name]}
+ $e.Cards+=@{Index=$card.Index;Results=$results}
+}
+foreach($name in (Get-DualExpectedPairJobs).Keys){$e.PairResults[$name]=SyntheticJob 0}
+$out=Join-Path $Repo 'research/dual/local/test-results.json'
+SaveJson $e $out
+$original=[IO.File]::ReadAllText($out)
+Assert-DualProfileEvidence $Repo|Out-Null
+$checks=1
+foreach($mutate in @(
+ {param($x)$x.Cards[1].Results.PSObject.Properties.Remove('port')},
+ {param($x)$x.Cards[1].Results.port.Exit=1},
+ {param($x)$x.Cards[1].Index=0},
+ {param($x)$x.Cards+=@($x.Cards[1])},
+ {param($x)$x.PairResults.PSObject.Properties.Remove('pair wrapper replay (real graph)')},
+ {param($x)$x.AllPassed='true'},
+ {param($x)$x.HardwareAccess=$true},
+ {param($x)$x.Inputs[0].Sha256=('0'*64)},
+ {param($x)$x.ProfileName='ASUS-TUF-GAMING-B660M-E-D4-4003-DUAL-RTX'},
+ {param($x)$x.Cards[0].Results.port.Kind='fake'},
+ {param($x)$x.Cards[0].Results.port.Adapter='unbound.py'},
+ {param($x)$x.Cards[0].Results.port.Command='synthetic.exe'},
+ {param($x)$x.Cards[0].Results.port.CompileExit=1},
+ {param($x)$x.Cards[0].Results.port.CompileCommand=@('clang','another.c')},
+ {param($x)$x.Cards[0].Results.port.Kind='interpreted'},
+ {param($x)$x.Format=2}
+)) {
+ $bad=$original|ConvertFrom-Json;&$mutate $bad;SaveJson $bad $out
+ Refused {Assert-DualProfileEvidence $Repo};$checks++
+}
+[IO.File]::WriteAllText($out,$original)
+$fixture=Join-Path $Repo 'research/dual/local/fixtures/cards/0001/PROM.BIN'
+[IO.File]::AppendAllText($fixture,'changed')
+Refused {Assert-DualProfileEvidence $Repo};$checks++
+'PASS '+$checks+' synthetic gate cases: complete evidence and fail-closed mutations'
+'''
+            runner = put('test-gate.ps1', script)
+            result = subprocess.run([SHELL, '-NoProfile', '-File', str(runner), str(root), str(gate)],
+                                    text=True, capture_output=True, timeout=45)
