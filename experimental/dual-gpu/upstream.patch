+"""Refusal regressions against this machine's exact captured pair, in scratch RAM/files.
+
+Runs the real generator and production FWSEC parser; never writes a profile or
+passing build evidence, and never calls firmware, GPU or USB services.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import shutil
+import tempfile
+
+HERE=Path(__file__).resolve().parent
+spec=importlib.util.spec_from_file_location('actual_pair_refusals',HERE/'make-pair-profile.py')
+M=importlib.util.module_from_spec(spec);spec.loader.exec_module(M)
+
+
+def digest_inputs(folder):
+    return {p.name:hashlib.sha256(M.regular(p,M.LEGACY.IMAGE_MAX)).hexdigest()
+            for p in folder.iterdir() if p.is_file()}
+
+
+def replace_once(text,pattern,replacement):
+    changed,count=re.subn(pattern,replacement,text,count=1,flags=re.M)
+    if count!=1 or changed==text:raise ValueError('Refusal fixture mutation did not apply')
+    return changed
+
+
+def cfg_word(text,index,value):
+    def replace(match):
+        words=match[1].split();words[index]=f'{value(int(words[index],16)):08x}'
+        return 'cfg dwords='+' '.join(words)
+    return replace_once(text,r'^cfg dwords=([0-9a-f ]+)$',replace)
+
+
+def run(captures,locator):
+    captures=captures.resolve();locator=locator.resolve()
+    before=digest_inputs(captures)
+    envelope=json.loads((M.REPO/'research/profile/proven.json').read_text())
+    _,report=M.generate(captures,locator,envelope) # actual accepted inputs, not a stub
+    latest=sorted(captures.glob('DIAG[0-9][0-9].TXT'))[-1].name
+    expected_count=len(report['Cards'])
+    controls=[
+        ('missing complete marker',lambda t:replace_once(t,r'^capture-complete=1$','capture-complete=0')),
+        ('failed diagnostic result',lambda t:replace_once(t,r'^diagnostic-result status=0x0{16}$','diagnostic-result status=0x8000000000000007')),
+        ('unreviewed source format',lambda t:replace_once(t,r'^dual-probe-v1 max-targets=2 readonly=1$','dual-probe-v1 max-targets=3 readonly=1')),
+        ('wrong whole-set count',lambda t:replace_once(t,r'^probe targets=[0-9a-f]{4}',f'probe targets={3:04x}')),
+        ('incomplete PCI capture',lambda t:replace_once(t,r'cfg-incomplete=0000','cfg-incomplete=0001')),
+        ('unclosed card section',lambda t:replace_once(t,r'^dual-card-end index=0000$','dual-card-end index=000f')),
+        ('unsupported PCI identity',lambda t:cfg_word(t,0,lambda _:0x220610de)),
+        ('bus master enabled',lambda t:cfg_word(t,1,lambda v:v|4)),
+        ('memory decode disabled',lambda t:cfg_word(t,1,lambda v:v&~2)),
+        ('missing subsystem',lambda t:cfg_word(t,11,lambda _:0)),
+        ('unreviewed class/revision',lambda t:cfg_word(t,2,lambda v:v^1)),
+        ('changed BAR',lambda t:cfg_word(t,4,lambda v:v^0x1000000)),
+        ('invalid BAR resource',lambda t:replace_once(t,r'^pci-bar0-resource raw=[0-9a-f]+$','pci-bar0-resource raw=00')),
+        ('missing cold MMIO',lambda t:replace_once(t,r'^mmio off=0x00000000 .*\n','')),
+        ('wrong PROM association',lambda t:replace_once(t,r'^prom dump=PROM00.BIN$','prom dump=PROM09.BIN')),
+        ('cold selector already final',lambda t:replace_once(t,r'^(mmio off=0x0082381c status=0x0{16} value=0x)[0-9a-f]{8}$',r'\g<1>88888888')),
+    ]
+    checks=0
+    with tempfile.TemporaryDirectory(prefix='gu-actual-pair-refusals-') as scratch:
+        work=Path(scratch)/'capture';shutil.copytree(captures,work,symlinks=False)
+        original=M.regular(work/latest).decode('utf-8-sig').replace('\r\n','\n')
+        for name,mutate in controls:
+            path=work/latest;path.write_text(mutate(original),encoding='utf-8')
+            try:
+                try:M.generate(work,locator,envelope)
+                except (ValueError,KeyError,TypeError,StopIteration):pass
+                else:raise ValueError('Generator accepted refusal control: '+name)
+                checks+=1
+            finally:path.write_text(original,encoding='utf-8')
+        for index in range(expected_count):
+            prom=work/f'PROM{index:02d}.BIN';raw=M.regular(prom);prom.write_bytes(raw[:-1])
+            try:
+                try:M.generate(work,locator,envelope)
+                except (ValueError,KeyError,TypeError,StopIteration):pass
+                else:raise ValueError('Generator accepted truncated card PROM')
+                checks+=1
+            finally:prom.write_bytes(raw)
+        # Missing second independent boot must never qualify either cardinality.
+        for path in sorted(work.glob('DIAG[0-9][0-9].TXT'))[1:]:path.unlink()
+        try:M.generate(work,locator,envelope)
+        except ValueError:checks+=1
+        else:raise ValueError('Generator accepted only one cold capture')
+    if digest_inputs(captures)!=before:raise ValueError('Original private inputs changed during refusal tests')
+    print(f'PASS {checks} actual-input pair generator refusal controls; {expected_count} captured card(s); no hardware access or evidence written')
+    return checks
+
+
+def main(argv=None):
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('captures',type=Path);parser.add_argument('locator',type=Path)
+    args=parser.parse_args(argv)
+    try:run(args.captures,args.locator)
+    except (OSError,ValueError,KeyError,TypeError,StopIteration) as error:parser.exit(1,'Actual-input pair generator controls failed: '+str(error)+'\n')
+    return 0
+
+
+if __name__=='__main__':raise SystemExit(main())
