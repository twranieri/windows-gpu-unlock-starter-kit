+$badFlags=@($flags);$includeIndex=[Array]::IndexOf($badFlags,$bridge);if($includeIndex -lt 0){throw 'Missing fixture include argument'};$badFlags[$includeIndex]=$badBridge
+$badExe=Join-Path $build 'pair-wrong-profile.exe'
+$badCompileCommand=@($Clang)+$badFlags+@((Join-Path $PSScriptRoot 'test_pair_replay.c'),(Join-Path $repo 'internal-boot/unlock/checks.c'),(Join-Path $repo 'internal-boot/unlock/sha256.c'),(Join-Path $repo 'internal-boot/boot/full-flow.c'),'-o',$badExe)
+& $badCompileCommand[0] @($badCompileCommand|Select-Object -Skip 1)
+if($LASTEXITCODE -ne 0){throw 'Wrong-profile runtime test could not compile'}
+$ErrorActionPreference='Continue';$lines=& $badExe $repo wrong-profile 2>&1|ForEach-Object {"$_"};$code=$LASTEXITCODE;$ErrorActionPreference='Stop'
+$lines|ForEach-Object {Write-Host $_}
+if($code -ne 1){throw 'Wrong immutable console profile was not refused with the full captured pair installed'}
+$consoleResults['pair console wrong profile (must reject)']=[ordered]@{Exit=$code;Expected=1;Last=($lines|Select-Object -Last 1);Kind='compiled';Adapter='research/dual/test_pair_replay.c';Command=@($badExe,$repo,'wrong-profile');CompileCommand=$badCompileCommand;CompileExit=0}
+$now=Get-DualProfile $repo;$after=@(Get-DualTreeInputs $repo)
+if($now.HeaderSha256 -cne $hw.HeaderSha256 -or (Get-GuSha256 $Profile) -cne $reportSha -or
+   (Get-LocalInputDigest $after) -cne $tree){throw 'Pair inputs changed while replaying; rerun after generation/source changes finish'}
+[ordered]@{Format=1;ProfileName=$hw.Name;HeaderSha256=$hw.HeaderSha256;ProfileReportSha256=$reportSha;
+ HardwareAccess=$false;PhysicalQualification=$false;Inputs=$inputs;TreeSha256=$tree;Results=$results;ConsoleResults=$consoleResults;
+ TestedUtc=[DateTime]::UtcNow.ToString('o')}|ConvertTo-Json -Depth 12|Set-Content -LiteralPath $Output -Encoding utf8
+Write-Host ('Actual whole-pair RAM replay passed; evidence '+$Output+'; no physical two-GPU qualification.')
