+# GPL-2.0-only. Host RAM mocks only; no EFI is started and no GPU is accessed.
+param([Parameter(Mandatory)][string]$Clang,[string]$VcVars)
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../../..'))
+. (Join-Path $repo 'research/profile/host.ps1')
+Import-GuHostCompiler $VcVars
+$out=Join-Path $repo 'research/profile/build/dual-core-hardening'
+[void][IO.Directory]::CreateDirectory($out)
+$includes=@('-I',(Join-Path $repo 'deps/edk2/MdePkg/Include'),'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include/X64'))
+$flags=@('-std=c11','-O1','-Wall','-Wextra','-Werror','-D_CRT_SECURE_NO_WARNINGS')+$includes
+foreach($variant in @('normal','mixed','ambiguous','pins','identical-pins','prepared-pins')) {
+  $extra=@(switch($variant) {
+    'ambiguous' {@('-DGU_TEST_AMBIGUOUS_TABLE','-Wno-unused-function')}
+    'pins' {@('-DGU_TEST_CAPTURE_PINS','-Wno-unused-function')}
+    'identical-pins' {@('-DGU_TEST_CAPTURE_PINS','-DGU_TEST_IDENTICAL_TABLE','-Wno-unused-function')}
+    'prepared-pins' {@('-DGU_TEST_CAPTURE_PINS','-DGU_TEST_CAPTURED_CONSOLE','-Wno-unused-function')}
+    default {@('-Wno-unused-function')}
+  })
+  $exe=Join-Path $out ('registry-'+$variant+'.exe')
+  $profile=@(if($variant -eq 'mixed'){'-DGU_PROFILE_B660M_DUAL';'-DGU_UEFI_PORT'}else{'-DGU_PROFILE_B660M_DUAL_3090TI'})
+  & $Clang @flags @profile @extra (Join-Path $PSScriptRoot 'test_target_registry.c') -o $exe
+  if($LASTEXITCODE -ne 0){throw "Host compile failed: $variant"}
+  & $exe
+  if($LASTEXITCODE -ne 0){throw "Host test failed: $variant"}
+}
+$unlock=Join-Path $repo 'internal-boot/unlock'
+& $Clang -target x86_64-pc-windows-msvc -std=c11 -ffreestanding -fno-builtin -fno-stack-protector -mno-red-zone -fshort-wchar -Os -Wall -Wextra -Werror -D__KERNEL__ -DGU_UEFI_PORT -DGU_PROFILE_B660M_DUAL_3090TI -DGU_EXPERIMENTAL_3090 -DGU_ENTRY_LATCHED_SS1_FULL -DGU_INTERNAL_BOOT -DGU_AUTOMATIC_BOOT -DGU_HEADLESS_RESEARCH -DGU_USB_MEDIA @includes -I (Join-Path $unlock 'compat') -c (Join-Path $unlock 'app.c') -o (Join-Path $out 'app-compile-only.obj')
+if($LASTEXITCODE -ne 0){throw 'Production app compile failed'}
+'PASS: RAM-only registry/coordinator cases and production app compile; no physical compatibility claim.'
