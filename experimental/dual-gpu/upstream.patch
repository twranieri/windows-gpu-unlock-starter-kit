+ } else if(!strcmp(argv[2],"prepare")) {
+  Fault=0;Setup();Check(GuPrepareConsole(&Table,Log,NULL)==EFI_SUCCESS,"prepare complete unfiltered captured pair");
+  Check(GuVerifyPreparedConsole(&Table)==EFI_SUCCESS,"fresh prepared console verifies");Check(!Writes,"console prepare never changes PCI decode");
+  Setup();for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==PciHandles[0])Configs[i][11]^=1;
+  Check(GuPrepareConsole(&Table,Log,NULL)!=EFI_SUCCESS && !Stops && !Writes,"prepare checks every target identity before detach");
+ } else if(!strcmp(argv[2],"release")) {
+  Fault=0;Setup();Check(GuPrepareConsole(&Table,Log,NULL)==EFI_SUCCESS,"prepare actual full pair before release");
+  Check(GuReleaseGop(&Table,H(FX_HANDLES+1),Log,NULL)==EFI_SUCCESS,"full production console release on actual wholegraph");
+  Check(GuVerifyReleased(&Table,TRUE)==EFI_SUCCESS,"released graph preserves cold complete pair");
+  ColdValues[0][0]^=1;Check(GuVerifyReleased(&Table,TRUE)!=EFI_SUCCESS,"late peer chip drift blocks release handoff");ColdValues[0][0]^=1;
+  Check(UnlockFlow(NULL)==EFI_SUCCESS,"simulate successful per-card completion only in RAM");
+  EFI_STATUS final=GuVerifyReleased(&Table,FALSE);if(final!=EFI_SUCCESS){const GU_VERIFY_DIAGNOSTIC *d=GuLastVerifyDiagnostic();fprintf(stderr,"pair final stage=%s status=%llx\n",d->Stage,(unsigned long long)final);}
+  Check(final==EFI_SUCCESS,"actual full graph final verification requires both completed targets");
+  ColdValues[GU_PAIR_COUNT-1][7]=6;Check(GuVerifyReleased(&Table,FALSE)!=EFI_SUCCESS,"second target final selector failure blocks handoff");
+ } else if(!strcmp(argv[2],"wrapper")) {
+  for(Fault=0;Fault<=7;Fault++) {
+   Setup();UINTN peer=GU_PAIR_COUNT==2?1-FX_PAIR_CONSOLE_INDEX:0;
+   if(Fault==1)for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==H(PciHandles[peer]))Configs[i][11]^=1;
+   if(Fault==2)ColdValues[peer][0]^=1;
+   if(Fault==3)PromBytes[peer][0]^=1;
+   if(Fault==4)for(UINTN i=0;i<N(Paths);i++)if(Paths[i].Handle==H(PciHandles[peer]))Paths[i].Data[4]^=1;
+   if(Fault==5){if(NvAgents[peer]){for(UINTN i=0;i<Live.Count;i++)if(Live.Edges[i].Handle==H(PciHandles[peer]) && Live.Edges[i].Attributes==EFI_OPEN_PROTOCOL_BY_DRIVER)Live.Edges[i].Count++;}else for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==H(PciHandles[peer]))Configs[i][0]^=1;}
+   if(Fault==7)for(UINTN i=0;i<N(Bindings);i++)if(FixtureDrivers[i].Handle==(NvAgents[peer]?NvAgents[peer]:NvAgents[FX_PAIR_CONSOLE_INDEX]))ImageMemory[i][0x280]^=1;
+   GU_FULL_FLOW_OPS ops={NULL,PrepareFlow,ChooseFlow,SuccessFlow,ReleaseFlow,ColdFlow,UnlockFlow,SuccessFlow,WindowsFlow,Log};EFI_STATUS s=GuFullFlow(&ops);
