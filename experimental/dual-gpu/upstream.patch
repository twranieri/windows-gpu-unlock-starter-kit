index 0000000000000000000000000000000000000000..252096e10881bbed684c6a18eac35259320d8e3b
--- /dev/null
+++ b/research/dual/test-pair-replay.ps1
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: GPL-2.0-only. Replay the complete private capture in RAM.
+# Missing/unsupported actual captures refuse this job; synthetic tests never stand
+# in for a passing pair replay. No firmware/GPU/USB APIs run on the host.
+param([string]$Clang='clang',[string]$Python='python',[string]$VcVars,
+ [string]$Profile,[string]$Output)
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+. (Join-Path $repo 'internal-boot/unlock/local-profile.ps1')
+. (Join-Path $repo 'research/profile/host.ps1')
+if(!$Profile){$Profile=Join-Path $PSScriptRoot 'local/pair.json'}
+if(!$Output){$Output=Join-Path $PSScriptRoot 'local/pair-replay-results.json'}
+if([IO.Path]::GetFullPath($Profile) -cne [IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'local/pair.json'))){throw 'Replay requires this checkout''s generated private pair report'}
+if([IO.Path]::GetFullPath($Output) -cne [IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'local/pair-replay-results.json'))){throw 'Replay evidence output must stay in the fixed private pair directory'}
+if(Test-Path -LiteralPath $Output){Remove-Item -LiteralPath $Output}
+$hw=Get-DualProfile $repo
+$reportSha=Get-GuSha256 $Profile
+$inputs=@(Get-DualTreeInputs $repo);$tree=Get-LocalInputDigest $inputs
+$build=Join-Path $PSScriptRoot 'build/pair-replay'
+[void][IO.Directory]::CreateDirectory($build)
+$fixture=Join-Path $build 'replay-fixture.h'
+& $Python -I (Join-Path $PSScriptRoot 'make-console-fixture.py') --profile $Profile --output $fixture
+if($LASTEXITCODE -ne 0){throw 'Complete pair graph fixture generation failed; no passing replay evidence written'}
+Import-GuHostCompiler $VcVars
+$bridge=Join-Path $build 'fixture-include.h'
+('#define GU_PAIR_CAPTURE_FIXTURE "'+$fixture.Replace('\','/')+'"')|Set-Content -LiteralPath $bridge -Encoding ascii
+$exe=Join-Path $build 'pair-replay.exe'
+$flags=@('-std=c11','-O1','-Wall','-Wextra','-Werror','-Wno-unused-function','-Wno-unused-parameter',
+ '-D_CRT_SECURE_NO_WARNINGS','-DGU_UEFI_PORT','-DGU_PROFILE_LOCAL','-DGU_PROFILE_LOCAL_DUAL',
+ '-DGU_HEADLESS_RESEARCH','-DGU_SINGLE_RTX_CONSOLE','-DGU_FULL_UNLOCK','-DGU_AUTOMATIC_BOOT',
+ '-DGU_INTERNAL_BOOT','-DGU_EXPERIMENTAL_3090','-DGU_ENTRY_LATCHED_SS1_FULL','-DGU_USB_MEDIA',
+ '-include',$bridge,'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include'),'-I',(Join-Path $repo 'deps/edk2/MdePkg/Include/X64'))
+$compileCommand=@($Clang)+$flags+@((Join-Path $PSScriptRoot 'test_pair_replay.c'),(Join-Path $repo 'internal-boot/unlock/checks.c'),(Join-Path $repo 'internal-boot/unlock/sha256.c'),(Join-Path $repo 'internal-boot/boot/full-flow.c'),'-o',$exe)
+& $compileCommand[0] @($compileCommand|Select-Object -Skip 1)
+if($LASTEXITCODE -ne 0){throw 'Complete pair production replay compile failed'}
+$results=[ordered]@{};$consoleResults=[ordered]@{}
+foreach($mode in @('prepare','release','wrapper','child')) {
+ $name=switch($mode){'prepare'{'pair console prepare replay (real graph)'};'release'{'pair console release replay (real graph)'};'wrapper'{'pair wrapper replay (real graph)'};'child'{'pair child policy replay (real graph)'}}
+ $ErrorActionPreference='Continue'
+ $lines=& $exe $repo $mode 2>&1|ForEach-Object {"$_"}
+ $code=$LASTEXITCODE;$ErrorActionPreference='Stop'
+ $entry=[ordered]@{Exit=$code;Expected=0;Last=($lines|Select-Object -Last 1);Kind='compiled';Adapter='research/dual/test_pair_replay.c';Command=@($exe,$repo,$mode);CompileCommand=$compileCommand;CompileExit=0}
+ if($mode -in @('prepare','release')){$consoleResults[$name]=$entry}else{$results[$name]=$entry}
+ $lines|ForEach-Object {Write-Host $_}
+ if($code -ne 0){throw ('Actual complete captured graph failed '+$mode+' replay; no passing replay evidence written')}
+}
+# Negative coverage executes the same actual wholegraph with one deliberately
+# wrong immutable console subsystem, selected through the hosted-only hook.
+$badProfile=Join-Path $build 'wrong-console-profile.h'
+$originalHeader=Join-Path $repo 'internal-boot/unlock/profile-local-dual.h'
+$wrong=[Convert]::ToUInt32($hw.Report.Cards[$hw.Report.ConsoleCardIndex].Subsystem,16) -bxor 1
+@(('#include "'+$originalHeader.Replace('\','/')+'"'),'#undef GU_BOARD_SUBSYSTEM',('#define GU_BOARD_SUBSYSTEM 0x{0:x8}U' -f $wrong))|Set-Content -LiteralPath $badProfile -Encoding ascii
+$badBridge=Join-Path $build 'wrong-fixture-include.h'
