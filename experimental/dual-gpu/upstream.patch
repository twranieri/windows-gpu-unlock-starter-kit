@@ -0,0 +1,143 @@
+/* GPL-2.0-only. Real dual probe, RAM-only EFI services. No hardware APIs. */
+#define GU_PROBE_PARENT_FIXTURE
+#include "test_probe_generic.c"
+#undef main
+
+enum {D_OK,D_SINGLE,D_THIRD,D_UNKNOWN,D_DUP_BDF,D_DUP_IO,D_BAD_RESOURCE,D_BME,
+      D_PEER_ATTR,D_PEER_CALLBACK,D_THIRD_LATE,D_SHORT_CFG,D_PEER_AFTER_PROM,
+      D_SHORT_DUMP,D_BAD_LOCATION,D_ENUM_REVERSED};
+static EFI_PCI_IO_PROTOCOL Cards[3];
+static EFI_HANDLE CardHandles[3]={(VOID *)101,(VOID *)102,(VOID *)103};
+static UINT32 Configs[3][64];
+static UINTN Segments[3],Buses[3],CardCount;
+static int DualMode,PciEnums,CardRegs[3],CardProm[3],PromCreates[2];
+static UINT32 DumpWords[2];
+static EFI_FILE_PROTOCOL PromFiles[2];
+static int CardIndex(EFI_PCI_IO_PROTOCOL *io){for(int i=0;i<3;i++)if(io==&Cards[i])return i;return -1;}
+static EFI_STATUS EFIAPI DualRead(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT32 at,UINTN n,VOID *data) {
+  int i=CardIndex(io);if(i<0)return EFI_NOT_FOUND;
+  if(w==EfiPciIoWidthUint8){*(UINT8 *)data=0;return EFI_SUCCESS;}
+  if(w!=EfiPciIoWidthUint32 || (at&3U) || at/4+n>64)return EFI_UNSUPPORTED;
+  UINTN count=n;
+  if(DualMode==D_SHORT_CFG && i==1 && n==64)count=3; /* partial success is not a valid snapshot */
+  for(UINTN j=0;j<count;j++)((UINT32 *)data)[j]=Configs[i][at/4+j];
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualLocation(EFI_PCI_IO_PROTOCOL *io,UINTN *seg,UINTN *bus,UINTN *dev,UINTN *fun) {
+  int i=CardIndex(io);if(i<0)return EFI_NOT_FOUND;
+  *seg=Segments[i];*bus=Buses[i];*dev=0;*fun=0;
+  return DualMode==D_BAD_LOCATION && i==1?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualMem(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT8 bar,UINT64 at,UINTN n,VOID *data) {
+  int i=CardIndex(io);(void)n;if(i<0 || w!=EfiPciIoWidthUint32 || bar)return EFI_UNSUPPORTED;
+  if(at>=0x300000 && at<0x400000){CardProm[i]++;S.PromReads++;}
+  else{CardRegs[i]++;S.RegReads++;}
+  *(UINT32 *)data=(UINT32)at+((UINT32)i<<28);
+  if(DualMode==D_PEER_AFTER_PROM && i==1 && CardProm[i]==PROM_DWORDS)Configs[0][11]^=1U;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualBar(EFI_PCI_IO_PROTOCOL *io,UINT8 index,UINT64 *supports,VOID **out) {
+  int i=CardIndex(io);(void)index;(void)supports;if(i<0)return EFI_NOT_FOUND;
+  UINT8 *raw=calloc(1,sizeof(EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR)+2);if(!raw)return EFI_OUT_OF_RESOURCES;
+  EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR *d=(VOID *)raw;
+  d->Desc=ACPI_ADDRESS_SPACE_DESCRIPTOR;d->Len=sizeof(*d)-3;d->AddrSpaceGranularity=32;
+  d->AddrRangeMin=Configs[i][4];d->AddrRangeMax=(UINT64)Configs[i][4]+0xffffff;
+  d->AddrLen=DualMode==D_BAD_RESOURCE && i==0?0x800000:0x1000000;
+  raw[sizeof(*d)]=ACPI_END_TAG_DESCRIPTOR;*out=raw;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualAttr(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_ATTRIBUTE_OPERATION op,UINT64 mask,UINT64 *value) {
+  int i=CardIndex(io);
+  if(i<0 || op!=EfiPciIoAttributeOperationGet || mask || !value){AttributeOthers++;return EFI_UNSUPPORTED;}
+  AttributeGets++;*value=0x200;
+  if(i==1 && DualMode==D_PEER_ATTR)Configs[0][11]^=1U;
+  if(i==1 && DualMode==D_PEER_CALLBACK)Cards[0].Mem.Read=NULL;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualLocate(EFI_LOCATE_SEARCH_TYPE search,EFI_GUID *g,VOID *key,UINTN *n,EFI_HANDLE **out) {
+  if(g && !memcmp(g,&WantPci,sizeof(*g))){
+    PciEnums++;UINTN count=CardCount;
+    if(DualMode==D_THIRD_LATE && PciEnums>1)count=3;
+    EFI_HANDLE *list=malloc(count*sizeof(*list));if(!list)return EFI_OUT_OF_RESOURCES;
+    for(UINTN i=0;i<count;i++)list[i]=CardHandles[(DualMode==D_ENUM_REVERSED && (PciEnums&1))?count-1-i:i];
+    *out=list;*n=count;return EFI_SUCCESS;
