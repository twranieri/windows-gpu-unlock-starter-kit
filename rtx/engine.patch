new file mode 100644
index 0000000..ab3aad4
--- /dev/null
+++ b/sim/tests/kit_targets.rs
@@ -0,0 +1,70 @@
+extern crate alloc;
+
+#[path = "../../loader/src/kit_targets.rs"]
+mod kit_targets;
+
+const HEADER: &str = "kit-v1 0123456789abcdef0123456789abcdef";
+const AMPERE: &str = "0000:07:00.0 2204 39873842";
+const ADA: &str = "0000:2B:00.0 2704 88821043";
+
+fn manifest(rows: &[&str]) -> String {
+    format!("{HEADER}\n{}", rows.join("\n"))
+}
+
+#[test]
+fn accepts_single_target_and_exact_mixed_set_in_any_order() {
+    let single = manifest(&[AMPERE]);
+    let (nonce, expected) = kit_targets::parse(single.as_bytes()).unwrap();
+    assert_eq!(nonce, &HEADER[7..]);
+    assert_eq!(expected[0].bdf, (0, 7, 0, 0));
+    assert_eq!(expected[0].device, 0x2204);
+    assert_eq!(expected[0].subsystem, 0x3987_3842);
+    assert!(kit_targets::matches(&expected, &expected));
+
+    let pair = format!("{}\r\n", manifest(&[AMPERE, ADA]).replace('\n', "\r\n"));
+    let (_, expected) = kit_targets::parse(pair.as_bytes()).unwrap();
+    assert!(kit_targets::matches(&expected, &[expected[1], expected[0]]));
+}
+
+#[test]
+fn refuses_bad_manifest_shape_and_encoding() {
+    let invalid = [
+        String::new(),
+        manifest(&[]),
+        AMPERE.to_owned(),
+        format!("kit-v1 {}\n{AMPERE}", HEADER[7..].to_uppercase()),
+        format!("kit-v1 1234\n{AMPERE}"),
+        format!("\u{feff}{}", manifest(&[AMPERE])),
+        format!("{}\n\n", manifest(&[AMPERE])),
+        manifest(&["0000:07:00.0\t2204 39873842"]),
+        manifest(&["0000:07:00.0 2204 +9873842"]),
+        manifest(&["0000:07:20.0 2204 39873842"]),
+        manifest(&["0000:07:00.1 2204 39873842"]),
+        manifest(&["0000:07:00.0 2204 39870000"]),
+        manifest(&[AMPERE, "0000:07:00.0 2704 88821043"]),
+        manifest(&[AMPERE, ADA, "0000:09:00.0 2704 88821043"]),
+    ];
+    for text in invalid {
+        assert!(kit_targets::parse(text.as_bytes()).is_none(), "{text:?}");
+    }
+}
+
+#[test]
+fn refuses_added_missing_duplicate_moved_or_changed_adapters() {
+    let pair = manifest(&[AMPERE, ADA]);
+    let (_, expected) = kit_targets::parse(pair.as_bytes()).unwrap();
+    let first = expected[0];
+    let second = expected[1];
+    let variants = [
+        vec![],
+        vec![first],
+        vec![first, second, second],
+        vec![first, first],
+        vec![first, kit_targets::Target { bdf: (0, 4, 0, 0), ..second }],
+        vec![first, kit_targets::Target { device: 0x2702, ..second }],
+        vec![first, kit_targets::Target { subsystem: 0x8883_1043, ..second }],
+    ];
+    for discovered in variants {
+        assert!(!kit_targets::matches(&expected, &discovered), "{discovered:?}");
+    }
+}
