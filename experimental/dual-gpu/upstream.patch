+static EFI_STATUS Log(VOID *context,const char *event,EFI_STATUS s){(void)context;if(s!=EFI_SUCCESS)fprintf(stderr,"event=%s status=%llx\n",event,(unsigned long long)s);return EFI_SUCCESS;}
+static void Load(const char *root,const char *relative,VOID *out,UINTN bytes) {
+ char path[4096];Check(snprintf(path,sizeof(path),"%s/%s",root,relative)>0,"bounded fixture filename");FILE *f=fopen(path,"rb");Check(f!=NULL,"actual fixture exists");Check(fread(out,1,bytes,f)==bytes && fgetc(f)==EOF,"exact actual fixture length");Check(!fclose(f),"fixture close");
+}
+static void Setup(void) {
+ memset(&Boot,0,sizeof(Boot));memset(&Table,0,sizeof(Table));memset(Dead,0,sizeof(Dead));memset(TextGone,0,sizeof(TextGone));Stops=Writes=Windows=0;
+ memcpy(Live.Edges,FixtureEdges,sizeof(FixtureEdges));Live.Count=N(FixtureEdges);memcpy(Paths,FixturePaths,sizeof(Paths));memset(ColdValues,0,sizeof(ColdValues));memcpy(ColdValues,FixturePairCold,sizeof(FixturePairCold));
+ Boot.AllocatePool=Alloc;Boot.FreePool=FreeMemory;Boot.RaiseTPL=Raise;Boot.RestoreTPL=Restore;Boot.HandleProtocol=Handle;Boot.LocateHandleBuffer=Locate;
+ Boot.ProtocolsPerHandle=Protocols;Boot.OpenProtocolInformation=Opens;Boot.LocateDevicePath=FindPci;Boot.DisconnectController=Disconnect;Boot.OpenProtocol=Open;Boot.CloseProtocol=Close;
+ for(UINTN i=0;i<N(Pcis);i++) {
+  memset(&Pcis[i],0,sizeof(Pcis[i]));memset(Configs[i],0,sizeof(Configs[i]));memcpy(Configs[i],FixturePcis[i].Config,64);
+  INTN row=Target(FixturePcis[i].Handle);if(row>=0)memcpy(Configs[i],FixturePairConfigs[row],256);
+  Attrs[i]=(Configs[i][1]&1?0x100:0)|(Configs[i][1]&2?0x200:0);Pcis[i].GetLocation=Location;Pcis[i].Pci.Read=ConfigRead;Pcis[i].Mem.Read=MemoryRead;Pcis[i].GetBarAttributes=Bar;Pcis[i].Attributes=Attributes;
+ }
+ for(UINTN i=0;i<N(Gops);i++) {
+  const FX_GOP *f=&FixtureGops[i];memset(&GopInfo[i],0,sizeof(GopInfo[i]));GopInfo[i].HorizontalResolution=f->Width;GopInfo[i].VerticalResolution=f->Height;GopInfo[i].PixelsPerScanLine=f->Stride;GopInfo[i].PixelFormat=f->PixelFormat;
+  GopModes[i]=(EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE){0};GopModes[i].MaxMode=f->MaxMode;GopModes[i].Mode=f->Mode;GopModes[i].Info=&GopInfo[i];GopModes[i].SizeOfInfo=f->InfoBytes;GopModes[i].FrameBufferBase=f->FrameBuffer;GopModes[i].FrameBufferSize=f->Bytes;
+  Gops[i]=(EFI_GRAPHICS_OUTPUT_PROTOCOL){0};Gops[i].Mode=&GopModes[i];
+ }
+ for(UINTN i=0;i<N(Bindings);i++) {
+  const FX_DRIVER *d=&FixtureDrivers[i];memcpy(ImageMemory[i],ImageOriginal[i],d->Size);Bindings[i]=(EFI_DRIVER_BINDING_PROTOCOL){0};Images[i]=(EFI_LOADED_IMAGE_PROTOCOL){0};
+  Bindings[i].DriverBindingHandle=d->Handle;Bindings[i].ImageHandle=d->ImageHandle;Bindings[i].Version=d->Version;Bindings[i].Stop=(EFI_DRIVER_BINDING_STOP)(ImageMemory[i]+d->StopOffset);
+  Images[i].ImageBase=ImageMemory[i];Images[i].ImageSize=d->Size;Images[i].ImageCodeType=d->CodeType;Images[i].DeviceHandle=d->DeviceHandle;Images[i].FilePath=(VOID *)d->FilePath;
+ }
+ Text=(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL){0};TextMode=(EFI_SIMPLE_TEXT_OUTPUT_MODE){0};Text.Mode=&TextMode;Text.OutputString=Output;
+ Input=(EFI_SIMPLE_TEXT_INPUT_PROTOCOL){0};Input.Reset=Reset;Input.ReadKeyStroke=Key;Input.WaitForKey=H(1);
+ Table.BootServices=&Boot;Table.ConsoleOutHandle=FX_Console;Table.StandardErrorHandle=FX_Error;Table.ConsoleInHandle=FX_Input;Table.ConOut=Table.StdErr=&Text;Table.ConIn=&Input;
+ GuInit(&Boot,NULL);Gu.image=H(FX_HANDLES+1);
