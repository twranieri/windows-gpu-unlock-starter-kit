--- /dev/null
+++ b/loader/src/kit_targets.rs
@@ -0,0 +1,77 @@
+//! Starter kit target manifest, shared with the host-side contract tests.
+
+use alloc::vec::Vec;
+
+// Version/nonce header and two 26-byte rows with CRLF.
+const MAX_BYTES: usize = 97;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Target {
+    pub bdf: (usize, usize, usize, usize),
+    pub device: u16,
+    pub subsystem: u32,
+}
+
+pub fn parse(raw: &[u8]) -> Option<(&str, Vec<Target>)> {
+    if raw.is_empty() || raw.len() > MAX_BYTES || !raw.is_ascii() {
+        return None;
+    }
+    let mut lines = core::str::from_utf8(raw).ok()?.lines();
+    let nonce = lines.next()?.strip_prefix("kit-v1 ")?;
+    if nonce.len() != 32 || !nonce.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {
+        return None;
+    }
+    let mut targets = Vec::new();
+    for line in lines {
+        let row = line.as_bytes();
+        if targets.len() == 2
+            || row.len() != 26
+            || row[4] != b':'
+            || row[7] != b':'
+            || row[10] != b'.'
+            || row[12] != b' '
+            || row[17] != b' '
+        {
+            return None;
+        }
+        let hex = |start: usize, end: usize| u32::from_str_radix(&line[start..end], 16).ok();
+        // from_str_radix also accepts a leading '+', so check every digit.
+        if ![0..4, 5..7, 8..10, 11..12, 13..17, 18..26]
+            .iter()
+            .all(|span| row[span.clone()].iter().all(u8::is_ascii_hexdigit))
+        {
+            return None;
+        }
+        let bdf = (
+            hex(0, 4)? as usize,
+            hex(5, 7)? as usize,
+            hex(8, 10)? as usize,
+            hex(11, 12)? as usize,
+        );
+        let device = hex(13, 17)? as u16;
+        let subsystem = hex(18, 26)?;
+        if bdf.2 > 31
+            || bdf.3 != 0
+            || [0, 0xffff].contains(&device)
+            || [0, 0xffff].contains(&(subsystem as u16))
+            || [0, 0xffff].contains(&((subsystem >> 16) as u16))
+            || targets.iter().any(|target: &Target| target.bdf == bdf)
+        {
+            return None;
+        }
+        targets.push(Target { bdf, device, subsystem });
+    }
+    if targets.is_empty() {
+        return None;
+    }
+    Some((nonce, targets))
+}
+
+pub fn matches(expected: &[Target], discovered: &[Target]) -> bool {
+    (1..=2).contains(&expected.len())
+        && discovered.len() == expected.len()
+        && expected.iter().all(|target| {
+            discovered.iter().filter(|observed| *observed == target).count() == 1
+        })
+        && discovered.iter().all(|target| expected.contains(target))
+}
