+  Check(DualRun(D_SHORT_DUMP)!=EFI_SUCCESS && !Logged("capture-complete=1"),"short PROM dump invalidates the capture");
+  if(argc==3)EmitSynthetic(argv[2]);
+  printf("PASS dual probe checks: %d; RAM-only EFI services; no hardware access\n",Checks);
+  return 0;
+}
