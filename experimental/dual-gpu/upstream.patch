+   if(Fault==3)PromBytes[peer][0]^=1;
+  }
+ } else if(!strcmp(argv[2],"child")) {
+  Fault=0;Setup();Check(GuPrepareConsole(&Table,Log,NULL)==EFI_SUCCESS,"actual captured pair prepare");Check(GuReleaseGop(&Table,H(FX_HANDLES+1),Log,NULL)==EFI_SUCCESS,"actual captured console release");
+  Check(GuDiscoverTargets()==EFI_SUCCESS && GuTargetCount()==GU_PAIR_COUNT,"production registry resolves complete captured pair");Check(GuActivate(0)==EFI_SUCCESS,"activate first captured target");
+  GuHeadlessReset(&Table);Check(GuHeadlessCheck(),"actual child policy accepts prepared wholepair graph");
+  for(UINTN i=0;i<GU_PAIR_COUNT;i++)if(!GuPairTargets[i].Console && ChildCounts[i]) {
+   Gu.complete=TRUE;Check(!GuHeadlessCheck(),"completed peer with remaining physical GOP cannot pass");Gu.complete=FALSE;
+  }
+  Input.WaitForKey=NULL;Check(!GuHeadlessCheck(),"late input drift blocks child");Input.WaitForKey=H(1);
+  Check(GuHeadlessCheck(),"intact restored observation remains valid");
+  UINTN before=Live.Count;Check(before<MAX_RECORDS,"mutation edge capacity");
