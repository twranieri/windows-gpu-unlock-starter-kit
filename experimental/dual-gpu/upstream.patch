+        Check ($calls.Usb -eq 2 -and $calls.Probe -eq 2 -and !(Test-Path -LiteralPath (Join-Path $root 'research/dual/local'))) 'Capture-only marker blocked diagnostic staging.'
+    }
+    [IO.File]::WriteAllText((Join-Path $capture 'DIAG01.TXT'),(Log 2).Replace('capture-complete=1','capture-complete=0'))
+    Check (@(Get-DualWholeCaptures $capture 2).Count -eq 1) 'Incomplete log counted toward pair evidence.'
+    Assert-DualChildPath $root $capture
+    Refused {Assert-DualChildPath $capture $root} 'Archive path outside the private capture root accepted.'
+    function Get-GuGenericProbeFiles {return @('fixture.c')}
+    [IO.File]::WriteAllText((Join-Path $root 'fixture.c'),'SYNTHETIC source')
