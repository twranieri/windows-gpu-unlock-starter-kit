+        return tx_detach::pm_preflight(&pci).is_ok();
+
+        #[cfg(not(feature = "tx"))]
+        {
+            let Some(cap) = pci.pm_cap() else {
+                info!("KIT: {seg:04x}:{bus:02x}:{dev:02x}.{fun} PCI power-management capability unavailable. Check that firmware initializes this GPU.");
