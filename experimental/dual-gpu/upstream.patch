--- /dev/null
+++ b/research/dual/test-probe.ps1
@@ -0,0 +1,52 @@
+# GPL-2.0-only. RAM-only EFI mocks and compile guards; no disk/GPU/UEFI actions.
+param([Parameter(Mandatory)][string]$Clang,[string]$VcVars,[string]$Python='python')
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+. (Join-Path $repo 'research/profile/host.ps1')
+Import-GuHostCompiler $VcVars
+Push-Location -LiteralPath (Join-Path $repo 'internal-boot/boot')
+try {
+ New-Item -ItemType Directory -Path 'build/dual-tests' -Force | Out-Null
+ $includes=@('-I','../../deps/edk2/MdePkg/Include','-I','../../deps/edk2/MdePkg/Include/X64')
+ $flags=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2')
+ & $Clang -std=c11 -O1 -Wall -Wextra -Werror -D_CRT_SECURE_NO_WARNINGS @flags @includes test_probe_dual.c probe.c ../unlock/sha256.c -o build/dual-tests/test-probe-dual.exe
+ if($LASTEXITCODE -ne 0){throw 'Dual RAM-only test compile failed'}
+ $roundtrip=Join-Path $repo ('research/dual/build/c-probe-roundtrip-'+[Guid]::NewGuid().ToString('N'))
+ [void][IO.Directory]::CreateDirectory($roundtrip)
+ & ./build/dual-tests/test-probe-dual.exe --emit $roundtrip
+ if($LASTEXITCODE -ne 0){throw 'Dual RAM-only test failed'}
+ $roundtripReport=Join-Path $roundtrip 'observations.json'
+ & $Python -I (Join-Path $PSScriptRoot 'analyze_pair.py') --first (Join-Path $roundtrip 'DIAG00.TXT') --second (Join-Path $roundtrip 'DIAG01.TXT') --output $roundtripReport
+ if($LASTEXITCODE -ne 0){throw 'Actual C-emitted card records failed the real offline analyzer'}
+ $observed=Get-Content -LiteralPath $roundtripReport -Raw|ConvertFrom-Json
+ if($observed.card_count -ne 2 -or $observed.can_unlock -or $observed.can_build_write_efi -or $observed.physical_qualification){throw 'Synthetic C/analyzer roundtrip incorrectly authorized hardware'}
+ Write-Output 'PASS actual C-emitted dual records and dumped mock PROMs roundtrip through the production parser; no physical qualification.'
+ $guardChecks=0
+ foreach($bad in @('-UGU_DIAGNOSTIC_ONLY','-UGU_PROBE_GENERIC','-UGU_DIAGNOSTIC_PROBE','-UGU_PROBE_AUTO_BUS','-DGU_FULL_UNLOCK','-DGU_EXPERIMENTAL_3090','-DGU_PROBE_MAX_TARGETS=1','-UGU_PROBE_DUAL')){
+  $messages=& $Clang -target x86_64-pc-windows-msvc -std=c11 -ffreestanding -fshort-wchar -fsyntax-only @flags $bad @includes probe.c 2>&1 | Out-String
+  if($LASTEXITCODE -eq 0 -or $messages -notmatch 'GU_PROBE_DUAL|Multiple probe targets require'){throw "Unsafe dual compile mode accepted: $bad"};$guardChecks++
+ }
+ Write-Output "PASS $guardChecks experimental dual compile guards."
+ # Invalid CLI combinations must stop before even a partition query. The valid
+ # build below uses a dummy ESP and mocked query; its EFI must never be booted.
+ $dummy=[guid]'11111111-2222-3333-4444-555555555555';$queryCounter=@{Count=0}
+ function Get-Partition {$queryCounter.Count++;[pscustomobject]@{Guid=$dummy;IsSystem=$true}}
+ $entry=Join-Path $repo 'research/profile/build-probe.ps1'
+ foreach($case in @(@{MaxTargets=2},@{ExperimentalDual=$true},@{ExperimentalDual=$true;MaxTargets=2;TargetBus=1})){
+  $refused=$false
+  try {& $entry -WindowsEspGuid $dummy @case} catch {$refused=$true}
+  if(!$refused -or $queryCounter.Count){throw 'Unsafe dual CLI reached a partition query'}
+ }
+ $linker=Join-Path (Split-Path $Clang) 'lld-link.exe'
+ $python=(Get-Command python.exe -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source
+ & $entry -WindowsEspGuid $dummy -Clang $Clang -LldLink $linker -Python $python -ExperimentalDual -MaxTargets 2
+ if(!$? -or $queryCounter.Count -ne 1){throw 'Dummy-ESP dual build failed'}
+ $artifact=Join-Path $repo 'internal-boot/boot/build/probe-dual-experimental'
+ $manifest=Get-Content -LiteralPath (Join-Path $artifact 'manifest.json') -Raw | ConvertFrom-Json
+ if($manifest.MaxTargets -ne 2 -or !$manifest.Experimental -or $manifest.CanUnlock -or $manifest.CanDetach -or $manifest.WritesFirmwareVariables -or $manifest.HardwareTested){throw 'Invalid experimental read-only manifest'}
+ . (Join-Path $repo 'research/profile/probe-manifest.ps1')
+ $refused=$false
+ try {Assert-GuGenericProbeManifest $repo $manifest (Join-Path $artifact 'BOOTX64.EFI')} catch {$refused=$true}
+ if(!$refused){throw 'Production single-card manifest accepted the dual experimental image'}
+ Write-Output 'PASS 5 dual CLI/build checks: dummy ESP only; nothing staged; never boot the test artifact.'
+} finally {Pop-Location}
diff --git a/research/dual/test-profile.ps1 b/research/dual/test-profile.ps1
