+def prepare(folder,count=2,**kwargs):
+    folder.mkdir(parents=True,exist_ok=True)
+    for boot in range(2):
+        text,cards=synthetic(count,boot=boot,**kwargs)
+        (folder/f'DIAG{boot:02d}.TXT').write_text(text,encoding='ascii')
+    for index,card in enumerate(cards):(folder/f'PROM{index:02d}.BIN').write_bytes(card['prom'])
+    (folder/'IMG00.BIN').write_bytes(image(0x26ae0 if kwargs.get('added_models') else 0x2be40))
+    return folder
+
+
+def generate(folder, candidate_envelope=None):
+    with patch.object(M.LEGACY,'locate_fwsec',return_value={'image_off':0x1000,'image_size':0x400}):
+        return M.generate(folder,Path('SYNTHETIC-NOT-A-LOCATOR'),candidate_envelope or envelope())
+
+
+def emit(root,count=2,**kwargs):
+    # Only a caller-selected scratch tree; no AllPassed/evidence file is made.
+    root=Path(root).resolve()
+    if root==REPO or REPO in root.parents:raise ValueError('Synthetic fixtures must stay outside the production checkout')
+    inputs=prepare(root/'synthetic-input',count,**kwargs)
+    outputs,report=generate(inputs)
+    for path,data in outputs.items():
+        target=root/path;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(data)
+    target=root/'research/dual/local/pair.json';target.write_text(json.dumps(report,indent=2))
+    header=F.build(report,root)
+    (root/'replay-fixture.h').write_text(header)
+    return outputs,report,header
