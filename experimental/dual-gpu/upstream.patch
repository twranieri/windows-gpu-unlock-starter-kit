+/* SPDX-License-Identifier: GPL-2.0-only. Whole captured pair, EFI services in RAM.
+ * The production prepare/release, target registry and child policy run below.
+ * No firmware API is called on the host; no transaction is executed on a GPU. */
+#include "../../internal-boot/boot/full-release.c"
+#include "../../internal-boot/unlock/port.c"
+#include "../../internal-boot/unlock/headless-policy.h"
+#include "../../internal-boot/boot/full-flow.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifndef GU_PAIR_CAPTURE_FIXTURE
+#error A complete generated capture fixture is required
+#endif
+typedef struct {EFI_HANDLE Handle;UINTN Bytes;UINT8 Data[128];} FX_PATH;
+typedef struct {EFI_HANDLE Handle;UINT32 Config[16];UINTN Segment,Bus,Device,Function;} FX_PCI;
+typedef struct {EFI_HANDLE Handle;UINT64 FrameBuffer;UINTN Bytes;UINT32 Mode,MaxMode;UINTN InfoBytes;UINT32 Width,Height,Stride,PixelFormat;} FX_GOP;
+typedef struct {EFI_HANDLE Handle,ImageHandle;UINT32 Version;UINTN Size,StopOffset;UINT32 CodeType;EFI_HANDLE DeviceHandle;UINTN FilePathBytes;UINT8 FilePath[128];const char *ImageFile;} FX_DRIVER;
+#include GU_PAIR_CAPTURE_FIXTURE
+#define N(a) (sizeof(a)/sizeof((a)[0]))
+#define H(n) ((EFI_HANDLE)(UINTN)(n))
+static GRAPH Live;
+static EFI_BOOT_SERVICES Boot;
+static EFI_SYSTEM_TABLE Table;
+static EFI_PCI_IO_PROTOCOL Pcis[N(FixturePcis)];
+static UINT32 Configs[N(FixturePcis)][64],ColdValues[2][9];
+static UINT64 Attrs[N(FixturePcis)];
+static FX_PATH Paths[N(FixturePaths)];
+static EFI_GRAPHICS_OUTPUT_PROTOCOL Gops[N(FixtureGops)];
+static EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE GopModes[N(FixtureGops)];
+static EFI_GRAPHICS_OUTPUT_MODE_INFORMATION GopInfo[N(FixtureGops)];
+static EFI_DRIVER_BINDING_PROTOCOL Bindings[N(FixtureDrivers)];
+static EFI_LOADED_IMAGE_PROTOCOL Images[N(FixtureDrivers)];
+static UINT8 *ImageMemory[N(FixtureDrivers)],*ImageOriginal[N(FixtureDrivers)],PromBytes[2][0x100000];
+static BOOLEAN Dead[FX_HANDLES+1];
+static BOOLEAN TextGone[FX_HANDLES+1];
+static EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL Text;
+static EFI_SIMPLE_TEXT_OUTPUT_MODE TextMode;
+static EFI_SIMPLE_TEXT_INPUT_PROTOCOL Input;
+static UINT64 OpaqueInterface[64];
+static unsigned Checks,Stops,Writes,Windows,Fault;
+static const EFI_HANDLE PciHandles[2]=FX_PAIR_PCI_HANDLES;
+static const EFI_HANDLE NvAgents[2]=FX_PAIR_NVGOP_AGENTS;
+static const UINTN ChildCounts[2]=FX_PAIR_CHILD_COUNTS;
+static const EFI_HANDLE Children[2][4]=FX_PAIR_CHILD_HANDLES;
+static void Check(BOOLEAN ok,const char *why) {Checks++;if(!ok){fprintf(stderr,"FAIL pair replay fault=%u: %s\n",Fault,why);exit(1);}}
+VOID GuLog(const char *format,...){(void)format;}
+static INTN Target(EFI_HANDLE h){for(UINTN i=0;i<GU_PAIR_COUNT;i++)if(h==H(PciHandles[i]))return (INTN)i;return -1;}
+static INTN PciIndex(EFI_PCI_IO_PROTOCOL *io){for(UINTN i=0;i<N(Pcis);i++)if(io==&Pcis[i])return (INTN)i;return -1;}
+static BOOLEAN Active(EFI_HANDLE h){return (UINTN)h>0 && (UINTN)h<=FX_HANDLES && !Dead[(UINTN)h];}
+static EFI_STATUS EFIAPI Alloc(EFI_MEMORY_TYPE type,UINTN n,VOID **out){(void)type;*out=malloc(n);return *out?EFI_SUCCESS:EFI_OUT_OF_RESOURCES;}
+static EFI_STATUS EFIAPI FreeMemory(VOID *p){free(p);return EFI_SUCCESS;}
+static EFI_TPL EFIAPI Raise(EFI_TPL level){(void)level;return TPL_APPLICATION;}
+static VOID EFIAPI Restore(EFI_TPL level){(void)level;}
+static EFI_STATUS EFIAPI Reset(EFI_SIMPLE_TEXT_INPUT_PROTOCOL *p,BOOLEAN x){(void)p;(void)x;return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI Key(EFI_SIMPLE_TEXT_INPUT_PROTOCOL *p,EFI_INPUT_KEY *k){(void)p;(void)k;return EFI_NOT_READY;}
+static EFI_STATUS EFIAPI Output(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *p,CHAR16 *s){(void)p;(void)s;Check(FALSE,"headless code must not write console");return EFI_DEVICE_ERROR;}
+static EFI_STATUS EFIAPI Handle(EFI_HANDLE h,EFI_GUID *g,VOID **out) {
+ *out=NULL;if(!Active(h))return EFI_UNSUPPORTED;
+ if(GuGuidEqual(g,&PciGuid))for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==h)*out=&Pcis[i];
+ if(GuGuidEqual(g,&PathGuid))for(UINTN i=0;i<N(Paths);i++)if(Paths[i].Handle==h)*out=Paths[i].Data;
+ if(GuGuidEqual(g,&GopGuid))for(UINTN i=0;i<N(Gops);i++)if(FixtureGops[i].Handle==h)*out=&Gops[i];
+ if(GuGuidEqual(g,&TextGuid) && !TextGone[(UINTN)h])for(UINTN i=0;i<N(FixtureInstalledProtocols);i++)if(FixtureInstalledProtocols[i].Handle==h && GuGuidEqual(g,&FixtureInstalledProtocols[i].Guid))*out=&Text;
+ if(GuGuidEqual(g,&InputGuid) && h==FX_Input)*out=&Input;
+ for(UINTN i=0;i<N(Bindings);i++) {
+  if(GuGuidEqual(g,&BindingGuid) && FixtureDrivers[i].Handle==h)*out=&Bindings[i];
+  if(GuGuidEqual(g,&ImageGuid) && FixtureDrivers[i].ImageHandle==h)*out=&Images[i];
+ }
+ /* Preserve every other captured interface's presence without inventing opens.
+    Production never invokes an unrecognized protocol's methods. */
+ if(!*out)for(UINTN i=0;i<N(FixtureInstalledProtocols);i++)
+  if(FixtureInstalledProtocols[i].Handle==h && GuGuidEqual(g,&FixtureInstalledProtocols[i].Guid) &&
+    !GuGuidEqual(g,&PciGuid) && !GuGuidEqual(g,&PathGuid) && !GuGuidEqual(g,&GopGuid) && !GuGuidEqual(g,&TextGuid))*out=OpaqueInterface;
+ return *out?EFI_SUCCESS:EFI_UNSUPPORTED;
+}
+static EFI_STATUS EFIAPI Locate(EFI_LOCATE_SEARCH_TYPE type,EFI_GUID *g,VOID *key,UINTN *count,EFI_HANDLE **out) {
+ (void)key;*count=0;*out=malloc(FX_HANDLES*sizeof(**out));if(!*out)return EFI_OUT_OF_RESOURCES;
+ for(UINTN h=1;h<=FX_HANDLES;h++)if(Active(H(h))) {
+  VOID *p=NULL;if(type==AllHandles || (type==ByProtocol && Handle(H(h),g,&p)==EFI_SUCCESS))(*out)[(*count)++]=H(h);
+ }
+ if(!*count){free(*out);*out=NULL;return EFI_NOT_FOUND;}return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Protocols(EFI_HANDLE h,EFI_GUID ***out,UINTN *count) {
+ *count=0;*out=malloc(N(FixtureInstalledProtocols)*sizeof(**out));if(!*out)return EFI_OUT_OF_RESOURCES;
+ for(UINTN i=0;i<N(FixtureInstalledProtocols);i++)if(FixtureInstalledProtocols[i].Handle==h) {
+  VOID *p=NULL;if(Handle(h,(EFI_GUID *)&FixtureInstalledProtocols[i].Guid,&p)==EFI_SUCCESS)(*out)[(*count)++]=(EFI_GUID *)&FixtureInstalledProtocols[i].Guid;
+ }
+ return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Opens(EFI_HANDLE h,EFI_GUID *g,EFI_OPEN_PROTOCOL_INFORMATION_ENTRY **out,UINTN *count) {
+ *count=0;*out=malloc(MAX_RECORDS*sizeof(**out));if(!*out)return EFI_OUT_OF_RESOURCES;
+ for(UINTN i=0;i<Live.Count;i++){const EDGE *e=&Live.Edges[i];if(e->Handle==h && GuGuidEqual(g,&e->Protocol))(*out)[(*count)++]=(EFI_OPEN_PROTOCOL_INFORMATION_ENTRY){e->Agent,e->Controller,e->Attributes,e->Count};}
+ return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI FindPci(EFI_GUID *g,EFI_DEVICE_PATH_PROTOCOL **path,EFI_HANDLE *h) {
+ if(!GuGuidEqual(g,&PciGuid))return EFI_UNSUPPORTED;
+ for(UINTN i=0;i<GU_PAIR_COUNT;i++) {
+  const GU_PAIR_TARGET *p=&GuPairTargets[i];UINTN n=p->ControllerBytes-4;
+  if(GuPairBytes(*path,p->ControllerPath,n)){*h=H(PciHandles[i]);*path=(VOID *)((UINT8 *)*path+n);return EFI_SUCCESS;}
+ }
+ return EFI_NOT_FOUND;
+}
+static EFI_STATUS EFIAPI Location(EFI_PCI_IO_PROTOCOL *io,UINTN *s,UINTN *b,UINTN *d,UINTN *f) {
+ INTN i=PciIndex(io);if(i<0)return EFI_UNSUPPORTED;
+ *s=FixturePcis[i].Segment;*b=FixturePcis[i].Bus;*d=FixturePcis[i].Device;*f=FixturePcis[i].Function;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI ConfigRead(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT32 at,UINTN count,VOID *out) {
+ INTN i=PciIndex(io);if(i<0 || w!=EfiPciIoWidthUint32 || at%4 || at>256 || count>(256-at)/4)return EFI_UNSUPPORTED;
+ memcpy(out,(UINT8 *)Configs[i]+at,count*4);return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI MemoryRead(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT8 bar,UINT64 at,UINTN count,VOID *out) {
+ INTN index=PciIndex(io);if(index<0 || bar)return EFI_UNSUPPORTED;
+ INTN row=Target(FixturePcis[index].Handle);if(row<0)return EFI_UNSUPPORTED;
+ UINTN bytes=w==EfiPciIoWidthUint8?count:w==EfiPciIoWidthUint32?count*4:0;
+ if(bytes && at>=0x300000 && at<=0x400000 && bytes<=0x400000-at){memcpy(out,PromBytes[row]+at-0x300000,bytes);return EFI_SUCCESS;}
+ const UINT32 offsets[]={0,0x118128,0x118234,0x110100,0x1fa828,0x823804,0x82381c,0x823820,0x1183a4};
+ if(w==EfiPciIoWidthUint32 && count==1)for(UINTN i=0;i<N(offsets);i++)if(at==offsets[i]){*(UINT32 *)out=ColdValues[row][i];return EFI_SUCCESS;}
+ return EFI_UNSUPPORTED;
+}
+static EFI_STATUS EFIAPI Bar(EFI_PCI_IO_PROTOCOL *io,UINT8 n,UINT64 *supported,VOID **out) {
+ (void)supported;INTN i=PciIndex(io);if(i<0 || n)return EFI_UNSUPPORTED;INTN row=Target(FixturePcis[i].Handle);if(row<0)return EFI_UNSUPPORTED;
+ *out=malloc(48);if(!*out)return EFI_OUT_OF_RESOURCES;memcpy(*out,FixturePairBarResources[row],48);return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Attributes(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_ATTRIBUTE_OPERATION op,UINT64 mask,UINT64 *out) {
+ INTN i=PciIndex(io);if(i<0)return EFI_UNSUPPORTED;
+ if(op==EfiPciIoAttributeOperationGet){*out=Attrs[i];return EFI_SUCCESS;}
+ if(op==EfiPciIoAttributeOperationSupported){*out=EFI_PCI_IO_ATTRIBUTE_IO|EFI_PCI_IO_ATTRIBUTE_MEMORY|EFI_PCI_IO_ATTRIBUTE_BUS_MASTER;return EFI_SUCCESS;}
+ Check(op==EfiPciIoAttributeOperationEnable && mask && !(mask&~0x300ULL),"decode change is limited to original IO/MEM");
+ Writes++;Attrs[i]|=mask;Configs[i][1]|=(mask&0x100?1U:0U)|(mask&0x200?2U:0U);return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Open(EFI_HANDLE h,EFI_GUID *g,VOID **out,EFI_HANDLE agent,EFI_HANDLE controller,UINT32 attrs) {
+ Check(Target(h)>=0 && !controller && attrs==EFI_OPEN_PROTOCOL_EXCLUSIVE && GuGuidEqual(g,&PciGuid),"only exact target exclusively claimed");
+ EFI_STATUS s=Handle(h,g,out);if(s!=EFI_SUCCESS)return s;
+ Check(Live.Count<MAX_RECORDS,"claim graph bound");Live.Edges[Live.Count++]=(EDGE){h,agent,NULL,*g,attrs,1};return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Close(EFI_HANDLE h,EFI_GUID *g,EFI_HANDLE agent,EFI_HANDLE c) {
+ (void)c;UINTN n=0;for(UINTN i=0;i<Live.Count;i++){EDGE *e=&Live.Edges[i];if(!(e->Handle==h && e->Agent==agent && GuGuidEqual(&e->Protocol,g) && e->Attributes==EFI_OPEN_PROTOCOL_EXCLUSIVE))Live.Edges[n++]=*e;}Live.Count=n;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Disconnect(EFI_HANDLE h,EFI_HANDLE agent,EFI_HANDLE child) {
+ Check(!child,"no arbitrary explicit child disconnect");Stops++;
+ INTN row=Target(h);
