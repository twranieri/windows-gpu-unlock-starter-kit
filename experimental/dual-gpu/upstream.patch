+
+    def test_cli_writes_only_non_authorizing_json_and_refuses_existing_output(self):
+        output = self.root / "private-review.json"
+        arguments = ["--first", str(self.first), "--second", str(self.second), "--output", str(output)]
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
