+    agents = {entry['nv_agent'] for entry in result if entry['nv_agent'] is not None}
+    for handle, block in blocks.items():
+        require(not any(edge[1] in agents and edge[3] not in (1, 2, 4) for edge in block['edges']) or handle in all_owned,
+                'NVIDIA driver owns an unrelated protected handle')
+    return blocks, bindings, result
+
+
+def console_analysis(path, cards, graph, envelope):
+    candidates = []
+    for index, card in enumerate(cards):
+        peers = [row for i, row in enumerate(graph) if i != index]
+        context = dict(cards=cards, target_bdf=card['bdf'],
+                       peer_handles=set().union(*(row['owned'] for row in peers)) if peers else set(),
+                       peer_gops=set().union(*(set(row['gops']) for row in peers)) if peers else set())
+        try:
+            value = LEGACY.analyze(path, path.parent, envelope, peer_context=context)
+        except (ValueError, KeyError, StopIteration):
+            continue
+        candidates.append((index, value))
+    require(len(candidates) == 1, 'Need exactly one fully recognized captured console GPU')
+    return candidates[0]
+
+
+def cold_lines(card):
+    chip, plm, g1, g2, g3, wpr, ss0, ss1, memory = (card['mmio'][offset] for offset in LEGACY.COLD)
+    hx = LEGACY.gu_hex
+    return (f'cold state: chip={hx(chip)} plm={hx(plm)} gfw={hx(g1)}/{hx(g2)}/{hx(g3)} '
+            f'WPR2_HI={hx(wpr)} SS0={hx(ss0)} SS1={hx(ss1)}',
+            f'cold observed: chip={hx(chip)} memory={hx(memory)} SS0={hx(ss0)} SS1={hx(ss1)}')
+
+
+def cbytes(data):
+    return '{' + ','.join(f'0x{value:02x}' for value in data) + '}'
+
+
+def target_row(card, meta, console):
+    segment, bus, device, function = (int(value, 16) for value in re.split(r'[:.]', card['bdf']))
+    nv, code = meta['nv'], meta['code']
+    words = '{' + ','.join(f'0x{value:08x}U' for value in card['pci_config']) + '}'
+    sizes = '{' + ','.join(str(len(path)) + 'U' for path in meta['paths']) + '}' if meta['paths'] else '{0}'
+    paths = '{' + ','.join(cbytes(path) for path in meta['paths']) + '}' if meta['paths'] else '{{0}}'
+    values = [f'0x{card["pci_id"]}U', f'0x{card["subsystem"]}U', f'0x{card["chip"]}U', f'0x{card["memory_mib"]:x}U',
+              json.dumps(card['prom_sha256']), f'0x{segment:x}U', f'0x{bus:x}U', f'{device}U', f'{function}U',
+              f'0x{card["bar0"]:x}ULL', words, f'{len(meta["controller"])}U', cbytes(meta['controller']),
+              f'{len(meta["paths"])}U', sizes, paths,
+              f'0x{nv["version"]:x}U' if nv else '0U', f'0x{nv["size"]:x}U' if nv else '0U',
+              f'0x{nv["stop"]-nv["base"]:x}U' if nv else '0U', f'0x{code["bytes"]:x}U' if code else '0U',
+              json.dumps(code['sha256'] if code else ''), str(int(console))]
+    return '{' + ','.join(values) + '}'
+
+
+def make_header(name, defines, cards, graph, console_index, fwsec, *, host_index=None):
+    selected = list(range(len(cards))) if host_index is None else [host_index]
+    primary = console_index if host_index is None else host_index
