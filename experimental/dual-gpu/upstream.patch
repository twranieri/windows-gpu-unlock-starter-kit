diff --git a/internal-boot/unlock/tests/test_target_registry.c b/internal-boot/unlock/tests/test_target_registry.c
new file mode 100644
index 0000000000000000000000000000000000000000..a6441625d36537c0f960671468148b1a99b6366e
--- /dev/null
+++ b/internal-boot/unlock/tests/test_target_registry.c
@@ -0,0 +1,171 @@
+/* GPL-2.0-only. Production discovery/context/coordinator in host RAM only. */
+#include "../port.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef GU_TEST_AMBIGUOUS_TABLE
+#undef GU_CARD_TABLE
+#define GU_CARD_TABLE \
+ {0x220310deU,0x130a7377U,0xb72000a1U,0x5ff4U,"synthetic","A"}, \
+ {0x220310deU,0x130a7377U,0xb72000a1U,0x5ff4U,"synthetic","B"}
+#endif
+#ifdef GU_TEST_IDENTICAL_TABLE
+#undef GU_CARD_TABLE
+#define GU_CARD_TABLE \
+ {0x220310deU,0x130a7377U,0xb72000a1U,0x5ff4U,"synthetic","A"}, \
+ {0x220310deU,0x130a7377U,0xb72000a1U,0x5ff4U,"synthetic","B"}
+#endif
+#ifdef GU_TEST_CAPTURE_PINS
+#define GU_CARD_PINS {0,1,0,0,0x80000000U,TRUE},{0,2,0,0,0x81000000U,FALSE}
+#endif
+#ifdef GU_TEST_CAPTURED_CONSOLE
+/* Use the production captured-console branch with RAM-only immutable rows. */
+#define GU_PROFILE_LOCAL_DUAL 1
+#define GU_PAIR_TARGET_COUNT 2U
+#endif
+#include "../port.c"
+
+typedef struct {EFI_PCI_IO_PROTOCOL io;UINT32 cfg[64];UINTN segment,bus;BOOLEAN child;} NODE;
+static NODE nodes[3];static EFI_BOOT_SERVICES services;
+static UINTN node_count,order[3];static int open_failure,reenter,drift;
+VOID GuLog(const char *format,...){(void)format;}
+static EFI_STATUS EFIAPI release(VOID *p){free(p);return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI locate(EFI_LOCATE_SEARCH_TYPE t,EFI_GUID *g,VOID *key,UINTN *n,EFI_HANDLE **h) {
+  (void)t;(void)g;(void)key;*n=node_count;*h=malloc(node_count*sizeof(**h));assert(*h);
+  for(UINTN i=0;i<node_count;i++)(*h)[i]=&nodes[order[i]];
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI handle(EFI_HANDLE h,EFI_GUID *g,VOID **p){(void)g;*p=&((NODE *)h)->io;return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI config_read(EFI_PCI_IO_PROTOCOL *p,EFI_PCI_IO_PROTOCOL_WIDTH width,UINT32 off,UINTN count,VOID *value) {
+  NODE *node=(NODE *)p;assert(width==EfiPciIoWidthUint32 && off+count*4<=256);
+  if(reenter){reenter=0;assert(GuDiscoverTargets()!=EFI_SUCCESS);}
+  memcpy(value,(UINT8 *)node->cfg+off,count*4);return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI location(EFI_PCI_IO_PROTOCOL *p,UINTN *s,UINTN *b,UINTN *d,UINTN *f) {
+  NODE *node=(NODE *)p;*s=node->segment;*b=node->bus;*d=*f=0;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI opens(EFI_HANDLE h,EFI_GUID *g,EFI_OPEN_PROTOCOL_INFORMATION_ENTRY **entries,UINTN *n) {
+  (void)g;if(open_failure)return EFI_DEVICE_ERROR;
+  NODE *node=h;*entries=NULL;*n=node->child?1:0;
+  if(*n){*entries=malloc(sizeof(**entries));assert(*entries);
+    **entries=(EFI_OPEN_PROTOCOL_INFORMATION_ENTRY){(VOID *)30,(VOID *)40,EFI_OPEN_PROTOCOL_BY_CHILD_CONTROLLER,1};}
+  if(drift){drift=0;node->cfg[4]^=0x1000000U;}
+  return EFI_SUCCESS;
+}
+static void setup(UINTN count) {
+  memset(nodes,0,sizeof(nodes));memset(&services,0,sizeof(services));node_count=count;
+  open_failure=reenter=drift=0;
+  services.LocateHandleBuffer=locate;services.HandleProtocol=handle;services.FreePool=release;services.OpenProtocolInformation=opens;
+  for(UINTN i=0;i<3;i++) {
+    nodes[i].io.Pci.Read=config_read;nodes[i].io.GetLocation=location;nodes[i].bus=1+i;
+    nodes[i].cfg[0]=GuCardTable[i%2].id;nodes[i].cfg[11]=GuCardTable[i%2].subsystem;
+    nodes[i].cfg[1]=3;nodes[i].cfg[2]=0x030000a1U;nodes[i].cfg[4]=0x80000000U+(UINT32)i*0x1000000U;order[i]=i;
+  }
+  GuInit(&services,NULL);Gu.image=(VOID *)99;
+}
+static void refused(void){assert(GuDiscoverTargets()!=EFI_SUCCESS);assert(GuTargetCount()==0);assert(!GuTargetHandleOf(0));}
+static void discovery_tests(void) {
+  setup(2);nodes[0].child=TRUE;order[0]=1;order[1]=0;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetCount()==2);
+  assert(GuTargetHandleOf(0)==&nodes[1] && GuTargetHandleOf(1)==&nodes[0]);
+  assert(GuTargetSpec(0)->subsystem==nodes[1].cfg[11]);
+  assert(GuDiscoverTargets()!=EFI_SUCCESS); /* Registry cannot be reselected. */
+  setup(2);order[0]=1;order[1]=0;assert(GuDiscoverTargets()==EFI_SUCCESS);
+  assert(GuTargetHandleOf(0)==&nodes[0]); /* Stable BDF order, not firmware order. */
+  setup(2);nodes[1].cfg[11]^=1;refused();
+  setup(2);nodes[1].cfg[0]=0x999910deU;refused();
+  setup(3);refused(); /* Never truncate enumeration after the second card. */
+  setup(2);nodes[1].bus=nodes[0].bus;refused();
+  setup(2);order[1]=0;refused();
+  setup(2);nodes[0].child=nodes[1].child=TRUE;refused();
+  setup(2);open_failure=1;refused();
+  setup(2);drift=1;refused();
+  setup(2);reenter=1;refused();
+  setup(1);nodes[0].cfg[1]|=4;refused();
+  setup(1);nodes[0].cfg[4]|=8;refused();
+  setup(1);nodes[0].segment=0x10000;refused();
+  setup(1);nodes[0].bus=0;refused();
+  setup(1);assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetCount()==1);
+}
+static void context_tests(void) {
+  setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS);assert(GuActivate(0)==EFI_SUCCESS);
+  Gu.entry_latched=TRUE;Gu.entry_ss0=123;Gu.entry_ss1=6;Gu.selector_phase=2;Gu.ss1_write_consumed=TRUE;
+  assert(GuActivate(1)==EFI_SUCCESS);assert(!Gu.entry_latched && !Gu.ss1_write_consumed);
+  Gu.entry_ss0=456;assert(GuActivate(0)==EFI_SUCCESS && Gu.entry_ss0==123 && Gu.entry_ss1==6 && Gu.ss1_write_consumed);
+#ifdef GU_UEFI_PORT
+  assert(GU_TARGET_PCI_ID==nodes[0].cfg[0]);
+  assert(GuActivate(1)==EFI_SUCCESS && GU_TARGET_PCI_ID==nodes[1].cfg[0]);
+  assert(GuActivate(0)==EFI_SUCCESS);
+#endif
+  assert(!GuTargetCompleted(&nodes[0]) && !GuTargetCompleted((VOID *)77));
+  Gu.complete=TRUE;assert(GuTargetCompleted(&nodes[0]));
+  assert(GuActivate(1)==EFI_SUCCESS && GuTargetCompleted(&nodes[0]));
+  assert(GuActivate(0)==EFI_SUCCESS);Gu.complete=FALSE;
+  UINT32 cfg[64];memcpy(cfg,nodes[0].cfg,sizeof(cfg));assert(GuTargetConfig(cfg,0,1,0,0));
+  assert(!GuTargetConfig(cfg,0,2,0,0));cfg[11]^=1;assert(!GuTargetConfig(cfg,0,1,0,0));
+  Gu.board_subsystem^=1;assert(GuActivate(1)!=EFI_SUCCESS && Gu.card_index==0);
+  for(int which=0;which<5;which++) {
+    setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS && GuActivate(0)==EFI_SUCCESS);
+    if(which==0)Gu.dma_count=1;if(which==1)Gu.retained=TRUE;if(which==2)Gu.owned=TRUE;
+    if(which==3)Gu.master_attributes_pending=TRUE;if(which==4)Gu.armed=TRUE;
+    assert(GuActivate(1)!=EFI_SUCCESS && Gu.card_index==0);
+  }
+}
+typedef struct {int trace[8],used,fail_pre,fail_run,fail_verify;} FLOW;
+static EFI_STATUS preflight(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=10+(int)i;
+  if((int)i==f->fail_pre)return EFI_DEVICE_ERROR;
+  return GuActivate(i);
+}
+static EFI_STATUS run(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=20+(int)i;
+  EFI_STATUS s=GuActivate(i);if(s!=EFI_SUCCESS)return s;
+  if((int)i==f->fail_run)return EFI_DEVICE_ERROR;
+  Gu.started=Gu.quiesced=Gu.complete=Gu.post_config_valid=TRUE;return EFI_SUCCESS;
+}
+static EFI_STATUS verify(UINTN i,VOID *context) {
+  FLOW *f=context;f->trace[f->used++]=30+(int)i;
+  if((int)i==f->fail_verify)return EFI_DEVICE_ERROR;
+  return GuActivate(i);
+}
+static void coordinator_tests(void) {
+  for(int fail=0;fail<4;fail++) {
+    setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS);
+    FLOW f={{0},0,fail==1?1:-1,fail==2?1:-1,fail==3?0:-1};
+    GU_TARGET_OPS ops={&f,preflight,run,verify};EFI_STATUS s=GuCoordinateTargets(&ops);
+    assert(f.trace[0]==10 && f.trace[1]==11);
+    if(!fail){assert(s==EFI_SUCCESS && f.used==6 && GuAllTargetsComplete());}
+    else if(fail==1){assert(s!=EFI_SUCCESS && f.used==2 && !GuAnyTargetComplete());}
+    else {assert(s!=EFI_SUCCESS && GuAnyTargetComplete());assert(f.used==(fail==2?4:5));}
+  }
+}
+static void capture_pin_tests(void) {
+  setup(2);nodes[0].child=TRUE;order[0]=1;order[1]=0;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetHandleOf(0)==&nodes[1]);
+  assert(GuActivate(0)==EFI_SUCCESS && Gu.bus==2 && Gu.board_subsystem==GuCardTable[1].subsystem);
+  setup(2);nodes[0].child=TRUE;nodes[1].bus=3;refused();
+  setup(2);nodes[0].child=TRUE;nodes[1].cfg[4]+=0x1000000U;refused();
+  setup(1);nodes[0].child=TRUE;refused();
+#ifdef GU_TEST_CAPTURED_CONSOLE
+  setup(2);assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetHandleOf(1)==&nodes[0]);
+  setup(2);nodes[0].child=nodes[1].child=TRUE;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetHandleOf(1)==&nodes[0]);
+  setup(2);nodes[1].child=TRUE;
+  assert(GuDiscoverTargets()==EFI_SUCCESS && GuTargetHandleOf(1)==&nodes[0]);
+#else
+  setup(2);nodes[1].child=TRUE;refused();
+#endif
+  puts("PASS immutable capture BDF/BAR/console/full-set pins (including identical IDs/subsystems)");
+}
+int main(void) {
+#ifdef GU_TEST_AMBIGUOUS_TABLE
+  setup(1);refused();puts("PASS ambiguous immutable table rejected before registration");
+#elif defined(GU_TEST_CAPTURE_PINS)
+  capture_pin_tests();
+#else
+  discovery_tests();context_tests();coordinator_tests();
+  puts("PASS production target discovery, exact subsystem/BDF pins, two-card bound, context isolation and all-card coordinator");
+#endif
+  return 0;
+}
