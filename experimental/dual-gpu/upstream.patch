diff --git a/research/dual/analyze_pair.py b/research/dual/analyze_pair.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e75cee0c2887890de0758c68dd7641e3846c5c6
--- /dev/null
+++ b/research/dual/analyze_pair.py
@@ -0,0 +1,184 @@
+"""Offline validation of experimental one/two-card read-only captures.
+
+This produces private capture evidence, NEVER an arming profile, build permit or
+hardware qualification. Full driver-release/pair replay is a separate gate.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+
+REPO = Path(__file__).resolve().parents[2]
+ALLOWED = frozenset(('220410de', '220310de', '248710de', '250410de', '248410de', '24c910de',
+                     '220a10de', '248210de', '221610de'))
+COLD = (0, 0x823804, 0x118128, 0x118234, 0x110100, 0x1fa828, 0x82381c, 0x823820, 0x1183a4)
+PCI_IO = '4cf5b200-68b8-4ca5-9eec-b23e3f50029a'
+_spec = importlib.util.spec_from_file_location('dual_capture_graph', REPO / 'research/profile/capture_graph.py')
+_graph = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_graph)
+
+
+class Refused(ValueError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise Refused(message)
+
+
+def record(text, prefix, pattern):
+    rows = [line for line in text.splitlines() if line.startswith(prefix)]
+    match = re.fullmatch(pattern, rows[0]) if len(rows) == 1 else None
+    require(match is not None, 'Missing, duplicate or malformed ' + prefix)
+    return match
+
+
+def address_record(text, prefix):
+    match = record(text, prefix, re.escape(prefix) + r' seg=0x([0-9a-f]{1,4}) bus=0x([0-9a-f]{1,4}) dev=0x([0-9a-f]{1,4}) fun=0x([0-9a-f]{1,4})')
+    seg, bus, dev, fun = (int(value, 16) for value in match.groups())
+    require(1 <= bus <= 255 and dev == 0 and fun == 0, 'Target is outside the reviewed endpoint layout')
+    return f'{seg:08x}:{bus:02x}:{dev:02x}.{fun:x}'
+
+
+def resource(raw, base):
+    require(len(raw) == 48, 'Incomplete BAR0 resource')
+    desc, length, kind, _, _, bits, lo, hi, translation, size = struct.unpack('<BHBBBQQQQQ', raw[:46])
+    require((desc, length, kind, bits, lo, translation, size) ==
+            (0x8a, 43, 0, 32, base, 0, 0x1000000), 'Unreviewed BAR0 resource')
+    require(hi in (base + size - 1, 0xffffff) and raw[46] == 0x79 and
+            (raw[47] == 0 or sum(raw) % 256 == 0), 'Invalid BAR0 boundary/checksum')
+
+
+def card(text, ordinal, directory, envelope):
+    bdf = address_record(text, 'probe-target')
+    require(record(text, 'cfg256 ', r'cfg256 status=0x([0-9a-f]{16})')[1] == '0000000000000000', 'PCI snapshot failed')
+    row = record(text, 'cfg dwords=', r'cfg dwords=([0-9a-f ]+)')
+    words = row[1].split()
+    require(len(words) == 64 and all(re.fullmatch('[0-9a-f]{8}', value) for value in words), 'Need 64 exact PCI dwords')
+    cfg = [int(value, 16) for value in words]
+    ident = f'{cfg[0]:08x}'
+    require(ident in ALLOWED and ident in envelope['probe_device_ids'], 'Device ID is outside the pinned kit candidates')
+    require(cfg[2] == int(envelope['class_revision'], 16) and cfg[1] & 6 == 2,
+            'Wrong PCI class/revision or MEM/BME state')
+    require(cfg[11] not in (0, 0xffffffff), 'Missing subsystem identity')
+    subsystem_limits = envelope.get('probe_subsystems', {})
+    require(ident not in subsystem_limits or f'{cfg[11]:08x}' in subsystem_limits[ident],
+            'Subsystem is outside the reviewed deep-probe envelope')
+    base = cfg[4]
+    require(base != 0 and base & 0xffffff == 0, 'BAR0 must be an aligned 32-bit 16MiB window')
+    raw = bytes.fromhex(record(text, 'pci-bar0-resource ', r'pci-bar0-resource raw=([0-9a-f]+)')[1])
+    resource(raw, base)
+    attrs = record(text, 'pci-attributes ', r'pci-attributes status=0x([0-9a-f]{16}) value=0x([0-9a-f]{16})')
+    expected = 0x200 | (0x100 if cfg[1] & 1 else 0)
+    require(int(attrs[1], 16) == 0 and int(attrs[2], 16) & 0x700 == expected, 'PCI attribute/command mismatch')
+    mmio = {}
+    for line in text.splitlines():
+        if not line.startswith('mmio '):
+            continue
+        row = re.fullmatch(r'mmio off=0x([0-9a-f]{1,8}) status=0x([0-9a-f]{1,16}) value=0x([0-9a-f]{1,8})', line)
+        require(row is not None, 'Malformed MMIO record')
+        offset, status, value = (int(value, 16) for value in row.groups())
+        require(offset not in mmio and status == 0, 'Duplicate or failed MMIO observation')
+        mmio[offset] = value
+    require(all(offset in mmio for offset in COLD), 'Incomplete cold-state observations')
+    chip, plm, g1, g2, g3, wpr, ss0, ss1, memory = (mmio[offset] for offset in COLD)
+    chips = [entry for entry in envelope['chips'] if int(entry['chip'], 16) == chip]
+    require(len(chips) == 1 and f'{memory:x}' in chips[0]['pci_memory'].get(ident, []),
+            f'Unreviewed chip/device/VRAM tuple (PCI {ident}, chip 0x{chip:08x}, usable {memory} MiB)')
+    require((plm, g1, g2, g3, wpr) == (0xffffff8f, 0x8b8f, 0x3ff, 0x10, 0) and
+            ss1 <= 15 and ss0 not in (0xffffffff, 0x88888888) and ss0 & 0xffff0000 != 0xbadf0000,
+            'Card is not in the required power-on state')
+    name = record(text, 'prom dump=', r'prom dump=(PROM[0-9]{2}\.BIN)')[1]
+    require(name == f'PROM{ordinal:02d}.BIN', 'PROM filename does not match the BDF-ordered card ordinal')
+    digest = record(text, 'prom sha256=', r'prom sha256=([0-9a-f]{64})')[1]
+    prom_pins = envelope.get('profile_prom_sha256', {})
+    require(ident not in prom_pins or digest in prom_pins[ident],
+            'PROM hash is outside the reviewed device envelope')
+    prom = directory / name
+    require(not prom.is_symlink() and prom.is_file() and prom.stat().st_size == 0x100000, 'Need that card\'s exact 1MiB PROM file')
+    require(hashlib.sha256(prom.read_bytes()).hexdigest() == digest, 'PROM hash mismatch; do not swap cards\' ROM files')
+    return {'bdf': bdf, 'pci_id': ident, 'subsystem': f'{cfg[11]:08x}', 'chip': f'{chip:08x}',
+            'memory_mib': memory, 'bar0': base, 'pci_config': cfg, 'mmio': mmio,
+            'prom_sha256': digest, 'prom_file': name}
+
+
+def capture(path, envelope):
+    path = Path(path)
+    require(not path.is_symlink() and path.is_file() and path.stat().st_size <= 8 * 1024 * 1024, 'Need a bounded regular capture file')
+    raw = path.read_bytes()
+    text = raw.decode('utf-8-sig').replace('\r\n', '\n')
+    require(not any(line.startswith('probe-capture-only') for line in text.splitlines()),
+            'Capture-only observations cannot authorize a write profile')
+    require(text.splitlines().count('dual-probe-v1 max-targets=2 readonly=1') == 1, 'Need the explicit experimental dual-probe format')
+    require(not any(line.startswith('incomplete ') for line in text.splitlines()), 'Probe reported an incomplete capture')
+    try:
+        blocks = _graph.parse_handles(text)
+    except ValueError as error:
+        raise Refused(str(error)) from error
+    parts = re.findall(r'^dual-card-begin index=([0-9a-f]{4})\n(.*?)^dual-card-end index=\1\n', text, re.M | re.S)
+    require(1 <= len(parts) <= 2 and len(re.findall(r'^dual-card-(?:begin|end)', text, re.M)) == 2 * len(parts), 'Need one or two closed card records')
+    require([index for index, _ in parts] == [f'{index:04x}' for index in range(len(parts))], 'Duplicate or unordered card ordinal')
+    summary = record(text, 'probe targets=', r'probe targets=([0-9a-f]{4}) cfg-incomplete=([0-9a-f]{4})')
+    require(int(summary[1], 16) == len(parts) and int(summary[2], 16) == 0 and
+            len(re.findall(r'^probe-target ', text, re.M)) == len(parts), 'Probe cardinality disagrees with the pair records')
+    cards = [card(section, ordinal, path.parent, envelope) for ordinal, (_, section) in enumerate(parts)]
+    bdfs = [entry['bdf'] for entry in cards]
+    require(bdfs == sorted(set(bdfs)), 'Cards must have unique, sorted physical BDFs')
+    for index, entry in enumerate(cards):
+        for peer in cards[index + 1:]:
+            require(abs(entry['bar0'] - peer['bar0']) >= 0x1000000, 'Target BAR0 windows overlap')
+    graph_cards = {}
+    for block in blocks.values():
+        if PCI_IO not in block['protocols']:
+            continue
+        row = record(block['raw'], 'pci config-dwords=', r'pci config-dwords=([0-9a-f ]+)')
+        cfg = [int(value, 16) for value in row[1].split()]
+        if cfg[0] & 0xffff != 0x10de or cfg[2] >> 24 != 3:
+            continue
+        location = record(block['raw'], 'pci location-status=', r'pci location-status=0x([0-9a-f]{1,16}) segment=0x([0-9a-f]{1,16}) bus=0x([0-9a-f]{1,16}) device=0x([0-9a-f]{1,16}) function=0x([0-9a-f]{1,16})')
+        status, seg, bus, dev, fun = (int(value, 16) for value in location.groups())
+        bdf = f'{seg:08x}:{bus:02x}:{dev:02x}.{fun:x}'
+        require(status == 0 and seg <= 0xffff and 1 <= bus <= 255 and dev == 0 and fun == 0 and bdf not in graph_cards, 'Ambiguous graph PCI identity')
+        graph_cards[bdf] = cfg
+    require(set(graph_cards) == set(bdfs), 'Whole graph contains a missing, extra or different NVIDIA controller')
+    for entry in cards:
+        require(graph_cards[entry['bdf']] == entry['pci_config'][:16], 'Graph and deep capture disagree on a card')
+    return {'cards': cards, 'capture_sha256': hashlib.sha256(raw).hexdigest()}
+
+
+def analyze(first, second, envelope):
+    require(Path(first).resolve() != Path(second).resolve(), 'Two different capture files are required')
+    before, after = capture(first, envelope), capture(second, envelope)
+    require(before['cards'] == after['cards'], 'The complete installed card set changed between captures')
+    return {'schema': 'dual-capture-review-v1', 'can_unlock': False, 'can_build_write_efi': False,
+            'physical_qualification': False, 'card_count': len(before['cards']), 'cards': before['cards'],
+            'captures': [before['capture_sha256'], after['capture_sha256']],
+            'pending': ['Exact driver-code and whole-pair ownership/release replay',
+                        'Per-card actual-PROM/firmware host transaction jobs',
+                        'Supervised physical two-card boot and per-card measurements']}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--first', required=True, type=Path)
+    parser.add_argument('--second', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path, help='New private JSON filename; never an arming profile')
+    args = parser.parse_args(argv)
+    envelope = json.loads((REPO / 'research/profile/proven.json').read_text(encoding='utf-8'))
+    try:
+        result = analyze(args.first, args.second, envelope)
+        with args.output.open('x', encoding='utf-8') as stream:
+            json.dump(result, stream, indent=2)
+            stream.write('\n')
+    except (OSError, ValueError) as error:
+        parser.exit(1, 'Capture review refused: ' + str(error) + '\n')
+    print(f"Reviewed {result['card_count']} candidate card(s); no write build or unlock is authorized. Keep the JSON private.")
+
+
+if __name__ == '__main__':
+    main()
