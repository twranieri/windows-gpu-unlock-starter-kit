+# GPL-2.0-only. Exact-input evidence gate for generated LOCAL one/two-card profiles.
+# Dot-source local-profile.ps1 first. These functions never access hardware.
+function Get-DualExpectedJobs([bool]$Console,[bool]$NoEdidDriver=$false,[bool]$ConsoleAggregate=$false) {
+ if($Console){
+  $jobs=[ordered]@{}
+  foreach($entry in (Get-LocalExpectedJobs $NoEdidDriver $ConsoleAggregate).GetEnumerator()) {
+   $name=switch -Exact ($entry.Key) {
+    'r2 console replay (real graph)' {'pair console prepare replay (real graph)'}
+    'r2 replay other profile (must reject)' {'pair console wrong profile (must reject)'}
+    default {if($entry.Key.StartsWith('release replay,')){'pair console release replay (real graph)'}else{$entry.Key}}
+   }
+   $jobs[$name]=$entry.Value
+  }
+  return $jobs
+ }
+ return [ordered]@{'checks (real config)'=0;'checks other profile (must reject)'=1;
+  'port'=0;'fresh PCI identity'=0;'write-lock'=0;'master-attributes'=0;'runtime'=0;
+  'profile-lock-entryLatchedSs1Full'=0;'profile-lock-entryLatchedSs1Preserve'=0;
+  'cold pre-check (read-only)'=0;'core transaction (efi)'=0}
+}
+function Get-DualExpectedPairJobs {
+ return [ordered]@{'target registry and coordinator'=0;'pair wrapper replay (real graph)'=0;'pair child policy replay (real graph)'=0}
+}
+function Assert-DualJobMetadata([string]$Repo,$Job,$Inputs) {
+ if($Job.Kind -isnot [string] -or $Job.Kind -cnotin @('compiled','interpreted') -or
+    $Job.Adapter -isnot [string] -or $Job.Command -isnot [array] -or $Job.Command.Count -lt 1 -or $Job.Command.Count -gt 256 -or
+    $Job.CompileCommand -isnot [array] -or $Job.CompileCommand.Count -gt 256 -or !(Test-GuExactInteger $Job.CompileExit 0)){throw 'Missing or invalid actual host command metadata'}
+ $adapterPath=Assert-DualRegularFile $Repo $Job.Adapter
+ if(!(@($Inputs.Path) -ccontains $Job.Adapter)){throw 'Host job adapter is not bound to the tested source inventory'}
+ foreach($part in @($Job.Command)+@($Job.CompileCommand)) {
+  if($part -isnot [string] -or !$part -or $part.Length -gt 32768){throw 'Invalid host command argument'}
+ }
+ $arguments=if($Job.Kind -ceq 'compiled'){@($Job.CompileCommand)}else{@($Job.Command)}
+ if(($Job.Kind -ceq 'compiled' -and $Job.CompileCommand.Count -lt 2) -or
+    ($Job.Kind -ceq 'interpreted' -and $Job.CompileCommand.Count -ne 0)){throw 'Host job compilation metadata disagrees with its kind'}
+ $matched=$false
+ foreach($part in $arguments){if($part.Replace('\','/') -ceq $adapterPath.Replace('\','/') -or $part -ceq $Job.Adapter){$matched=$true}}
+ if(!$matched){throw 'Recorded actual command does not select its declared source adapter'}
+}
+function Assert-DualRegularFile([string]$Repo,[string]$Relative) {
+ if(!$Relative -or $Relative.Contains('\') -or $Relative.StartsWith('/') -or $Relative -match '(^|/)\.\.(/|$)|:'){throw 'Unsafe pair input path'}
+ $path=Join-Path $Repo $Relative
+ $cursor=$Repo
+ foreach($component in $Relative.Split('/')) {
+  if(!$component -or $component -eq '.'){throw 'Unsafe pair input component'}
+  $cursor=Join-Path $cursor $component
+  $item=Get-Item -LiteralPath $cursor -Force
+  if($item.Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Indirect pair input path'}
+ }
+ if(!(Test-Path -LiteralPath $path -PathType Leaf)){throw 'Missing pair input file'}
+ return $path
+}
+function Get-DualProfile([string]$Repo) {
+ $header=Assert-DualRegularFile $Repo 'internal-boot/unlock/profile-local-dual.h'
+ $reportPath=Assert-DualRegularFile $Repo 'research/dual/local/pair.json'
+ $text=[IO.File]::ReadAllText($header).Replace("`r`n","`n")
+ $report=Get-Content -LiteralPath $reportPath -Raw | ConvertFrom-Json
+ if(!(Test-GuExactInteger $report.Format 2) -or !(Test-GuExactInteger $report.GeneratorVersion 2) -or
+    $report.HardwareTested -isnot [bool] -or $report.HardwareTested -or
+    $report.ProfileName -cnotmatch '^LOCAL-DUAL-[0-9a-f]{16}$' -or
+    $report.HeaderSha256 -cne (Get-GuSha256 $header)){throw 'Invalid generated pair report/header identity'}
+ if($text -cnotmatch '(?m)^#define GU_LOCAL_PAIR_GENERATOR 2$' -or
+    $text -cnotmatch ('(?m)^#define GU_PROFILE_NAME "'+[regex]::Escape($report.ProfileName)+'"$')){throw 'Missing generated pair header marker/name'}
+ $cards=@($report.Cards)
+ if($cards.Count -lt 1 -or $cards.Count -gt 2 -or
+    $text -cnotmatch ('(?m)^#define GU_PAIR_TARGET_COUNT '+$cards.Count+'U?$')){throw 'Pair target cardinality mismatch'}
+ $consoleCount=0;$ids=@();$subs=@();$chips=@();$memory=@();$proms=@();$seen=@{}
+ for($i=0;$i -lt $cards.Count;$i++) {
+  $card=$cards[$i]
+  if(!(Test-GuExactInteger $card.Index $i) -or $card.Console -isnot [bool] -or
+     $card.NoEdidDriver -isnot [bool] -or $card.ConsoleAggregate -isnot [bool] -or
+     $card.PciId -cnotmatch '^[0-9a-f]{8}$' -or $card.Subsystem -cnotmatch '^[0-9a-f]{8}$' -or
+     $card.PromSha256 -cnotmatch '^[0-9a-f]{64}$' -or $card.HeaderSha256 -cnotmatch '^[0-9a-f]{64}$' -or
+     $card.Bdf -cnotmatch '^(0000)?[0-9a-f]{4}:[0-9a-f]{2}:00\.0$' -or $seen.ContainsKey($card.Bdf) -or
+     $card.HeaderFile -cne ('internal-boot/unlock/profile-local-dual-card'+$i+'.h')){throw 'Invalid pair card identity or duplicate BDF'}
+  $seen[$card.Bdf]=$true
+  $cardHeader=Assert-DualRegularFile $Repo $card.HeaderFile
+  if((Get-GuSha256 $cardHeader) -cne $card.HeaderSha256){throw 'Pair card header changed'}
+  if($card.Console){$consoleCount++;if(!(Test-GuExactInteger $report.ConsoleCardIndex $i)){throw 'Pair console index mismatch'}}
+  $ids+=$card.PciId;$subs+=$card.Subsystem;$chips+=$card.Chip;$memory+=$card.MemoryMiB;$proms+=$card.PromSha256
+ }
+ if($consoleCount -ne 1){throw 'Exactly one captured pair console is required'}
+ $fixtureNames=@(Get-LocalObjectNames $report.Fixtures)
+ if($fixtureNames.Count -lt ($cards.Count*3+1)){throw 'Missing pair fixtures'}
+ foreach($name in $fixtureNames) {
+  if($name -cnotmatch '^research/dual/local/(fixtures|captures)/'){throw 'Pair fixture outside private capture root'}
+  $digest=$report.Fixtures.$name
+  if($digest -isnot [string] -or $digest -cnotmatch '^[0-9a-f]{64}$' -or (Get-GuSha256 (Assert-DualRegularFile $Repo $name)) -cne $digest){throw 'Pair fixture changed'}
+ }
+ for($i=0;$i -lt $cards.Count;$i++) {
+  foreach($suffix in @('PROM.BIN','probe/REPORT.TXT','cold/REPORT.TXT')) {
+   $name=('research/dual/local/fixtures/cards/{0:d4}/{1}' -f $i,$suffix)
+   if(!($fixtureNames -ccontains $name)){throw 'Pair per-card fixture missing'}
+   if($suffix -eq 'PROM.BIN' -and $report.Fixtures.$name -cne $cards[$i].PromSha256){throw 'Pair PROM mismatch'}
+  }
+ }
+ return [ordered]@{Define=@('-DGU_PROFILE_LOCAL','-DGU_PROFILE_LOCAL_DUAL');Name=$report.ProfileName;
+  TargetPci=($ids -join '+');Subsystem=($subs -join '+');Chip=($chips -join '+');Memory=($memory -join '+');Prom=($proms -join '+');
+  HeaderSha256=$report.HeaderSha256;Report=$report;HeadlessOnly=$true;UsbOnly=$true;TargetCount=$cards.Count}
+}
+function Get-DualTreeInputs([string]$Repo) {
+ $inputs=[Collections.Generic.Dictionary[string,string]]::new([StringComparer]::Ordinal)
+ foreach($entry in @(Get-LocalTreeInputs $Repo)){$inputs[$entry.Path]=$entry.Sha256}
+ foreach($f in (Get-ChildItem -LiteralPath (Join-Path $Repo 'research/dual') -Recurse -File)) {
+  $rel=$f.FullName.Substring($Repo.TrimEnd('\','/').Length+1).Replace('\','/')
+  if($rel -match '^research/dual/(local|build)/' -or $f.Extension -notmatch '^\.(c|h|py|json|ps1)$'){continue}
+  $inputs[$rel]=Get-GuSha256 (Assert-DualRegularFile $Repo $rel)
+ }
+ [string[]]$paths=@($inputs.Keys);[Array]::Sort($paths,[StringComparer]::Ordinal)
+ foreach($path in $paths){[pscustomobject][ordered]@{Path=$path;Sha256=$inputs[$path]}}
+}
+function Assert-DualProfileEvidence([string]$Repo) {
+ $hw=Get-DualProfile $Repo
+ $path=Assert-DualRegularFile $Repo 'research/dual/local/test-results.json'
+ $e=Get-Content -LiteralPath $path -Raw | ConvertFrom-Json
+ if(!(Test-GuExactInteger $e.Format 3) -or $e.AllPassed -isnot [bool] -or !$e.AllPassed -or
+    $e.HardwareAccess -isnot [bool] -or $e.HardwareAccess -or $e.ProfileName -cne $hw.Name -or
+    $e.HeaderSha256 -cne $hw.HeaderSha256 -or
+    $e.ProfileReportSha256 -cne (Get-GuSha256 (Join-Path $Repo 'research/dual/local/pair.json'))){throw 'Pair evidence identity/type mismatch'}
+ $inputs=@(Get-DualTreeInputs $Repo)
+ if(@($e.Inputs).Count -ne $inputs.Count){throw 'Pair tested input count changed'}
+ for($i=0;$i -lt $inputs.Count;$i++) {
+  if($e.Inputs[$i].Path -cne $inputs[$i].Path -or $e.Inputs[$i].Sha256 -cne $inputs[$i].Sha256){throw 'Pair tested source input changed'}
+ }
+ if($e.TreeSha256 -cne (Get-LocalInputDigest $inputs)){throw 'Pair tested input digest changed'}
+ if(@($e.Cards).Count -ne $hw.TargetCount){throw 'Missing pair card jobs'}
+ for($i=0;$i -lt $hw.TargetCount;$i++) {
+  $card=$hw.Report.Cards[$i];$entry=$e.Cards[$i]
+  if(!(Test-GuExactInteger $entry.Index $i)){throw 'Pair evidence card index mismatch'}
+  $jobs=Get-DualExpectedJobs $card.Console $card.NoEdidDriver $card.ConsoleAggregate
+  Assert-LocalKeys $entry.Results @($jobs.Keys) 'Pair per-card jobs'
+  foreach($name in $jobs.Keys) {
+   if(!(Test-GuExactInteger $entry.Results.$name.Exit $jobs[$name]) -or !(Test-GuExactInteger $entry.Results.$name.Expected $jobs[$name])){throw 'Pair card host job failed or missing'}
+   Assert-DualJobMetadata $Repo $entry.Results.$name $inputs
+  }
+ }
+ $jobs=Get-DualExpectedPairJobs
+ Assert-LocalKeys $e.PairResults @($jobs.Keys) 'Pair replay jobs'
+ foreach($name in $jobs.Keys) {
+  if(!(Test-GuExactInteger $e.PairResults.$name.Exit 0) -or !(Test-GuExactInteger $e.PairResults.$name.Expected 0)){throw 'Pair replay failed or missing'}
+  Assert-DualJobMetadata $Repo $e.PairResults.$name $inputs
+ }
+ return $e
+}
+function Assert-DualProfilePackage([string]$Repo,$Manifest) {
+ $hw=Get-DualProfile $Repo;$e=Assert-DualProfileEvidence $Repo
+ if($Manifest.HardwareProfile -cne $hw.Name -or $Manifest.LocalProfileHeaderSha256 -cne $hw.HeaderSha256 -or
+    $Manifest.LocalProfileTreeSha256 -cne $e.TreeSha256 -or
+    $Manifest.LocalProfileEvidenceSha256 -cne (Get-GuSha256 (Join-Path $Repo 'research/dual/local/test-results.json'))){throw 'Pair USB package inputs or evidence changed'}
+}
