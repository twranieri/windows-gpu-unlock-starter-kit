+  for(int i=0;i<Owners;i++)(*out)[i]=(EFI_OPEN_PROTOCOL_INFORMATION_ENTRY){node->Agent,h,EFI_OPEN_PROTOCOL_BY_DRIVER,1};
+  return EFI_SUCCESS;
+}
+static void setup(void){
+  check(!Live,"all previous EFI buffers released");memset(Nodes,0,sizeof(Nodes));memset(Drivers,0,sizeof(Drivers));memset(&Bs,0,sizeof(Bs));memset(&Table,0,sizeof(Table));
+  NodeCount=GU_PAIR_COUNT;Mode=OK;ReplaceInterface=ResourceMode=0;Owners=1;
+  Bs.LocateHandleBuffer=locate;Bs.HandleProtocol=handle;Bs.FreePool=free_pool;Bs.AllocatePool=allocate;Bs.OpenProtocolInformation=opens;Table.BootServices=&Bs;
+  for(UINTN i=0;i<3;i++){
+    UINTN row=i<GU_PAIR_COUNT?i:0;const GU_PAIR_TARGET *p=&GuPairTargets[row];NODE *n=&Nodes[i];
+    n->Io.Pci.Read=config_read;n->Io.GetLocation=location;n->Io.Attributes=attributes;n->Io.GetBarAttributes=bar;n->Io.Mem.Read=mem_read;
+    memcpy(n->Config,p->Config,sizeof(n->Config));memcpy(n->Path,p->ControllerPath,p->ControllerBytes);n->Bus=i+1;n->Attrs=EFI_PCI_IO_ATTRIBUTE_MEMORY;n->PromByte=(UINT8)row;n->Agent=&Drivers[row].Binding;Order[i]=i;
+    UINT32 values[]={p->Chip,p->Memory,0x03000062,6,0x8b8f,0x3ff,0x10,0,0xffffff8f};memcpy(n->Regs,values,sizeof(values));
+  }
+  for(UINTN i=0;i<GU_PAIR_COUNT;i++){
+    const GU_PAIR_TARGET *p=&GuPairTargets[i];DRIVER *d=&Drivers[i];
+    memcpy(GopPaths[i],p->ChildPaths[0],p->ChildBytes[0]);
+#ifdef GU_TEST_DISTINCT_DRIVERS
+    if(i)memset(d->Code+0x280,0x11,64);
+#endif
+    d->Binding.DriverBindingHandle=&d->Binding;d->Binding.ImageHandle=&d->Image;d->Binding.Version=p->NvgopVersion;
+    d->Binding.Stop=(EFI_DRIVER_BINDING_STOP)(UINTN)(d->Code+p->NvgopStop);
+    d->Image.ImageBase=d->Code;d->Image.ImageSize=sizeof(d->Code);d->Image.ImageCodeType=EfiBootServicesCode;d->Image.FilePath=(VOID *)d->Path;
+    const CHAR16 name[]=L"nvgop-ga1xx";d->Path[0]=4;d->Path[1]=4;d->Path[2]=4+sizeof(name);memcpy(d->Path+4,name,sizeof(name));d->Path[4+sizeof(name)]=0x7f;d->Path[5+sizeof(name)]=0xff;d->Path[6+sizeof(name)]=4;
+  }
+  OtherInterface=Nodes[0].Io;
+}
+static void refused(const char *name){check(GuPairCheck(&Table,FALSE,TRUE)!=EFI_SUCCESS,name);check(!Live,"failed check releases owned buffers");}
+int main(void){
+  setup();check(GuPairCheck(&Table,FALSE,TRUE)==EFI_SUCCESS,"captured cold cards and driver fingerprints accepted");
+  setup();Order[0]=GU_PAIR_COUNT-1;Order[GU_PAIR_COUNT-1]=0;check(GuPairCheck(&Table,FALSE,TRUE)==EFI_SUCCESS,"firmware enumeration order does not select the card");
+  setup();NodeCount=3;refused("third card rejected");
+  setup();NodeCount=GU_PAIR_COUNT-1;refused("missing card rejected");
+  setup();Nodes[0].Config[0]=0x999910deU;refused("unknown NVIDIA identity rejected");
+  setup();Nodes[0].Config[11]^=1;refused("wrong subsystem rejected");
+  setup();Nodes[0].Bus=9;refused("wrong physical BDF rejected");
+  setup();Nodes[0].Config[4]^=0x1000000;refused("wrong BAR rejected");
+  setup();Nodes[0].Path[17]^=1;refused("controller ancestry change rejected");
+#if GU_TEST_CARD_COUNT == 2
+  setup();Nodes[1].Bus=Nodes[0].Bus;refused("duplicate BDF rejected");
+  setup();Order[1]=0;refused("duplicate controller handle rejected");
+  setup();Nodes[1].Config[4]=Nodes[0].Config[4];refused("overlapping BAR rejected");
+  setup();Nodes[1].PromByte=Nodes[0].PromByte;refused("peer ROM swapped rejected");
+  setup();Nodes[1].Agent=Nodes[0].Agent;
+#ifdef GU_TEST_DISTINCT_DRIVERS
+  refused("shared agent cannot satisfy a different per-card code fingerprint");
+#else
+  check(GuPairCheck(&Table,FALSE,TRUE)==EFI_SUCCESS,"one shared driver agent with both captured code fingerprints accepted");
+#endif
+  setup();check(GuPairPeerGop(&Bs,&GopTokens[1])==1,"exact captured peer GOP accepted");
+  GopPaths[1][28]^=1;check(GuPairPeerGop(&Bs,&GopTokens[1])<0,"same root port with wrong ADR is not peer approval");
+  setup();GopPaths[1][35]=1;check(GuPairPeerGop(&Bs,&GopTokens[1])<0,"malformed peer path rejected");
+#endif
+  setup();check(GuPairPeerGop(&Bs,&GopTokens[0])<0,"console GOP is never treated as an untouched peer");
+  for(int mode=ROM_BAD;mode<=FREE_FAIL;mode++){setup();Mode=mode;refused("ROM/read/allocation/free failure rejects authorization");}
+  for(int mode=PEER_CONFIG;mode<=CHECK_REENTRY;mode++){setup();Mode=mode;refused("last-card callback drift or pair reentry rejected");}
+  setup();Mode=INVENTORY_REENTRY;refused("inventory callback reentry rejected");
+  setup();Mode=DRIVER_DRIFT;refused("binding changed during loaded-image callback rejected");
+  setup();Mode=DRIVER_REENTRY;refused("driver callback reentry rejected");
+  setup();ResourceMode=1;check(GuPairCheck(&Table,FALSE,TRUE)==EFI_SUCCESS,"nonzero valid BAR descriptor checksum accepted");
+  setup();ResourceMode=2;refused("bad BAR descriptor checksum rejected");
+  setup();ResourceMode=3;refused("wrong BAR descriptor length rejected");
+  setup();Nodes[0].Attrs|=EFI_PCI_IO_ATTRIBUTE_BUS_MASTER;refused("cached bus-master enable rejected");
+  setup();Nodes[0].Config[1]|=4;refused("hardware bus-master enable rejected");
+  setup();Nodes[0].Regs[2]=0x88888888;refused("already modified cold selector rejected");
+  setup();Nodes[0].Regs[3]=16;refused("out of range cold selector rejected");
+  setup();Nodes[0].Regs[7]=1;refused("noncold WPR2 rejected");
+  setup();Nodes[0].Regs[1]^=1;refused("wrong VRAM rejected");
+  setup();Owners=0;refused("missing captured NVIDIA driver owner rejected");
+  setup();Owners=2;refused("duplicate NVIDIA driver owners rejected");
+  setup();Drivers[0].Code[0x280]^=1;refused("actual loaded driver text hash is checked");
+  setup();Drivers[0].Binding.Version^=1;refused("driver version mismatch rejected");
+  setup();Drivers[0].Image.ImageCodeType=EfiRuntimeServicesCode;refused("wrong loaded image code type rejected");
+  setup();Drivers[0].Path[5]^=1;refused("wrong loaded NVIDIA image path rejected");
+  setup();for(UINTN i=0;i<GU_PAIR_COUNT;i++){Nodes[i].Regs[2]=0x88888888;Nodes[i].Regs[3]=8;Nodes[i].Config[32]=0;}
+  check(GuPairCheck(&Table,TRUE,FALSE)==EFI_SUCCESS,"all final selectors and only allowed preexisting PCIe status clearing accepted");
+  Nodes[0].Regs[3]=7;check(GuPairCheck(&Table,TRUE,FALSE)!=EFI_SUCCESS,"every final selector must match target");
+  check(!Live,"no EFI buffer leak");printf("PASS pair-policy %zu card(s): %d checks; fake EFI RAM only\n",(size_t)GU_PAIR_COUNT,Checks);return 0;
+}
diff --git a/internal-boot/boot/test_probe_dual.c b/internal-boot/boot/test_probe_dual.c
new file mode 100644
index 0000000000000000000000000000000000000000..bd5f0e14b73a5a4534505a913ec4d90c5e974b37
--- /dev/null
+++ b/internal-boot/boot/test_probe_dual.c
@@ -0,0 +1,216 @@
+/* GPL-2.0-only. Real dual probe, RAM-only EFI services. No hardware APIs. */
+#define GU_PROBE_PARENT_FIXTURE
+#include "test_probe_generic.c"
+#undef main
+
+enum {D_OK,D_SINGLE,D_THIRD,D_UNKNOWN,D_DUP_BDF,D_DUP_IO,D_BAD_RESOURCE,D_BME,
+      D_PEER_ATTR,D_PEER_CALLBACK,D_THIRD_LATE,D_SHORT_CFG,D_PEER_AFTER_PROM,
+      D_SHORT_DUMP,D_BAD_LOCATION,D_ENUM_REVERSED,D_ADDED_MODELS,D_FOREIGN_3070TI,
+      D_MAXSUN_2216,D_CAPTURE_2206,D_CAPTURE_2216_GIGABYTE,D_CAPTURE_2216_MSI,
+      D_FOREIGN_2216,D_CAPTURE_BAD_RESOURCE,D_CAPTURE_BAD_ATTR,D_BAD_CHIP,D_SHORT_CHIP,D_CHIP_DRIFT};
+static EFI_PCI_IO_PROTOCOL Cards[3];
+static EFI_HANDLE CardHandles[3]={(VOID *)101,(VOID *)102,(VOID *)103};
+static UINT32 Configs[3][64];
+static UINTN Segments[3],Buses[3],CardCount;
+static int DualMode,PciEnums,CardRegs[3],CardProm[3],PromCreates[2];
+static UINT32 DumpWords[2];
+static UINT8 DumpBytes[2][0x100000];
+static EFI_FILE_PROTOCOL PromFiles[2];
+static int CardIndex(EFI_PCI_IO_PROTOCOL *io){for(int i=0;i<3;i++)if(io==&Cards[i])return i;return -1;}
+static EFI_STATUS EFIAPI DualRead(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT32 at,UINTN n,VOID *data) {
+  int i=CardIndex(io);if(i<0)return EFI_NOT_FOUND;
+  if(w==EfiPciIoWidthUint8){*(UINT8 *)data=0;return EFI_SUCCESS;}
+  if(w!=EfiPciIoWidthUint32 || (at&3U) || at/4+n>64)return EFI_UNSUPPORTED;
+  UINTN count=n;
+  if(DualMode==D_SHORT_CFG && i==1 && n==64)count=3; /* partial success is not a valid snapshot */
+  for(UINTN j=0;j<count;j++)((UINT32 *)data)[j]=Configs[i][at/4+j];
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualLocation(EFI_PCI_IO_PROTOCOL *io,UINTN *seg,UINTN *bus,UINTN *dev,UINTN *fun) {
+  int i=CardIndex(io);if(i<0)return EFI_NOT_FOUND;
+  *seg=Segments[i];*bus=Buses[i];*dev=0;*fun=0;
+  return DualMode==D_BAD_LOCATION && i==1?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualMem(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_WIDTH w,UINT8 bar,UINT64 at,UINTN n,VOID *data) {
+  int i=CardIndex(io);(void)n;if(i<0 || w!=EfiPciIoWidthUint32 || bar)return EFI_UNSUPPORTED;
+  if(at>=0x300000 && at<0x400000){CardProm[i]++;S.PromReads++;}
+  else{CardRegs[i]++;S.RegReads++;}
+  BOOLEAN tenGiB=Configs[i][0]==0x220610deU || Configs[i][0]==0x221610deU;
+  UINT32 value=(UINT32)at+((UINT32)i<<28);
+  switch(at){
+    case 0:
+      if(tenGiB && DualMode==D_SHORT_CHIP)return EFI_SUCCESS;
+      if(tenGiB && DualMode==D_CHIP_DRIFT)Configs[0][11]^=1U;
+      value=tenGiB?(DualMode==D_BAD_CHIP?0xb74000a1U:0xb72000a1U):(i==1?0xb74000a1U:0xb72000a1U);
+      break;
+    case 0x823804:value=0xffffff8fU;break;
+    case 0x118128:value=0x8b8fU;break;
+    case 0x118234:value=0x3ffU;break;
+    case 0x110100:value=0x10U;break;
+    case 0x1fa828:value=0;break;
+    case 0x82381c:value=0x03000062U;break;
+    case 0x823820:value=6;break;
+    case 0x1183a4:value=tenGiB?0x2800U:(i==1?0x2000U:(DualMode==D_ADDED_MODELS?0x3000U:0x6000U));break;
+  }
+  *(UINT32 *)data=value;
+  if(DualMode==D_PEER_AFTER_PROM && i==1 && CardProm[i]==PROM_DWORDS)Configs[0][11]^=1U;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualBar(EFI_PCI_IO_PROTOCOL *io,UINT8 index,UINT64 *supports,VOID **out) {
+  int i=CardIndex(io);(void)index;(void)supports;if(i<0)return EFI_NOT_FOUND;
+  UINT8 *raw=calloc(1,sizeof(EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR)+2);if(!raw)return EFI_OUT_OF_RESOURCES;
+  EFI_ACPI_ADDRESS_SPACE_DESCRIPTOR *d=(VOID *)raw;
+  d->Desc=ACPI_ADDRESS_SPACE_DESCRIPTOR;d->Len=sizeof(*d)-3;d->AddrSpaceGranularity=32;
+  d->AddrRangeMin=Configs[i][4];d->AddrRangeMax=(UINT64)Configs[i][4]+0xffffff;
+  d->AddrLen=(DualMode==D_BAD_RESOURCE || DualMode==D_CAPTURE_BAD_RESOURCE) && i==0?0x800000:0x1000000;
+  raw[sizeof(*d)]=ACPI_END_TAG_DESCRIPTOR;*out=raw;return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualAttr(EFI_PCI_IO_PROTOCOL *io,EFI_PCI_IO_PROTOCOL_ATTRIBUTE_OPERATION op,UINT64 mask,UINT64 *value) {
+  int i=CardIndex(io);
+  if(i<0 || op!=EfiPciIoAttributeOperationGet || mask || !value){AttributeOthers++;return EFI_UNSUPPORTED;}
+  AttributeGets++;*value=DualMode==D_CAPTURE_BAD_ATTR && i==0?0x300:0x200;
+  if(i==1 && DualMode==D_PEER_ATTR)Configs[0][11]^=1U;
+  if(i==1 && DualMode==D_PEER_CALLBACK)Cards[0].Mem.Read=NULL;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualLocate(EFI_LOCATE_SEARCH_TYPE search,EFI_GUID *g,VOID *key,UINTN *n,EFI_HANDLE **out) {
+  if(g && !memcmp(g,&WantPci,sizeof(*g))){
+    PciEnums++;UINTN count=CardCount;
+    if(DualMode==D_THIRD_LATE && PciEnums>1)count=3;
+    EFI_HANDLE *list=malloc(count*sizeof(*list));if(!list)return EFI_OUT_OF_RESOURCES;
+    for(UINTN i=0;i<count;i++)list[i]=CardHandles[(DualMode==D_ENUM_REVERSED && (PciEnums&1))?count-1-i:i];
+    *out=list;*n=count;return EFI_SUCCESS;
+  }
+  if(search==AllHandles){
+    EFI_HANDLE *list=malloc((CardCount+1)*sizeof(*list));if(!list)return EFI_OUT_OF_RESOURCES;
+    for(UINTN i=0;i<CardCount;i++)list[i]=CardHandles[i];list[CardCount]=GraphHandle;
+    *out=list;*n=CardCount+1;return EFI_SUCCESS;
+  }
+  return GenericLocate(search,g,key,n,out);
+}
+static EFI_STATUS EFIAPI DualHandle(EFI_HANDLE h,EFI_GUID *g,VOID **out) {
+  for(UINTN i=0;i<3;i++)if(h==CardHandles[i] && !memcmp(g,&WantPci,sizeof(*g))){
+    *out=DualMode==D_DUP_IO && i==1?&Cards[0]:&Cards[i];return EFI_SUCCESS;
+  }
+  return GenericHandle(h,g,out);
+}
+static EFI_STATUS EFIAPI DualProtocols(EFI_HANDLE h,EFI_GUID ***out,UINTN *n) {
+  for(UINTN i=0;i<CardCount;i++)if(h==CardHandles[i]){
+    EFI_GUID **p=malloc(sizeof(*p));if(!p)return EFI_OUT_OF_RESOURCES;
+    p[0]=&WantPci;*out=p;*n=1;return EFI_SUCCESS;
+  }
+  return Protocols(h,out,n);
+}
+static int SameName(const CHAR16 *a,const CHAR16 *b){while(*a && *a==*b){a++;b++;}return *a==*b;}
+static EFI_STATUS EFIAPI DualDumpWrite(EFI_FILE_PROTOCOL *f,UINTN *n,VOID *data) {
+  int slot=f==&PromFiles[0]?0:1;DumpWords[slot]=*(UINT32 *)data;Dumps++;
+  if(*n<=sizeof(DumpBytes[slot]))memcpy(DumpBytes[slot],data,*n);
+  if(DualMode==D_SHORT_DUMP)(*n)--;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DualOpen(EFI_FILE_PROTOCOL *root,EFI_FILE_PROTOCOL **out,CHAR16 *name,UINT64 mode,UINT64 attrs) {
+  int slot=SameName(name,L"\\RTX3090-UNLOCK\\PROM00.BIN")?0:
+    (SameName(name,L"\\RTX3090-UNLOCK\\PROM01.BIN")?1:-1);
+  if(slot<0)return DumpOpen(root,out,name,mode,attrs);
+  if(!(mode&(EFI_FILE_MODE_WRITE|EFI_FILE_MODE_CREATE))){*out=NULL;return EFI_NOT_FOUND;}
+  PromCreates[slot]++;RootOpens++;*out=&PromFiles[slot];return EFI_SUCCESS;
+}
+static void DualSetup(int mode) {
+  GenericSetup(G_OK);DualMode=mode;
+  CardCount=mode==D_SINGLE || mode==D_BAD_CHIP || mode==D_SHORT_CHIP || mode==D_CAPTURE_BAD_ATTR?1:(mode==D_THIRD?3:2);
+  PciEnums=0;
+  memset(CardRegs,0,sizeof(CardRegs));memset(CardProm,0,sizeof(CardProm));memset(PromCreates,0,sizeof(PromCreates));memset(DumpWords,0,sizeof(DumpWords));
+  for(UINTN i=0;i<3;i++){
+    Cards[i]=Pci;Cards[i].Pci.Read=DualRead;Cards[i].GetLocation=DualLocation;Cards[i].Mem.Read=DualMem;Cards[i].GetBarAttributes=DualBar;Cards[i].Attributes=DualAttr;
+    memset(Configs[i],0,sizeof(Configs[i]));Configs[i][0]=i==1?0x248410deU:0x220410deU;
+    Configs[i][1]=2;Configs[i][2]=0x030000a1;Configs[i][4]=0xf6000000U+(UINT32)i*0x1000000U;Configs[i][11]=0x100010deU+(UINT32)i;
+    Segments[i]=i==0?1:0;Buses[i]=i==0?5:43+i;
+  }
+  if(mode==D_UNKNOWN)Configs[0][0]=0x220810deU; /* RTX 3080 Ti remains outside scope */
+  if(mode==D_ADDED_MODELS)Configs[0][0]=0x220a10deU;
+  if(mode==D_ADDED_MODELS || mode==D_FOREIGN_3070TI) {
+    Configs[1][0]=0x248210deU;
+    Configs[1][11]=mode==D_ADDED_MODELS?0x50521462U:0x50531462U;
+  }
+  if(mode>=D_MAXSUN_2216 && mode<=D_FOREIGN_2216) {
+    Configs[0][0]=mode==D_CAPTURE_2206?0x220610deU:0x221610deU;
+    switch(mode) {
+      case D_MAXSUN_2216:Configs[0][11]=0x20007377U;break;
+      case D_CAPTURE_2206:Configs[0][11]=0x40611458U;break;
+      case D_CAPTURE_2216_GIGABYTE:Configs[0][11]=0x403f1458U;break;
+      case D_CAPTURE_2216_MSI:Configs[0][11]=0x389b1462U;break;
+      default:Configs[0][11]=0x389c1462U;break;
+    }
+  }
+  if(mode>=D_CAPTURE_BAD_RESOURCE && mode<=D_SHORT_CHIP)Configs[0][0]=0x220610deU;
+  if(mode==D_CHIP_DRIFT)Configs[1][0]=0x220610deU;
+  if(mode==D_DUP_BDF){Segments[1]=Segments[0];Buses[1]=Buses[0];}
+  if(mode==D_BME)Configs[0][1]=6;
+  Bs.LocateHandleBuffer=DualLocate;Bs.HandleProtocol=DualHandle;Bs.ProtocolsPerHandle=DualProtocols;
+  RootFile.Open=DualOpen;
+  for(UINTN i=0;i<2;i++){PromFiles[i]=DumpFile;PromFiles[i].Write=DualDumpWrite;}
+}
+static EFI_STATUS DualRun(int mode) {
+  DualSetup(mode);
+  EFI_STATUS s=GuCaptureGraphOnVolume(&Table,&LogFile,&RootFile);
+  Check(!AttributeOthers && !RootCloses && !SfsSearches && !ForeignOpens,"dual capture has no writes, foreign volume search or borrowed-root close");
+  return s;
+}
+static void EmitSynthetic(const char *root) {
+  char path[4096];
+  for(unsigned boot=0;boot<2;boot++){
+    Check(DualRun(D_ADDED_MODELS)==EFI_SUCCESS,"new reviewed tuples emit actual C probe output");
+    Check(snprintf(path,sizeof(path),"%s/DIAG%02u.TXT",root,boot)>0,"synthetic log path");
+    FILE *f=fopen(path,"wb");Check(f!=NULL,"synthetic scratch log create");
+    Check(fprintf(f,"SYNTHETIC C-PROBE ROUNDTRIP; boot=%u; no hardware observations\n",boot)>0,"synthetic provenance");
+    Check(fwrite(S.Output,1,S.OutputBytes,f)==S.OutputBytes,"complete actual C-emitted probe records");
+    Check(fprintf(f,"diagnostic-result status=0x0000000000000000\n")>0 && !fclose(f),"synthetic actual-success status");
+  }
+  for(unsigned card=0;card<2;card++){
+    Check(snprintf(path,sizeof(path),"%s/PROM%02u.BIN",root,card)>0,"synthetic PROM path");
+    FILE *f=fopen(path,"wb");Check(f!=NULL,"synthetic PROM create");
+    Check(fwrite(DumpBytes[card],1,sizeof(DumpBytes[card]),f)==sizeof(DumpBytes[card]) && !fclose(f),"actual C-dumped mock PROM bytes");
+  }
+}
+int main(int argc,char **argv) {
+  Check(argc==1 || (argc==3 && !strcmp(argv[1],"--emit")),"optional synthetic roundtrip scratch directory only");
+  Check(DualRun(D_OK)==EFI_SUCCESS,"two reviewed cards capture successfully");
+  Check(CardRegs[0]==16 && CardRegs[1]==16 && CardProm[0]==PROM_DWORDS && CardProm[1]==PROM_DWORDS,"both cards retain bounded reads");
+  Check(Logged("dual-probe-v1 max-targets=2 readonly=1") && Logged("capture-complete=1"),"dual capture has a distinct complete format");
+  Check(PromCreates[0]==1 && PromCreates[1]==1 && DumpWords[0]==0x10300000U && DumpWords[1]==0x00300000U,"separate PROM names follow sorted full BDF, not enumeration order");
+  const char *a=strstr(S.Output,"dual-card-begin index=0000"),*b=strstr(S.Output,"dual-card-end index=0000"),*d=strstr(S.Output,"dual-card-begin index=0001");
+  const char *target=a?strstr(a,"probe-target seg=0x0000 bus=0x002c"):NULL;
+  Check(a && b && d && target && a<b && b<d && target<b,"sorted card records are bounded by begin/end markers");
+  Check(Logged("prom dump=PROM00.BIN") && Logged("prom dump=PROM01.BIN"),"logged names match actual dump names");
+  const char *last=strstr(S.Output,"dual-card-end index=0001"),*graph=strstr(S.Output,"handle id=0x");
+  Check(last && graph && last<graph,"whole handle graph is shared outside the card sections");
+  printf("SYNTHETIC FORMAT: dual-probe-v1 max-targets=2 readonly=1\nSYNTHETIC FORMAT: dual-card-begin index=0000 -> seg=0000 bus=002c -> PROM00.BIN -> dual-card-end index=0000\nSYNTHETIC FORMAT: dual-card-begin index=0001 -> seg=0001 bus=0005 -> PROM01.BIN -> dual-card-end index=0001\n");
+  Check(DualRun(D_SINGLE)==EFI_SUCCESS && PromCreates[0]==1 && !PromCreates[1],"explicit max2 probe may observe one card without inventing another");
+  Check(DualRun(D_ENUM_REVERSED)==EFI_SUCCESS && DumpWords[0]==0x10300000U && DumpWords[1]==0x00300000U,"changing enumeration order does not reassign PROM identities");
+  Check(DualRun(D_ADDED_MODELS)==EFI_SUCCESS && CardRegs[0]==16 && CardRegs[1]==16 &&
+    CardProm[0]==PROM_DWORDS && CardProm[1]==PROM_DWORDS,"both additional reviewed identities keep bounded dual reads");
+  Check(DualRun(D_MAXSUN_2216)==EFI_SUCCESS && CardRegs[0]==16 && CardProm[0]==PROM_DWORDS &&
+        !Logged("probe-capture-only"),"exact Maxsun tuple is captured without the research-only marker");
+  for(int mode=D_CAPTURE_2206;mode<=D_CAPTURE_2216_MSI;mode++){
+    Check(DualRun(mode)==EFI_SUCCESS && CardRegs[0]==16 && CardProm[0]==PROM_DWORDS &&
+          Logged("probe-capture-only=1"),"research-only RTX 3080 emits bounded evidence and an exclusion marker");
+  }
