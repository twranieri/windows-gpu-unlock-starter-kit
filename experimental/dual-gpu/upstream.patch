+ @(('#define GU_PAIR_HOST_PROFILE_HEADER "'+$bad.Replace('\','/')+'"'),('#define GU_PAIR_CAPTURE_FIXTURE "'+$fixture.Replace('\','/')+'"'))|Set-Content -LiteralPath $bridge -Encoding ascii
+ $negative=Join-Path $scratch 'synthetic-wrong-profile.exe'
