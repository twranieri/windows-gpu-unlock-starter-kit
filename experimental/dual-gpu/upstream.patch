+"""Synthetic generator/serialization controls. Never physical/write evidence.
+
+The test-only driver digest and FWSEC locator below are deliberately invented.
+They never modify proven.json or create a production evidence manifest.
+"""
+import argparse
+import copy
+import hashlib
+import importlib.util
+import contextlib
+import io
+import json
+from pathlib import Path
+import re
+import struct
+import tempfile
+import unittest
+from unittest.mock import patch
+
+HERE=Path(__file__).resolve().parent
+REPO=HERE.parents[1]
+
+
+def load(name,path):
+    spec=importlib.util.spec_from_file_location(name,path)
+    value=importlib.util.module_from_spec(spec);spec.loader.exec_module(value)
+    return value
+
+
+M=load('test_pair_generator',HERE/'make-pair-profile.py')
+F=load('test_pair_fixture',HERE/'make-console-fixture.py')
+T=load('test_pair_console_base',REPO/'research/profile/test_local_topology.py')
+D=load('test_pair_deep_base',HERE/'test_analyze_pair.py')
+
+
+def image(size=0x2be40):
+    """Invented loaded PE with nonrelocating executable bytes and real bounds."""
+    data=bytearray(size);data[:2]=b'MZ'
+    struct.pack_into('<I',data,0x3c,0x80);data[0x80:0x84]=b'PE\0\0'
+    struct.pack_into('<HH',data,0x84,0x8664,1)
+    struct.pack_into('<H',data,0x94,0xf0)
+    opt=0x98;struct.pack_into('<H',data,opt,0x20b)
+    struct.pack_into('<II',data,opt+56,len(data),0x280)
+    struct.pack_into('<I',data,opt+108,16)
+    table=opt+0xf0
+    struct.pack_into('<8sII',data,table,b'.text',0x1000,0x280)
+    struct.pack_into('<I',data,table+36,0x60000020)
+    data[0x280:0x1280]=bytes((i*7+3)%256 for i in range(0x1000))
+    return bytes(data)
+
+
+def envelope():
+    result=copy.deepcopy(D.ENVELOPE)
+    digest=hashlib.sha256(image()[0x280:0x1280]).hexdigest()
+    for entry in result['nvgop']:
+        if entry['version'] in ('60009','60010','6000a'):entry['text_sha256']=digest
+    for chip in result['chips']:
+        for entry in chip['nvgop']:
+            if entry['version'] in ('60009','60010','6000a'):entry['text_sha256']=digest
+        for rows in chip.get('pci_nvgop',{}).values():
+            for entry in rows:
+                if entry['version'] in ('60009','60010','6000a'):entry['text_sha256']=digest
+    return result
+
+
+def synthetic(count=2,*,boot=0,peer_bound=False,peer_foreign=False,peer_children=False,peer_child_foreign=False,primary_bus=1,added_models=False,maxsun_2216=False):
+    cards=D.cards()[:count]
+    cards[0].update(bus=primary_bus,subsystem=0x38811462,prom=bytes(0x100000))
+    cards[0]['subsystem']=T.configuration(command=2)[11]
+    if added_models:
+        cards[0].update(board=0x220a10de,memory=0x3000)
+        if count==2:
+            cards[1].update(board=0x248210de,subsystem=0x50521462)
+    if maxsun_2216:
+        cards[0].update(board=0x221610de,memory=0x2800,subsystem=0x20007377)
+    base=T.synthetic_capture(bus=primary_bus,children=1,command=2,
+                             board=cards[0]['board'],memory=cards[0]['memory'],subsystem=cards[0]['subsystem'])
+    start=base.index('probe-target ');binding=base.index('binding handle=')
+    prefix=base[:start]
+    graph=base[binding:]
+    # The dump index belongs to the NVIDIA binding, not its preceding role.
+    marker='img-path-node raw='+M.END.hex()+'\nhandles status='
+    graph=graph.replace(marker,'img-path-node raw='+M.END.hex()+'\nimg dump index=00\nhandles status=',1)
+    # The complete graph includes a protected unrelated PCI bridge and owner.
+    bridge=graph.index('handle id=0x8\n');config=graph.index('pci config-status=',bridge)
+    graph=graph[:config]+'pci location-status=0x0 segment=0x0 bus=0x0 device=0x1 function=0x0\n'+graph[config:]
+    if count==2:
+        peer=cards[1];cfg=D.config(peer)
+        controller=bytearray(T.PCI_PATH+T.END);controller[16]=2
+        nodes=[];at=0
+        while at<len(controller):
+            size=int.from_bytes(controller[at+2:at+4],'little');nodes.append(bytes(controller[at:at+size]));at+=size
+        owner='open agent=0x3 controller=0x30 attributes=0x10 count=0x1\n' if peer_bound else ''
+        peer_graph=('handle id=0x30\nprotocol guid='+M.LEGACY.PCI_IO+'\nopens status=0x0000000000000000 count=0x'+str(int(peer_bound))+'\n'+owner+
+            'pci location-status=0x0 segment=0x0 bus=0x2 device=0x0 function=0x0\npci config-status=0x0000000000000000\npci config-dwords='+
+            ' '.join(f'{word:08x}' for word in cfg[:16])+'\nprotocol guid='+M.LEGACY.PATH+'\nopens status=0x0000000000000000 count=0x0\n'+
+            ''.join('path-node raw='+node.hex()+'\n' for node in nodes))
+        if peer_children:
+            if not peer_bound:raise ValueError('Synthetic physical peer requires its captured NVIDIA owner')
+            peer_graph=peer_graph.replace('protocol guid='+M.LEGACY.PATH+'\nopens status=0x0000000000000000 count=0x0\n',
+                'protocol guid='+M.LEGACY.PATH+'\nopens status=0x0000000000000000 count=0x1\nopen agent=0x3 controller=0x31 attributes=0x8 count=0x1\n',1)
+            child_nodes=nodes[:-1]+[bytes.fromhex('0203080070030180'),M.END]
+            peer_graph+=('handle id=0x31\nprotocol guid='+M.LEGACY.PATH+'\nopens status=0x0000000000000000 count=0x0\n'+
+                ''.join('path-node raw='+node.hex()+'\n' for node in child_nodes)+
+                'protocol guid='+M.LEGACY.GOP+'\nopens status=0x0000000000000000 count=0x'+str(int(peer_child_foreign))+'\n'+
+                ('open agent=0x5 controller=0x31 attributes=0x10 count=0x1\n' if peer_child_foreign else '')+
+                'gop framebuffer=0x000000fcc1000000 bytes=0x00000000007e9000 mode=0x0 max-mode=0x9\n'+
+                'gop width=0x780 height=0x438 stride=0x780\ngop pixel-format=0x0 info-bytes=0x24\n'+
+                'protocol guid='+M.LEGACY.EDID_DISCOVERED+'\nopens status=0x0000000000000000 count=0x0\n')
+        if peer_foreign:
+            # A driver with a protected existing role must never be exempted
+            # merely because its new controller is the second NVIDIA card.
+            peer_graph=peer_graph.replace('count=0x0\npci location','count=0x1\nopen agent=0x4 controller=0x30 attributes=0x10 count=0x1\npci location',1)
+        graph=graph.replace('capture-complete=1\n',peer_graph+'capture-complete=1\n')
+        graph=re.sub(r'(handles status=0x0000000000000000 count=0x)([0-9a-f]+)',lambda m:m[1]+f'{int(m[2],16)+1+int(peer_children):x}',graph,count=1)
+    cards.sort(key=lambda card:card['bus'])
+    deep=D.render(cards,boot=boot)
+    deep=deep[deep.index('dual-card-begin'):deep.index('handles status=')]
+    return 'SYNTHETIC TEST ONLY; boot='+str(boot)+'\n'+prefix+'dual-probe-v1 max-targets=2 readonly=1\n'+deep+graph,cards
