+        Defines=@('-DGU_DIAGNOSTIC_ONLY','-DGU_DIAGNOSTIC_PROBE','-DGU_PROBE_GENERIC','-DGU_USB_PROBE','-DGU_PROBE_PARENT_BASELINE','-DGU_PROBE_AUTO_BUS','-DGU_PROBE_DUAL','-DGU_PROBE_MAX_TARGETS=2');
+        EfiSha256=(Get-GuSha256 $efi);Sources=@([pscustomobject]@{Path='fixture.c';Sha256=(Get-GuSha256 (Join-Path $root 'fixture.c'))},[pscustomobject]@{Path='research/dual/build-probe.ps1';Sha256=(Get-GuSha256 $probeScript)})}
