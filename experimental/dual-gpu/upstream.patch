+static void SetFinal(UINTN row) {ColdValues[row][6]=0x88888888U;ColdValues[row][7]=8;}
+static void RestoreDecodeRow(UINTN row){for(UINTN i=0;i<N(Pcis);i++)if(FixturePcis[i].Handle==H(PciHandles[row])){Configs[i][1]=FixturePairConfigs[row][1];Attrs[i]=(Configs[i][1]&1?0x100:0)|(Configs[i][1]&2?0x200:0);}}
+static EFI_STATUS PrepareFlow(VOID *x){(void)x;return GuPrepareConsole(&Table,Log,NULL);}
+static EFI_STATUS ChooseFlow(VOID *x,BOOLEAN *skip){(void)x;*skip=FALSE;return EFI_SUCCESS;}
+static EFI_STATUS SuccessFlow(VOID *x){(void)x;return EFI_SUCCESS;}
+static EFI_STATUS ReleaseFlow(VOID *x){(void)x;return GuReleaseGop(&Table,H(FX_HANDLES+1),Log,NULL);}
+static EFI_STATUS ColdFlow(VOID *x){(void)x;return GuVerifyReleased(&Table,TRUE);}
+static EFI_STATUS UnlockFlow(VOID *x){(void)x;for(UINTN pass=0;pass<GU_PAIR_COUNT;pass++){UINTN i=GU_PAIR_COUNT==2 && FX_PAIR_CONSOLE_INDEX==0?1-pass:pass;if(!GuPairTargets[i].Console && NvAgents[i]){EFI_STATUS s=Disconnect(H(PciHandles[i]),H(NvAgents[i]),NULL);if(s!=EFI_SUCCESS)return s;RestoreDecodeRow(i);}SetFinal(i);if(Fault==6 && pass==0)return EFI_DEVICE_ERROR;}return EFI_SUCCESS;}
+static EFI_STATUS WindowsFlow(VOID *x){(void)x;EFI_STATUS s=GuVerifyReleased(&Table,FALSE);if(s==EFI_SUCCESS)Windows++;return s;}
+int main(int argc,char **argv) {
+ Check(argc==3,"repository root and wrapper|child required");Check(FX_PAIR_TARGET_COUNT==GU_PAIR_COUNT,"captured full target cardinality");Check(sizeof(FixtureEdges)<=sizeof(Live.Edges),"complete captured graph fits");
+ for(UINTN i=0;i<N(Bindings);i++){const FX_DRIVER *d=&FixtureDrivers[i];Check(d->Size && d->Size<=0x1000000,"bounded captured driver image");ImageMemory[i]=calloc(1,d->Size);ImageOriginal[i]=calloc(1,d->Size);Check(ImageMemory[i]&&ImageOriginal[i],"image allocation");if(d->ImageFile[0])Load(argv[1],d->ImageFile,ImageOriginal[i],d->Size);}
+ for(UINTN i=0;i<GU_PAIR_COUNT;i++){char file[160];snprintf(file,sizeof(file),"research/dual/local/fixtures/cards/%04u/PROM.BIN",(unsigned)i);Load(argv[1],file,PromBytes[i],sizeof(PromBytes[i]));Check(GuHashMatches(PromBytes[i],sizeof(PromBytes[i]),GuPairTargets[i].PromSha),"each real PROM matches immutable table");}
+ if(!strcmp(argv[2],"wrong-profile")) {
+  Fault=0;Setup();EFI_STATUS s=GuPrepareConsole(&Table,Log,NULL);
+  printf("%s wrong captured console profile; stops=%u decode_changes=%u\n",s==EFI_SUCCESS?"ACCEPTED":"REFUSED",Stops,Writes);
+  if(s!=EFI_SUCCESS)Check(!Stops && !Writes,"wrong profile refuses before any detach or decode");
