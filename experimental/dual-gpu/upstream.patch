+        path = meta['paths'][0] if meta['paths'] else meta['controller']
+        values.update(GU_BOARD_ID=f'0x{card["pci_id"]}U', GU_BOARD_SUBSYSTEM=f'0x{card["subsystem"]}U',
+                      GU_TARGET_SEGMENT=f'0x{segment:x}U', GU_TARGET_BUS=f'0x{bus:x}U',
+                      GU_BAR0_BASE=f'0x{card["bar0"]:x}ULL', GU_BAR0_END=f'0x{card["bar0"]+0xffffff:x}ULL',
+                      GU_CHIP_ID=f'0x{card["chip"]}U', GU_DEVICE_MEMORY_SIZE=f'0x{card["memory_mib"]:x}U',
+                      GU_PROM_SHA256=json.dumps(card['prom_sha256']), GU_RTX_PATH_BYTES=','.join(str(v) for v in path),
+                      GU_ROOT_PORT_DEVICE=str(meta['root'][0])+'U', GU_ROOT_PORT_FUNCTION=str(meta['root'][1])+'U')
+        if primary != console_index:
+            values['GU_NO_EDID_DRIVER']='1'
+            for key in ('GU_EDID_IMAGE_SIZE','GU_EDID_STOP','GU_EDID_TEXT_BYTES','GU_EDID_TEXT_SHA256'):
+                values.pop(key,None)
+            if meta['paths']:
+                values.update(GU_LOCAL_CONSOLE_AGGREGATE='0',GU_LOCAL_CHILD_COUNT=str(len(meta['paths'])))
+            else:
+                values.pop('GU_LOCAL_CONSOLE_AGGREGATE',None);values.pop('GU_LOCAL_CHILD_COUNT',None)
+        nv, code = meta['nv'], meta['code']
+        values.update(GU_NVGOP_VERSION=f'0x{nv["version"]:x}U' if nv else '0U', GU_NVGOP_IMAGE_SIZE=f'0x{nv["size"]:x}U' if nv else '0U',
+                      GU_NVGOP_STOP=f'0x{nv["stop"]-nv["base"]:x}U' if nv else '0U',
+                      GU_NVGOP_TEXT_BYTES=f'0x{code["bytes"]:x}U' if code else '0U', GU_NVGOP_TEXT_SHA256=json.dumps(code['sha256'] if code else ''))
+    lines = ['/* GENERATED locally from complete one/two-card captures; never publish. */',
+             '#define GU_LOCAL_PROFILE_GENERATOR 1', '#define GU_LOCAL_PAIR_GENERATOR 2',
+             f'#define GU_PAIR_TARGET_COUNT {len(selected)}U', f'#define GU_PROFILE_NAME {json.dumps(name)}']
+    if host_index is not None and not meta['paths']:
