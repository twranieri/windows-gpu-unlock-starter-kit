+++ b/internal-boot/boot/pair-policy.h
@@ -0,0 +1,287 @@
+/* SPDX-License-Identifier: GPL-2.0-only. Immutable captured one/two-card policy.
+ * Read-only helpers shared by the wrapper and child; never authorize by model name. */
+#pragma once
+#include <Uefi.h>
+#include <Protocol/PciIo.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/DriverBinding.h>
+#include <Protocol/LoadedImage.h>
+#include <IndustryStandard/Acpi.h>
+#include "../unlock/machine-profile.h"
+#include "../unlock/sha256.h"
+
+#ifdef GU_PROFILE_LOCAL_DUAL
+typedef struct {
+  UINT32 Id,Subsystem,Chip,Memory;
+  const char *PromSha;
+  UINTN Segment,Bus,Device,Function;
+  UINT64 Bar0;
+  UINT32 Config[64];
+  UINTN ControllerBytes;
+  UINT8 ControllerPath[128];
+  UINTN ChildCount,ChildBytes[4];
+  UINT8 ChildPaths[4][128];
+  UINT32 NvgopVersion;
+  UINTN NvgopImageSize,NvgopStop,NvgopTextBytes;
+  const char *NvgopTextSha;
+  BOOLEAN Console;
+} GU_PAIR_TARGET;
+static const GU_PAIR_TARGET GuPairTargets[]={GU_PAIR_TARGET_TABLE};
+_Static_assert(sizeof(GuPairTargets)/sizeof(*GuPairTargets)>=1 && sizeof(GuPairTargets)/sizeof(*GuPairTargets)<=2,"one or two captured targets required");
+#define GU_PAIR_COUNT (sizeof(GuPairTargets)/sizeof(*GuPairTargets))
+static BOOLEAN GuPairCheckBusy,GuPairCheckReentered,GuPairInventoryBusy,GuPairInventoryReentered,GuPairDriverBusy,GuPairDriverReentered;
+typedef struct {
+  EFI_BOOT_SERVICES *Bs;
+  EFI_LOCATE_HANDLE_BUFFER Locate;
+  EFI_HANDLE_PROTOCOL Handle;
+  EFI_FREE_POOL Free;
+  EFI_ALLOCATE_POOL Allocate;
+  EFI_OPEN_PROTOCOL_INFORMATION Opens;
+} GU_PAIR_BOOT_PIN;
+typedef struct {
+  EFI_PCI_IO_PROTOCOL *Io;
+  EFI_PCI_IO_PROTOCOL_CONFIG Config;
+  EFI_PCI_IO_PROTOCOL_GET_LOCATION Location;
+  EFI_PCI_IO_PROTOCOL_ATTRIBUTES Attributes;
+  EFI_PCI_IO_PROTOCOL_GET_BAR_ATTRIBUTES Bar;
+  EFI_PCI_IO_PROTOCOL_IO_MEM Mem;
+} GU_PAIR_IO_PIN;
+static inline GU_PAIR_BOOT_PIN GuPairBootPin(EFI_BOOT_SERVICES *bs) {
+  return (GU_PAIR_BOOT_PIN){bs,bs->LocateHandleBuffer,bs->HandleProtocol,bs->FreePool,bs->AllocatePool,bs->OpenProtocolInformation};
+}
+static inline BOOLEAN GuPairBootStable(const GU_PAIR_BOOT_PIN *p) {
+  return !(GuPairCheckBusy && GuPairCheckReentered) && !(GuPairInventoryBusy && GuPairInventoryReentered) &&
+    !(GuPairDriverBusy && GuPairDriverReentered) &&
+    p->Bs && p->Bs->LocateHandleBuffer==p->Locate && p->Bs->HandleProtocol==p->Handle && p->Bs->FreePool==p->Free &&
+    p->Bs->AllocatePool==p->Allocate && p->Bs->OpenProtocolInformation==p->Opens;
+}
+static inline GU_PAIR_IO_PIN GuPairIoPin(EFI_PCI_IO_PROTOCOL *io) {
+  return (GU_PAIR_IO_PIN){io,io->Pci.Read,io->GetLocation,io->Attributes,io->GetBarAttributes,io->Mem.Read};
+}
+static inline BOOLEAN GuPairIoStable(const GU_PAIR_IO_PIN *p) {
+  return p->Io && p->Io->Pci.Read==p->Config && p->Io->GetLocation==p->Location &&
+    p->Io->Attributes==p->Attributes && p->Io->GetBarAttributes==p->Bar && p->Io->Mem.Read==p->Mem;
+}
+static inline BOOLEAN GuPairPinsStable(const GU_PAIR_BOOT_PIN *boot,const GU_PAIR_IO_PIN *pins) {
+  if(!GuPairBootStable(boot))return FALSE;
+  for(UINTN i=0;i<GU_PAIR_COUNT;i++)if(!GuPairIoStable(&pins[i]))return FALSE;
+  return TRUE;
+}
+static inline BOOLEAN GuPairBytes(const VOID *a,const VOID *b,UINTN n) {
+  const UINT8 *x=a,*y=b;for(UINTN i=0;i<n;i++)if(x[i]!=y[i])return FALSE;return TRUE;
+}
+static inline BOOLEAN GuPairPath(const VOID *path,const UINT8 *expected,UINTN bytes) {
+  if(!path || bytes<4 || bytes>128)return FALSE;
+  const UINT8 *p=path;UINTN at=0;
+  while(at+4<=bytes) {
+    UINTN n=p[at+2]+((UINTN)p[at+3]<<8);
+    if(n<4 || n>bytes-at)return FALSE;
+    if(p[at]==0x7f)return at+n==bytes && n==4 && p[at+1]==0xff && GuPairBytes(p,expected,bytes);
+    at+=n;
+  }
+  return FALSE;
+}
+static inline INTN GuPairIdentity(const UINT32 *cfg,UINTN s,UINTN b,UINTN d,UINTN f) {
+  for(UINTN i=0;i<GU_PAIR_COUNT;i++) {
+    const GU_PAIR_TARGET *p=&GuPairTargets[i];
+    if(s==p->Segment && b==p->Bus && d==p->Device && f==p->Function && cfg[0]==p->Id && cfg[11]==p->Subsystem &&
+       cfg[2]==0x030000a1U && cfg[4]==p->Bar0)return (INTN)i;
+  }
+  return -1;
+}
+static inline EFI_STATUS GuPairInventoryInner(EFI_BOOT_SERVICES *bs,EFI_HANDLE *out,EFI_PCI_IO_PROTOCOL **ios) {
+  EFI_GUID guid=EFI_PCI_IO_PROTOCOL_GUID,dp=EFI_DEVICE_PATH_PROTOCOL_GUID;
+  EFI_HANDLE *handles=NULL;UINTN count=0,found=0;BOOLEAN seen[2]={FALSE,FALSE};
+  if(!bs || !bs->LocateHandleBuffer || !bs->HandleProtocol || !bs->FreePool)return EFI_UNSUPPORTED;
+  GU_PAIR_BOOT_PIN boot=GuPairBootPin(bs);GU_PAIR_IO_PIN pins[2]={{0},{0}};
+  EFI_STATUS status=boot.Locate(ByProtocol,&guid,NULL,&count,&handles);
+  if(status!=EFI_SUCCESS || !handles || !count || count>1024 || !GuPairBootStable(&boot)) {
+    if(handles)boot.Free(handles);return EFI_NOT_READY;
+  }
+  for(UINTN i=0;i<count && status==EFI_SUCCESS;i++) {
+    EFI_PCI_IO_PROTOCOL *io=NULL;UINT32 id=0,cls=0,cfg[64];
+    if(!GuPairBootStable(&boot)){status=EFI_NOT_READY;break;}
+    status=boot.Handle(handles[i],&guid,(VOID **)&io);
+    if(status!=EFI_SUCCESS || !io || !io->Pci.Read || !io->GetLocation){status=EFI_NOT_READY;break;}
+    GU_PAIR_IO_PIN pin=GuPairIoPin(io);
+    if(!GuPairBootStable(&boot)){status=EFI_NOT_READY;break;}
+    status=pin.Config(io,EfiPciIoWidthUint32,0,1,&id);if(status!=EFI_SUCCESS)break;
+    if(!GuPairBootStable(&boot) || !GuPairIoStable(&pin)){status=EFI_NOT_READY;break;}
+    if((id&0xffffU)!=0x10deU)continue;
+    status=pin.Config(io,EfiPciIoWidthUint32,8,1,&cls);if(status!=EFI_SUCCESS)break;
+    if(!GuPairBootStable(&boot) || !GuPairIoStable(&pin)){status=EFI_NOT_READY;break;}
+    if(cls>>24!=3)continue;
+    for(UINTN j=0;j<64;j++)cfg[j]=0xffffffffU;
+    status=pin.Config(io,EfiPciIoWidthUint32,0,64,cfg);if(status!=EFI_SUCCESS)break;
+    if(!GuPairBootStable(&boot) || !GuPairIoStable(&pin)){status=EFI_NOT_READY;break;}
+    UINTN s=~(UINTN)0,b=s,d=s,f=s;status=pin.Location(io,&s,&b,&d,&f);if(status!=EFI_SUCCESS)break;
+    if(!GuPairBootStable(&boot) || !GuPairIoStable(&pin)){status=EFI_NOT_READY;break;}
+    INTN row=GuPairIdentity(cfg,s,b,d,f);
+    if(row<0 || seen[row] || found>=GU_PAIR_COUNT){status=EFI_UNSUPPORTED;break;}
+    VOID *path=NULL;status=boot.Handle(handles[i],&dp,&path);
+    if(status!=EFI_SUCCESS || !GuPairPath(path,GuPairTargets[row].ControllerPath,GuPairTargets[row].ControllerBytes)){status=EFI_UNSUPPORTED;break;}
+    if(!GuPairBootStable(&boot) || !GuPairIoStable(&pin)){status=EFI_NOT_READY;break;}
+    seen[row]=TRUE;found++;out[row]=handles[i];ios[row]=io;pins[row]=pin;
+  }
+  if(status==EFI_SUCCESS && found!=GU_PAIR_COUNT)status=EFI_NOT_FOUND;
+  if(status==EFI_SUCCESS && GU_PAIR_COUNT==2 && (out[0]==out[1] || ios[0]==ios[1]))status=EFI_UNSUPPORTED;
+  if(status==EFI_SUCCESS && !GuPairPinsStable(&boot,pins))status=EFI_NOT_READY;
+  EFI_STATUS freed=boot.Free(handles);if(status==EFI_SUCCESS && freed!=EFI_SUCCESS)status=EFI_DEVICE_ERROR;
+  if(status==EFI_SUCCESS && !GuPairPinsStable(&boot,pins))status=EFI_NOT_READY;
+  return status;
+}
+static inline EFI_STATUS GuPairInventory(EFI_BOOT_SERVICES *bs,EFI_HANDLE *out,EFI_PCI_IO_PROTOCOL **ios) {
+  if(!out || !ios)return EFI_INVALID_PARAMETER;
+  for(UINTN i=0;i<GU_PAIR_COUNT;i++){out[i]=NULL;ios[i]=NULL;}
+  if(GuPairInventoryBusy){GuPairInventoryReentered=TRUE;return EFI_NOT_READY;}
+  GuPairInventoryBusy=TRUE;GuPairInventoryReentered=FALSE;
+  EFI_HANDLE handles[2]={NULL,NULL};EFI_PCI_IO_PROTOCOL *interfaces[2]={NULL,NULL};
+  EFI_STATUS s=GuPairInventoryInner(bs,handles,interfaces);
+  if(s==EFI_SUCCESS && GuPairInventoryReentered)s=EFI_NOT_READY;
+  GuPairInventoryBusy=FALSE;
+  if(s==EFI_SUCCESS)for(UINTN i=0;i<GU_PAIR_COUNT;i++){out[i]=handles[i];ios[i]=interfaces[i];}
+  return s;
+}
+static inline EFI_STATUS GuPairDriverInner(EFI_BOOT_SERVICES *bs,UINTN row,EFI_HANDLE agent) {
+  if(row>=GU_PAIR_COUNT || !agent || !bs || !bs->HandleProtocol)return EFI_UNSUPPORTED;
+  GU_PAIR_BOOT_PIN boot=GuPairBootPin(bs);
+  const GU_PAIR_TARGET *p=&GuPairTargets[row];EFI_GUID binding=EFI_DRIVER_BINDING_PROTOCOL_GUID,image=EFI_LOADED_IMAGE_PROTOCOL_GUID;
+  EFI_DRIVER_BINDING_PROTOCOL *d=NULL;EFI_LOADED_IMAGE_PROTOCOL *im=NULL;
+  EFI_STATUS s=boot.Handle(agent,&binding,(VOID **)&d);
+  if(!GuPairBootStable(&boot))return EFI_NOT_READY;
+  if(s!=EFI_SUCCESS || !d || d->DriverBindingHandle!=agent || !d->Stop || !d->ImageHandle || d->Version!=p->NvgopVersion)return EFI_UNSUPPORTED;
+  EFI_HANDLE driverImage=d->ImageHandle;EFI_DRIVER_BINDING_STOP stop=d->Stop;UINT32 version=d->Version;
+  s=boot.Handle(driverImage,&image,(VOID **)&im);
+  if(!GuPairBootStable(&boot) || d->DriverBindingHandle!=agent || d->ImageHandle!=driverImage || d->Stop!=stop || d->Version!=version)return EFI_NOT_READY;
+  if(s!=EFI_SUCCESS || !im || !im->ImageBase || im->ImageCodeType!=EfiBootServicesCode || im->ImageSize!=p->NvgopImageSize ||
